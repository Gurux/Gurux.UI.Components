@*
<summary>
Edits a typed date and time value with formatting and optional persistence. String values preserve custom date/time patterns, including wildcards, for validation by the consumer.
</summary>
*@

@using System.Diagnostics.CodeAnalysis
@using System.Globalization
@using Microsoft.Extensions.Logging

@typeparam TItem
@inherits GXAdaptiveComponentBase
@implements IDisposable
@using Gurux.UI.Components.Appearance

@inject IGXLocalStorage localStorage
@inject ILogger<GXDateTimeSelector<TItem>> Logger

<CascadingValue Value="this">
    <input id="@Id"
           type="@InputType" step="@(IsAdaptive ? "1" : null)" aria-invalid="@(_invalid ? "true" : null)"
           value="@ValueToString()"
           placeholder="@Placeholder"
           @attributes="GXComponentAttributes.WithoutCss(AdditionalAttributes)" style="@GXComponentAttributes.GetStyle(AdditionalAttributes)" class="@GXComponentAttributes.GetClass(AdditionalAttributes, InputClass)"
           onreset="@(() => Reset())"
           onchange="@((ChangeEventArgs e) => UpdateDateTime(e.Value))"
           required="@Required"
           disabled="@IsDisabled()"
           aria-required="@Required" />
    @if (_invalid)
    {
        <span role="alert" class="text-danger">@(InvalidValueText ?? GXAppearanceText.Get("InvalidDateTime"))</span>
    }
</CascadingValue>

@code
{
    [Parameter] public TimeZoneInfo? TimeZone { get; set; }
    [Parameter] public string? InvalidValueText { get; set; }
    private static readonly Type ValueType = Nullable.GetUnderlyingType(typeof(TItem)) ?? typeof(TItem);
    private string InputType => ValueType == typeof(string) ? "text" : ValueType == typeof(DateOnly) ? "date" : ValueType == typeof(TimeOnly) ? "time" : "datetime-local";
    private string Format => InputType == "date" ? "yyyy-MM-dd" : InputType == "time" ? "HH:mm:ss" : "yyyy-MM-ddTHH:mm:ss";
    private bool _invalid;
    private string InputClass => (IsAdaptive ? AdaptiveClass("form-control gx-adaptive-picker") : "form-control") + (_invalid ? " is-invalid" : "");
    public void Dispose() => DisposeAdaptiveBehavior();

    /// <summary>
    /// Gets or sets captured HTML attributes forwarded to the underlying element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// Gets the supplied HTML id or a Guid identifier generated once for this component instance.
    /// </summary>
    private string Id => GXComponentAttributes.GetId(AdditionalAttributes, ref _generatedId);

    private string? _generatedId;

    /// <summary>
    /// Gets or sets whether the component value is restored from and saved to browser local storage using its id.
    /// </summary>
    /// <seealso cref="Id" />
    [Parameter]
    public bool Save { get; set; } = true;

    /// <summary>
    /// Gets or sets whether user interaction with the input is disabled.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// Returns the disabled HTML attribute when date and time editing is disabled.
    /// </summary>
    private string? IsDisabled()
    {
        return Disabled ? "disabled" : null;
    }

    /// <summary>
    /// Gets or sets whether the input is marked as requiring a value.
    /// </summary>
    [Parameter]
    public bool Required { get; set; }

    /// <summary>
    /// Creates the date and time selector and verifies the supported bound value type.
    /// </summary>
    public GXDateTimeSelector()
    {
        Type type = Nullable.GetUnderlyingType(typeof(TItem)) ?? typeof(TItem);
        if (type != typeof(DateTime) && type != typeof(DateTimeOffset) && type != typeof(DateOnly) && type != typeof(TimeOnly) && type != typeof(string))
        {
            throw new InvalidOperationException($"Unsupported {GetType()} type param '{type}'.");
        }
    }

    /// <summary>
    /// Gets or sets the typed date and time value, or a custom string pattern validated by the consumer.
    /// </summary>
    [Parameter]
    public TItem? Value { get; set; }

    /// <summary>
    /// Clears the selected date and time value and requests rendering.
    /// </summary>
    private Task Reset()
    {
        return UpdateDateTime(null);
    }

    /// <summary>
    /// Gets or sets the callback invoked when the bound value changes.
    /// </summary>
    [Parameter]
    public EventCallback<TItem?> ValueChanged { get; set; }

    /// <summary>
    /// Formats the supported date and time value using the configured format and invariant culture.
    /// </summary>
    private string? ValueToString()
    {
        if (Value is string text)
        {
            return text;
        }

        if (Value is DateTime dt)
        {
            return BindConverter.FormatValue(dt,
                Format,
                CultureInfo.InvariantCulture);
        }

        if (Value is DateTimeOffset dto)
        {
            return BindConverter.FormatValue(TimeZone == null ? dto : TimeZoneInfo.ConvertTime(dto, TimeZone),
                Format,
                CultureInfo.InvariantCulture);
        }

        if (Value is DateOnly d)
        {
            return BindConverter.FormatValue(d,
                Format,
                CultureInfo.InvariantCulture);
        }

        if (Value is TimeOnly tt)
        {
            return BindConverter.FormatValue(tt,
                Format,
                CultureInfo.InvariantCulture);
        }
        return string.Empty;
    }

    /// <summary>
    /// Gets or sets the hint displayed when the input has no value.
    /// </summary>
    [Parameter]
    public string? Placeholder { get; set; }

    /// <summary>
    /// Converts an edited date and time value, notifies changes, and saves it when persistence is enabled.
    /// </summary>
    private async Task UpdateDateTime(object? value, bool init = false)
    {
        TItem? result = default;
        _invalid = false;
        if (value is string text && !string.IsNullOrWhiteSpace(text))
        {
            if (ValueType == typeof(string))
            {
                result = (TItem)(object)text;
            }
            else if (init && ValueType == typeof(DateTimeOffset) && DateTimeOffset.TryParseExact(text, "O", CultureInfo.InvariantCulture, DateTimeStyles.None, out var restored))
            {
                result = (TItem)(object)restored;
            }
            else if (ValueType == typeof(DateTimeOffset) && DateTime.TryParse(text, CultureInfo.InvariantCulture, DateTimeStyles.None, out var local))
            {
                local = DateTime.SpecifyKind(local, DateTimeKind.Unspecified);
                if (TimeZone?.IsInvalidTime(local) == true)
                {
                    _invalid = true;
                    return;
                }
                var offset = TimeZone?.GetUtcOffset(local) ?? (Value is DateTimeOffset previous ? previous.Offset : TimeSpan.Zero);
                result = (TItem)(object)new DateTimeOffset(local, offset);
            }
            else if (!BindConverter.TryConvertTo<TItem>(text, CultureInfo.InvariantCulture, out result))
            {
                _invalid = true;
                return;
            }
        }
        var changed = !EqualityComparer<TItem?>.Default.Equals(Value, result);
        Value = result;
        if (changed && ValueChanged.HasDelegate)
        {
            await ValueChanged.InvokeAsync(Value);
        }
        try
        {
            if (!Disabled && !init && Save && !string.IsNullOrEmpty(Id))
            {
                await localStorage.SetValueAsync(Id, Value is DateTimeOffset current ? current.ToString("O", CultureInfo.InvariantCulture) : ValueToString());
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex.Message);
        }
    }

    /// <summary>
    /// Restores a saved date and time value after the first render when persistence is enabled.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (firstRender)
        {
            try
            {
                if (!Disabled && Save && !string.IsNullOrEmpty(Id))
                {
                    string? str = await localStorage.GetValueAsync(Id);
                    if (str != null && !AdaptiveDisposed)
                    {
                        await UpdateDateTime(str, true);
                        StateHasChanged();
                    }
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex.Message);
            }
        }
    }
}