@*
<summary>
Edits a typed date and time value with formatting and optional persistence.
</summary>
*@

@using System.Diagnostics.CodeAnalysis
@using System.Globalization
@using Microsoft.Extensions.Logging

@typeparam TItem

@inject IGXLocalStorage localStorage
@inject ILogger<GXDateTimeSelector<TItem>> Logger

<CascadingValue Value="this">
    <input id="@Id"
           type="datetime-local"
           value="@ValueToString()"
           placeholder="@Placeholder"
           @attributes="AdditionalAttributes" class="@CssClass"
           onreset="@(() => Reset())"
           onchange="@((ChangeEventArgs e) => UpdateDateTime(e.Value))"
           required="@Required"
           disabled="@IsDisabled()"
           aria-required="@Required" />
</CascadingValue>

@code
{
    const string Format = "yyyy-MM-ddTHH:mm:ss";

    /// <summary>
    /// Gets or sets captured HTML attributes forwarded to the underlying element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// Gets the supplied HTML id or a Guid identifier generated once for this component instance.
    /// </summary>
    private string Id => GXComponentAttributes.GetId(AdditionalAttributes, ref _generatedId);

    private string? _generatedId;

    /// <summary>
    /// Gets or sets whether the component value is restored from and saved to browser local storage using its id.
    /// </summary>
    /// <seealso cref="Id" />
    [Parameter]
    public bool Save { get; set; } = true;

    /// <summary>
    /// Gets or sets whether user interaction with the input is disabled.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// Returns the disabled HTML attribute when date and time editing is disabled.
    /// </summary>
    private string? IsDisabled()
    {
        return Disabled ? "disabled" : null;
    }

    /// <summary>
    /// Gets or sets whether the input is marked as requiring a value.
    /// </summary>
    [Parameter]
    public bool Required { get; set; }

    /// <summary>
    /// Creates the date and time selector and verifies the supported bound value type.
    /// </summary>
    public GXDateTimeSelector()
    {
        Type type = Nullable.GetUnderlyingType(typeof(TItem)) ?? typeof(TItem);
        if (type != typeof(DateTime) && type != typeof(DateTimeOffset) && type != typeof(DateOnly) && type != typeof(TimeOnly))
        {
            throw new InvalidOperationException($"Unsupported {GetType()} type param '{type}'.");
        }
    }

    /// <summary>
    /// Gets or sets the typed date and time value edited by the selector.
    /// </summary>
    [Parameter]
    public TItem? Value { get; set; }

    /// <summary>
    /// Clears the selected date and time value and requests rendering.
    /// </summary>
    private void Reset()
    {
        UpdateDateTime(null);
    }

    /// <summary>
    /// Gets or sets the callback invoked when the bound value changes.
    /// </summary>
    [Parameter]
    public EventCallback<TItem?> ValueChanged { get; set; }

    /// <summary>
    /// Formats the supported date and time value using the configured format and invariant culture.
    /// </summary>
    private string? ValueToString()
    {
        if (Value is DateTime dt)
        {
            return BindConverter.FormatValue(dt,
                Format,
                CultureInfo.InvariantCulture);
        }

        if (Value is DateTimeOffset dto)
        {
            return BindConverter.FormatValue(dto,
                Format,
                CultureInfo.InvariantCulture);
        }

        if (Value is DateOnly d)
        {
            return BindConverter.FormatValue(d,
                Format,
                CultureInfo.InvariantCulture);
        }

        if (Value is TimeOnly tt)
        {
            return BindConverter.FormatValue(tt,
                Format,
                CultureInfo.InvariantCulture);
        }
        return string.Empty;
    }

    /// <summary>
    /// Gets the CSS classes obtained by combining component defaults with captured attributes.
    /// </summary>
    private string? CssClass => GXComponentAttributes.GetClass(AdditionalAttributes, "form-control");

    /// <summary>
    /// Gets or sets the hint displayed when the input has no value.
    /// </summary>
    [Parameter]
    public string? Placeholder { get; set; }

    /// <summary>
    /// Converts an edited date and time value, notifies changes, and saves it when persistence is enabled.
    /// </summary>
    private void UpdateDateTime(object? value, bool init = false)
    {
        bool change = false;
        if (value is string str &&
        !string.IsNullOrEmpty(str))
        {
            Value = default;
            TItem? result;
            if (!BindConverter.TryConvertTo<TItem>(value, CultureInfo.InvariantCulture, out result))
            {
                throw new Exception("Invalid date time.");
            }
            change = Value?.ToString() != result?.ToString();
            Value = result;
            if (change)
            {
                if (ValueChanged.HasDelegate)
                {
                    ValueChanged.InvokeAsync(Value);
                }
            }
        }
        else
        {
            change = Value != null;
            Value = default;
            if (change)
            {
                if (ValueChanged.HasDelegate)
                {
                    ValueChanged.InvokeAsync(Value);
                }
            }
        }
        try
        {
            if (!Disabled && !init && Save && !string.IsNullOrEmpty(Id))
            {
                localStorage.SetValueAsync(Id, ValueToString());
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex.Message);
        }
    }

    /// <summary>
    /// Restores a saved date and time value after the first render when persistence is enabled.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (firstRender)
        {
            try
            {
                if (!Disabled && Save && !string.IsNullOrEmpty(Id))
                {
                    string? str = await localStorage.GetValueAsync(Id);
                    UpdateDateTime(str, true);
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex.Message);
            }
        }
    }
}