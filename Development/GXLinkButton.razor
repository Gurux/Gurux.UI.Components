@*
<summary>
Renders a link-styled button with optional localized text, a click callback, and navigation.
</summary>
*@

@typeparam TItem

<button id="@Id" class="btn btn-link"
        style="padding: 0; border: none; background: none;"
        onclick="@(() => Click())">
    @if (string.IsNullOrEmpty(GXComponentAttributes.GetValue(AdditionalAttributes, "id")))
    {
        @Text
    }
    else
    {
        <GXLocalizedText Value="@Id" />
    }
</button>
@code
{
    /// <summary>
    /// Gets or sets captured HTML attributes forwarded to the underlying element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// Gets the supplied HTML id or a Guid identifier generated once for this component instance.
    /// </summary>
    private string Id => GXComponentAttributes.GetId(AdditionalAttributes, ref _generatedId);

    private string? _generatedId;

    /// <summary>
    /// Gets or sets the text displayed by the component.
    /// </summary>
    [Parameter]
    public string? Text { get; set; }

    /// <summary>
    /// Gets or sets the service provider used to resolve optional component services.
    /// </summary>
    [Inject]
    public IServiceProvider Services { get; set; } = default!;

    /// <summary>
    /// Gets the optional service used to retrieve localized resources.
    /// </summary>
    public IGXResourceStorage? ResourceStorage => Services.GetService<IGXResourceStorage>();

    /// <summary>
    /// Invokes the click callback and follows the target URI when it is provided.
    /// </summary>
    private async Task Click()
    {
        if (OnClick.HasDelegate && Target != null)
        {
            await OnClick.InvokeAsync(Target);
        }
    }

    /// <summary>
    /// Gets or sets the callback invoked when the menu command is clicked.
    /// </summary>
    [Parameter]
    public EventCallback<TItem> OnClick { get; set; }

    /// <summary>
    /// Gets or sets the browsing context used when opening the link, such as _blank.
    /// </summary>
    [Parameter]
    public TItem? Target { get; set; }

}
