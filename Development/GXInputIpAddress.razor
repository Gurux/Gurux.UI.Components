@*
<summary>
Edits supported IP address representations and can persist the bound value.
</summary>
*@

@using System.Diagnostics.CodeAnalysis
@using System.Globalization
@using Microsoft.Extensions.Logging
@using System.Net

@typeparam TItem

@inject IGXLocalStorage localStorage
@inject ILogger<GXDateTimeSelector<TItem>> Logger

<CascadingValue Value="this">
    <input id="@Id"
           value="@ValueToString()"
           placeholder="@Placeholder"
           @attributes="AdditionalAttributes" class="@CssClass"
           onreset="@(() => Reset())"
           onchange="@((ChangeEventArgs e) => UpdateIpAddress(e.Value))"
           required="@Required"
           readonly="readonly"
           aria-required="@Required" />
</CascadingValue>

@code
{
    /// <summary>
    /// Gets or sets captured HTML attributes forwarded to the underlying element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// Gets the supplied HTML id or a Guid identifier generated once for this component instance.
    /// </summary>
    private string Id => GXComponentAttributes.GetId(AdditionalAttributes, ref _generatedId);

    private string? _generatedId;

    /// <summary>
    /// Gets or sets whether the component value is restored from and saved to browser local storage using its id.
    /// </summary>
    /// <seealso cref="Id" />
    [Parameter]
    public bool Save { get; set; } = true;

    /// <summary>
    /// Gets or sets whether the IP address input is marked as requiring a value.
    /// </summary>
    [Parameter]
    public bool Required
    {
        get;
        set;
    }

    /// <summary>
    /// Creates the IP address input and verifies the supported address representation.
    /// </summary>
    public GXInputIpAddress()
    {
        Type type = Nullable.GetUnderlyingType(typeof(TItem)) ?? typeof(TItem);
        if (type != typeof(IPAddress) && type != typeof(UInt32) && type != typeof(UInt64) && type != typeof(string))
        {
            throw new InvalidOperationException($"Unsupported {GetType()} type param '{type}'.");
        }
    }

    /// <summary>
    /// Gets or sets the IP address as a supported address, numeric, or string representation.
    /// </summary>
    [Parameter]
    public TItem? Value
    {
        get;
        set;
    }

    /// <summary>
    /// Clears the selected IP address value and requests rendering.
    /// </summary>
    private void Reset()
    {
        UpdateIpAddress(null);
    }

    /// <summary>
    /// Gets or sets the callback invoked when the bound value changes.
    /// </summary>
    [Parameter]
    public EventCallback<TItem?> ValueChanged
    {
        get;
        set;
    }

    /// <summary>
    /// Converts the supported numeric address representation to IP address text.
    /// </summary>
    private static string IpToString(UInt64 value)
    {
        string ip;
        if (value > UInt32.MaxValue)
        {
            var bytes = BitConverter.GetBytes(value);
            if (BitConverter.IsLittleEndian)
            {
                Array.Reverse(bytes);
            }
            ip = new IPAddress(bytes).ToString();
        }
        else
        {
            ip = new IPAddress((UInt32)value).ToString();
        }
        return ip;
    }

    /// <summary>
    /// Formats the supported IPAddress, numeric address, or string value for the input.
    /// </summary>
    private string? ValueToString()
    {
        if (Value is IPAddress ip)
        {
            return ip.ToString();
        }
        if (Value is UInt32 ipv4)
        {
            return IpToString(ipv4);
        }
        if (Value is UInt64 value)
        {
            return IpToString(value);
        }
        if (Value is string str)
        {
            return str;
        }
        return string.Empty;
    }

    /// <summary>
    /// Gets the CSS classes obtained by combining component defaults with captured attributes.
    /// </summary>
    private string? CssClass => GXComponentAttributes.GetClass(AdditionalAttributes, "form-control");

    /// <summary>
    /// Gets or sets the hint displayed when the input has no value.
    /// </summary>
    [Parameter]
    public string? Placeholder { get; set; }

    /// <summary>
    /// Processes an edited IP address value, notifies changes, and saves it when persistence is enabled.
    /// </summary>
    private void UpdateIpAddress(object? value, bool init = false)
    {
        bool change = false;
        if (value is string str &&
        !string.IsNullOrEmpty(str))
        {
            Value = default;
            if (System.Net.IPAddress.TryParse(str, out var ip))
            {
                throw new Exception("Invalid IP address.");
            }
            TItem? result;
            if (!BindConverter.TryConvertTo<TItem>(value, CultureInfo.InvariantCulture, out result))
            {
                throw new Exception("Invalid date time.");
            }
            change = Value?.ToString() != result?.ToString();
            Value = result;
            if (change)
            {
                if (ValueChanged.HasDelegate)
                {
                    ValueChanged.InvokeAsync(Value);
                }
            }
        }
        else
        {
            change = Value != null;
            Value = default;
            if (change)
            {
                if (ValueChanged.HasDelegate)
                {
                    ValueChanged.InvokeAsync(Value);
                }
            }
        }
        try
        {
            if (!init && Save && !string.IsNullOrEmpty(Id))
            {
                localStorage.SetValueAsync(string.Empty, Id, ValueToString());
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex.Message);
        }
    }

    /// <summary>
    /// Restores a saved IP address value after the first render when persistence is enabled.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (firstRender)
        {
            try
            {
                if (Save && !string.IsNullOrEmpty(Id))
                {
                    string? str = await localStorage.GetValueAsync(Id);
                    UpdateIpAddress(str, true);
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex.Message);
            }
        }
    }
}
