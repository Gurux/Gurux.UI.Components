@*
<summary>
Edits supported IP address representations and can persist the bound value.
</summary>
*@

@using System.Diagnostics.CodeAnalysis
@using System.Linq.Expressions
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.Logging
@using System.Net

@typeparam TItem

@inject IGXLocalStorage localStorage
@inject ILogger<GXDateTimeSelector<TItem>> Logger

<CascadingValue Value="this">
    <input id="@Id"
           value="@ValueToString()"
           placeholder="@Placeholder"
           @attributes="GXComponentAttributes.WithoutCss(AdditionalAttributes)" style="@GXComponentAttributes.GetStyle(AdditionalAttributes)" class="@GXComponentAttributes.GetClass(AdditionalAttributes, "form-control")"
           onreset="@(() => Reset())"
           onchange="@((ChangeEventArgs e) => UpdateIpAddress(e.Value))"
           required="@Required"
           aria-required="@Required" />
</CascadingValue>

@code
{
    /// <summary>
    /// Gets or sets captured HTML attributes forwarded to the underlying element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// Gets the supplied HTML id or a Guid identifier generated once for this component instance.
    /// </summary>
    private string Id => GXComponentAttributes.GetId(AdditionalAttributes, ref _generatedId);

    private string? _generatedId;

    /// <summary>
    /// Gets or sets whether the component value is restored from and saved to browser local storage using its id.
    /// </summary>
    /// <seealso cref="Id" />
    [Parameter]
    public bool Save { get; set; } = true;

    /// <summary>
    /// Gets or sets whether the IP address input is marked as requiring a value.
    /// </summary>
    [Parameter]
    public bool Required { get; set; }

    /// <summary>
    /// Creates the IP address input and verifies the supported address representation.
    /// </summary>
    public GXInputIpAddress()
    {
        Type type = Nullable.GetUnderlyingType(typeof(TItem)) ?? typeof(TItem);
        if (type != typeof(IPAddress) && type != typeof(UInt32) && type != typeof(UInt64) && type != typeof(string))
        {
            throw new InvalidOperationException($"Unsupported {GetType()} type param '{type}'.");
        }
    }

    /// <summary>
    /// Gets or sets the IP address as a supported address, numeric, or string representation.
    /// </summary>
    [Parameter]
    public TItem? Value { get; set; }

    /// <summary>
    /// Clears the selected IP address value and requests rendering.
    /// </summary>
    private Task Reset()
    {
        return UpdateIpAddress(null);
    }

    /// <summary>
    /// Gets or sets the callback invoked when the bound value changes.
    /// </summary>
    [Parameter]
    public EventCallback<TItem?> ValueChanged { get; set; }

    /// <summary>
    /// Converts the supported numeric address representation to IP address text.
    /// </summary>
    private static string IpToString(UInt64 value)
    {
        string ip;
        if (value > UInt32.MaxValue)
        {
            var bytes = BitConverter.GetBytes(value);
            if (BitConverter.IsLittleEndian)
            {
                Array.Reverse(bytes);
            }
            ip = new IPAddress(bytes).ToString();
        }
        else
        {
            ip = new IPAddress((UInt32)value).ToString();
        }
        return ip;
    }

    /// <summary>
    /// Formats the supported IPAddress, numeric address, or string value for the input.
    /// </summary>
    private string? ValueToString()
    {
        if (Value is IPAddress ip)
        {
            return ip.ToString();
        }
        if (Value is UInt32 ipv4)
        {
            return IpToString(ipv4);
        }
        if (Value is UInt64 value)
        {
            return IpToString(value);
        }
        if (Value is string str)
        {
            return str;
        }
        return string.Empty;
    }

    /// <summary>
    /// Gets or sets the hint displayed when the input has no value.
    /// </summary>
    [Parameter]
    public string? Placeholder { get; set; }

    /// <summary>
    /// Identifies the optional bound model field for form change notifications.
    /// </summary>
    [Parameter]
    public Expression<Func<TItem?>>? ValueExpression { get; set; }

    /// <summary>The optional containing form.</summary>
    [CascadingParameter]
    protected EditContext? EditContext { get; set; }

    /// <summary>Applies valid edits and notifies the bound model and form once per change.</summary>
    private async Task UpdateIpAddress(object? value, bool init = false)
    {
        TItem? result = default;
        if (value is string str && !string.IsNullOrEmpty(str))
        {
            if (!IPAddress.TryParse(str, out var ip))
            {
                return;
            }
            Type type = Nullable.GetUnderlyingType(typeof(TItem)) ?? typeof(TItem);
            object converted;
            if (type == typeof(string))
            {
                converted = str;
            }
            else if (type == typeof(IPAddress))
            {
                converted = ip;
            }
            else
            {
                // Numeric representations use the IPv4 byte order of IPAddress(long).
                byte[] bytes = ip.GetAddressBytes();
                if (bytes.Length != 4)
                {
                    return;
                }
                uint address = (uint)bytes[0] | ((uint)bytes[1] << 8) |
                    ((uint)bytes[2] << 16) | ((uint)bytes[3] << 24);
                if (type == typeof(UInt32))
                {
                    converted = address;
                }
                else
                {
                    converted = (ulong)address;
                }
            }
            result = (TItem)converted;
        }
        if (EqualityComparer<TItem?>.Default.Equals(Value, result))
        {
            return;
        }
        Value = result;
        await ValueChanged.InvokeAsync(Value);
        if (EditContext != null && ValueExpression != null)
        {
            EditContext.NotifyFieldChanged(FieldIdentifier.Create(ValueExpression));
        }
        try
        {
            if (!init && Save && !string.IsNullOrEmpty(Id))
            {
                await localStorage.SetValueAsync(Id, ValueToString());
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex.Message);
        }
    }
    /// <summary>
    /// Restores a saved IP address value after the first render when persistence is enabled.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (firstRender)
        {
            try
            {
                if (Save && !string.IsNullOrEmpty(Id))
                {
                    string? str = await localStorage.GetValueAsync(Id);
                    if (str != null)
                    {
                        await UpdateIpAddress(str, true);
                    }
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex.Message);
            }
        }
    }
}

