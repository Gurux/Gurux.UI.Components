@*
<summary>
Renders an email form input with optional restoration and persistence of its value.
</summary>
*@

@using Microsoft.Extensions.Logging

@inject IGXLocalStorage localStorage
@inject ILogger<InputEmail> Logger

@inherits Microsoft.AspNetCore.Components.Forms.InputText
<input id="@Id" @attributes="AdditionalAttributes" type="email" value="@CurrentValue"
       class="@(GXComponentAttributes.CombineClasses("form-control", CssClass))"
       onchange="@((ChangeEventArgs __e) => UpdateValue(__e.Value))" />

@code {
    /// <summary>
    /// Gets the supplied HTML id or a Guid identifier generated once for this component instance.
    /// </summary>
    private string Id => GXComponentAttributes.GetId(AdditionalAttributes, ref _generatedId);

    private string? _generatedId;

    /// <summary>
    /// Gets or sets whether the component value is restored from and saved to browser local storage using its id.
    /// </summary>
    /// <seealso cref="Id" />
    [Parameter]
    public bool Save { get; set; } = false;

    /// <summary>
    /// Publishes the current value and saves it when persistence is enabled.
    /// </summary>
    private async Task UpdateValue(object? value)
    {
        string? str = Convert.ToString(value);
        if (Value != str)
        {
            Value = str;
            if (ValueChanged.HasDelegate)
            {
                await ValueChanged.InvokeAsync(Value);
            }
            try
            {
                if (Save && !string.IsNullOrEmpty(Id))
                {
                    await localStorage.SetValueAsync(Id, Convert.ToString(Value));
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex.Message);
            }
        }
    }

    /// <summary>
    /// Restores a saved email value when persistence is enabled.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (Save && !string.IsNullOrEmpty(Id))
            {
                string? value = await localStorage.GetValueAsync(Id);
                await UpdateValue(value);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex.Message);
        }
    }
}
