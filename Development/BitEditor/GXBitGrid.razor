@using Gurux.UI.Components.Enums
@namespace Gurux.UI.Components.BitEditor
@using Microsoft.AspNetCore.Components.Web.Virtualization
@using Microsoft.JSInterop
@using System.Globalization
@implements IAsyncDisposable
@inject IJSRuntime JS

<div @ref="_host" class="gx-bit-viewport" data-bit-count="@BitCount" style="--bits-per-row: @_columns; --bit-row-height: @(RowHeight)px" tabindex="0">
    @if (Virtualize)
    {
        @RenderVirtualizedRows
    }
    else
    {
        @for (int row = 0; row < RowCount; ++row)
        {
            @RenderRow(row)
        }
    }
</div>

@code {
    /// <summary>Builds one fixed-height row, including logical indexes, groups and accessible bit controls.</summary>
    /// <param name="row">The zero-based global row index.</param>
    /// <returns>A fragment that renders the current bits in the requested row.</returns>
    private RenderFragment RenderRow(int row) => @<div class="gx-bit-grid" @key="row" style="height: @(RowHeight)px">
        @for (int p = row * _columns; p < Math.Min(BitCount, (row + 1) * _columns); ++p)
        {
            int display = p;
            int index = LogicalIndex(display);
            int storageByte = BitString ? index / 8 : display / 8;
            int shift = BitString ? 7 - index % 8 : index % 8;
            bool value = (Bytes[storageByte] & (1 << shift)) != 0;
            bool modified = storageByte >= Original.Length || ((Bytes[storageByte] ^ Original[storageByte]) & (1 << shift)) != 0;
            Definitions.TryGetValue(index, out var definition);
            string label = string.Format(CultureInfo.CurrentCulture, Properties.Resources.BitEditorBitLabel, index, value ? 1 : 0, definition?.Name, definition?.Description);
            <div @key="index" class="gx-bit-cell @(display > row * _columns && display % GroupSize == 0 ? "gx-bit-group" : null)">
                @if (ShowByteIndex)
                {
                    <small class="gx-byte-index">@(display % 8 == 0 ? string.Format(CultureInfo.CurrentCulture, Properties.Resources.BitEditorByteLabel, display / 8) : "\u00a0")</small>
                }
                @if (ShowBitIndex)
                {
                    <small aria-hidden="true">@index</small>
                }
                <button type="button" data-display-index="@display" class="gx-bit @(modified ? "gx-bit-modified" : null)" aria-label="@label"
                        aria-pressed="@(value ? "true" : "false")" aria-disabled="@((ReadOnly || definition?.ReadOnly == true) ? "true" : "false")"
                        title="@label" disabled="@(Disabled || ReadOnly || definition?.ReadOnly == true)"
                        @onclick="@(() => Toggle.InvokeAsync(index))">
                    @(value ? "1" : "0")
                </button>
            </div>
        }
    </div>;
}
