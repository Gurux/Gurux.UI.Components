@namespace Gurux.UI.Components
@implements IAsyncDisposable

<div class="gx-camera">
    <video @ref="_video" autoplay muted playsinline></video>
    <img @ref="_preview" hidden alt="@PreviewAltText" />
    <div class="gx-camera-controls">
        <button type="button" class="btn btn-primary" disabled="@(_busy || _running)" @onclick="StartCameraAsync"><GXLocalizedText Value="Start camera" /></button>
        <button type="button" class="btn btn-secondary" disabled="@(!_running && !_busy)" @onclick="StopCameraAsync"><GXLocalizedText Value="Stop camera" /></button>
        <button type="button" class="btn btn-secondary" disabled="@(_busy || !_running)" @onclick="SwitchCameraAsync"><GXLocalizedText Value="Switch camera" /></button>
        <button type="button" class="btn btn-primary" disabled="@(_busy || !_running)" @onclick="CaptureFromButtonAsync"><GXLocalizedText Value="Take photo" /></button>
        @if (_hasPhoto)
        {
            <button type="button" class="btn btn-secondary" disabled="@_busy" @onclick="RetakeAsync"><GXLocalizedText Value="Retake photo" /></button>
        }
    </div>
    @if (_error is not null)
    {
        <p role="alert"><GXLocalizedText Value="@_error" /></p>
    }
</div>
