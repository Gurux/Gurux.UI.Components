@*
<summary>
Displays transient toast messages and refreshes them as messages are added, removed, or expired.
</summary>
*@


@using Gurux.UI.Components
@using Gurux.UI.Components.Enums
@namespace Gurux.UI.Component.Toaster

@inject IServiceProvider Services
@if (ToasterService?.Any == true)
{
    <div>
        <div class="toast-container position-absolute top-0 end-0 mt-5 pt-5 pe-2" style="z-index: 1080;">
            @foreach (var it in this.ToasterService.GetToasts())
            {
                var toast = GetCss(it);
                <div class="toast show" role="alert" aria-live="assertive" aria-atomic="true">
                    <div class="toast-header @toast">
                        <strong class="me-auto">@((MarkupString)(it.Title ?? string.Empty))</strong>
                        <GXAutoRefresh>
                            <small class="@toast; markup">@it.PostedTimeText</small>
                        </GXAutoRefresh>
                        <button type="button" class="btn-close btn-close-white" aria-label="Close"
                                @onclick="() => Close(it)"></button>
                    </div>
                    <div class="toast-body; markup">
                        @((MarkupString)(it.Message ?? string.Empty))
                    </div>
                </div>
            }
        </div>
    </div>
}

@code
{
    private IGXToasterService? ToasterService;
    private bool _disposed;

    /// <summary>
    /// Subscribes to toast list changes and expiration notifications.
    /// </summary>
    protected override void OnInitialized()
    {
        ToasterService = Services.GetService<IGXToasterService>();
        if (ToasterService != null)
        {
            ToasterService.ToasterChanged += ToastChanged;
            ToasterService.ToasterTimerElapsed += ToastChanged;
        }
    }

    /// <summary>
    /// Removes the selected notification or toast from its backing service.
    /// </summary>
    private void Close(GXToast toast)
    {
        ToasterService?.Remove(toast);
    }

    /// <summary>
    /// Schedules rendering after the toaster service reports a change.
    /// </summary>
    private void ToastChanged(object? sender, EventArgs e)
    {
        _ = InvokeAsync(() =>
        {
            if (!_disposed)
            {
                StateHasChanged();
            }
        });
    }

    /// <summary>
    /// Detaches toaster service change and expiration event handlers.
    /// </summary>
    public void Dispose()
    {
        _disposed = true;
        if (ToasterService != null)
        {
            ToasterService.ToasterChanged -= ToastChanged;
            ToasterService.ToasterTimerElapsed -= ToastChanged;
            ToasterService = null;
        }
    }

    /// <summary>
    /// Returns the contextual CSS class for the toast's color.
    /// </summary>
    private string GetCss(GXToast toast)
    {
        var colour = Enum.GetName(typeof(Color), toast.Color)?.ToLower();
        return toast.Color switch
        {
            Color.Light => "bg-light",
            _ => $"bg-{colour} text-white"
        };
    }
}