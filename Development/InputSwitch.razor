@*
<summary>
Binds a switch to a form value with callbacks, localized labels, and optional persistence.
</summary>
*@

@using System.Diagnostics.CodeAnalysis
@using Microsoft.Extensions.Logging
@inject IGXLocalStorage localStorage
@typeparam TValue
@inject ILogger<InputSwitch<TValue>> Logger

@inherits InputBase<TValue>
<CascadingValue Value="this">
    <label class="form-check-label">
        <LocalizedText Value="@Text" />
    </label>
    @ChildContent
    <div class="form-check form-switch">
        <input @attributes="AdditionalAttributes" id="@Id" type="checkbox" checked="@(CurrentValue is true)"
               class="@(GXComponentAttributes.CombineClasses("form-check-input", CssClass))"
               disabled="@IsDisabled()"
               onchange="@(async (ChangeEventArgs e) => await UpdateCheck(Convert.ToBoolean(e.Value)))" />
    </div>
</CascadingValue>

@code {
    /// <summary>
    /// Creates the switch and verifies that its bound type is bool or nullable bool.
    /// </summary>
    public InputSwitch()
    {
        if ((Nullable.GetUnderlyingType(typeof(TValue)) ?? typeof(TValue)) != typeof(bool))
        {
            throw new InvalidOperationException("InputSwitch supports only bool and bool?.");
        }
    }

    /// <summary>
    /// Converts a checkbox state to the component's supported bound type.
    /// </summary>
    private static TValue FromBoolean(bool value) => (TValue)(object)value;

    /// <summary>
    /// Gets the supplied HTML id or a Guid identifier generated once for this component instance.
    /// </summary>
    private string Id => GXComponentAttributes.GetId(AdditionalAttributes, ref _generatedId);

    private string? _generatedId;

    /// <summary>
    /// Gets or sets the service provider used to resolve optional component services.
    /// </summary>
    [Inject]
    public IServiceProvider Services { get; set; } = default!;

    /// <summary>
    /// Gets the optional resource service used to localize the switch label.
    /// </summary>
    public IGXResourceStorage? ResourceStorage => Services.GetService<IGXResourceStorage>();

    /// <summary>
    /// Gets or sets whether the component value is restored from and saved to browser local storage using its id.
    /// </summary>
    /// <seealso cref="Id" />
    [Parameter]
    public bool Save { get; set; } = false;

    /// <summary>
    /// Gets or sets the content rendered inside the component.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Gets or sets the text displayed by the component.
    /// </summary>
    [Parameter]
    public string? Text { get; set; }

    /// <summary>
    /// Gets or sets whether user interaction with the input is disabled.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked when the user changes the value.
    /// </summary>
    [Parameter]
    public EventCallback<bool> OnChange { get; set; }

    /// <summary>
    /// Applies a changed checked state, invokes value callbacks, and persists the value when enabled.
    /// </summary>
    private async Task UpdateCheck(bool value)
    {
        if (!EqualityComparer<TValue>.Default.Equals(Value, FromBoolean(value)))
        {
            CurrentValue = FromBoolean(value);
            if (OnChange.HasDelegate)
            {
                await OnChange.InvokeAsync(value);
            }
            try
            {
                if (Save && !string.IsNullOrEmpty(Id))
                {
                    await localStorage.SetValueAsync(Id, Convert.ToString(Value));
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex.Message);
            }
        }
    }

    /// <summary>
    /// Rejects string parsing because switch values are supplied as boolean change events.
    /// </summary>
    protected override bool TryParseValueFromString(string? value,
        [MaybeNullWhen(false)] out TValue result,
        [NotNullWhen(false)] out string? validationErrorMessage)
    {
        result = default!;
        validationErrorMessage = null;
        if (string.IsNullOrWhiteSpace(value) && Nullable.GetUnderlyingType(typeof(TValue))is not null)
        {
            return true;
        }
        if (value is null || bool.TryParse(value, out _))
        {
            result = FromBoolean(value is not null && bool.Parse(value));
            return true;
        }
        validationErrorMessage = "Enter a valid boolean value.";
        return false;
    }


    /// <summary>
    /// Returns the disabled HTML attribute when switch editing is disabled.
    /// </summary>
    private string? IsDisabled()
    {
        return Disabled ? "disabled" : null;
    }

    /// <summary>
    /// Restores a saved switch value when persistence is enabled.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (Save && !string.IsNullOrEmpty(Id))
            {
                string? value = await localStorage.GetValueAsync(Id);
                if (!string.IsNullOrEmpty(value))
                {
                    CurrentValue = FromBoolean(bool.Parse(value));
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex.Message);
        }
    }
}
