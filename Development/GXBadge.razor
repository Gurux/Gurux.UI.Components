@*
<summary>
Displays a contextual badge with text or a numeric count alongside optional child content.
</summary>
*@

@using System.Diagnostics
@using Gurux.UI.Components.Enums

@ChildContent
@if (Value != Default)
{
    <sup class="@GetBadgeClass()">@ValueToString()</sup>
}
@code {
    /// <summary>
    /// Gets or sets the content rendered inside the component.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Gets or sets the text displayed alongside the badge value.
    /// </summary>
    [Parameter]
    public string? Label { get; set; }

    /// <summary>
    /// Gets or sets whether the badge uses a rounded pill shape; enabled by default.
    /// </summary>
    [Parameter]
    public bool Pill { get; set; } = true;

    /// <summary>
    /// Gets or sets the Bootstrap contextual color of the badge.
    /// </summary>
    [Parameter]
    public Color Color { get; set; }

    /// <summary>
    /// Gets or sets the diagnostic level used to choose the badge's contextual color.
    /// </summary>
    [Parameter]
    public TraceLevel TraceLevel { get; set; }

    /// <summary>
    /// Gets or sets the initial badge count used when no nonzero value has been supplied.
    /// </summary>
    [Parameter]
    public int Default { get; set; } = 0;

    /// <summary>
    /// Gets or sets the numeric count displayed inside the badge.
    /// </summary>
    [Parameter]
    public int Value { get; set; } = 0;

    /// <summary>
    /// Formats the badge count, displaying 99+ for values greater than 99.
    /// </summary>
    private string ValueToString()
    {
        if (Value > 99)
        {
            return "99+";
        }
        return Value.ToString();
    }

    /// <summary>
    /// Initializes the badge count from Default when Value remains zero.
    /// </summary>
    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (Value == 0 && Default != 0)
        {
            Value = Default;
        }
    }

    /// <summary>
    /// Returns the badge classes for the configured contextual color and pill shape.
    /// </summary>
    /// <returns>A CSS class string to apply to the badge element.</returns>
    private string GetBadgeClass()
    {
        var colour = Enum.GetName(typeof(Color), Color)?.ToLower();
        var bgClass = Color switch
        {
            Color.Light => "bg-light",
            _ => $"bg-{colour} text-white"
        };
        var pillClass = Pill ? "rounded-pill" : string.Empty;
        // Keep a small left margin to separate from the child content, as original markup used "ms-1".
        return $"badge {bgClass} {pillClass} ms-1".Trim();
    }
}