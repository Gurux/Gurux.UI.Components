@*
<summary>
Edits a nullable time value with an optional static sentinel represented by DateTimeOffset.MaxValue.
</summary>
*@


@using System.Diagnostics.CodeAnalysis
@using System.Globalization;

@inherits InputBase<DateTimeOffset?>

<input @attributes="GXComponentAttributes.WithoutCss(AdditionalAttributes)" style="@GXComponentAttributes.GetStyle(AdditionalAttributes)" class="@GXComponentAttributes.GetClass(AdditionalAttributes, GXComponentAttributes.CombineClasses("form-control", EditContext?.FieldCssClass(FieldIdentifier)))" disabled="@IsDisabled()" value="@BindConverter.FormatValue(CurrentValueAsString)" onchange="@((ChangeEventArgs __e) => CurrentValueAsString = Convert.ToString(__e.Value))" />
<Gurux.UI.Components.GXInputCheckbox @bind-Value="Static" />
@code {

    private bool _static;
    /// <summary>
    /// Gets or sets whether the input represents a static value using DateTimeOffset.MaxValue.
    /// </summary>
    private bool Static
    {
        get
        {
            return _static;
        }
        set
        {
            if (_static && CurrentValueAsString == "static")
            {
                CurrentValue = null;
            }
            _static = value;
            if (_static)
            {
                CurrentValue = DateTimeOffset.MaxValue;
            }
            InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>
    /// Disables time editing while static mode is selected.
    /// </summary>
    private bool IsDisabled()
    {
        return Static;
    }

    /// <summary>
    /// Parses a time value, returning the static sentinel when enabled and null for absent or zero time.
    /// </summary>
    protected override bool TryParseValueFromString(string? value,
        [MaybeNullWhen(false)] out DateTimeOffset? result,
        [NotNullWhen(false)] out string validationErrorMessage)
    {
        validationErrorMessage = "";
        if (Static)
        {
            result = DateTimeOffset.MaxValue;
        }
        else
        {
            if (value != null)
            {
                result = DateTimeOffset.Parse(value);
            }
            else
            {
                result = null;
            }
            if (result.HasValue)
            {
                DateTimeOffset tmp = result.Value;
                if (tmp.Minute == 0 && tmp.Second == 0 && tmp.Hour == 0)
                {
                    result = null;
                }
            }
        }
        return true;
    }

    /// <summary>
    /// Formats a nullable time as HH:mm:ss, using static for the sentinel value and zero time for null.
    /// </summary>
    protected override string? FormatValueAsString(DateTimeOffset? value)
    {
        if (Static)
        {
            return "static";
        }
        if (value == null)
        {
            return "00:00:00";
        }
        return BindConverter.FormatValue(value, "HH:mm:ss");
    }

    /// <summary>
    /// Recognizes the static sentinel in the initial value and enables static mode.
    /// </summary>
    protected override void OnInitialized()
    {
        if (CurrentValue.HasValue && CurrentValue.Value.Year == DateTimeOffset.MaxValue.Year)
        {
            _static = true;
        }
    }
}
