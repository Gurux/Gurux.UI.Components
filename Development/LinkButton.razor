@typeparam TItem

<button class="btn btn-link"
        style="padding: 0; border: none; background: none;"
        onclick="@(() => Click())">
    @if (string.IsNullOrEmpty(Id))
    {
        @Text
    }
    else
    {
        <LocalizedText Value="@Id" />
    }
</button>
@code
{
    /// <summary>
    /// Additional attributes that will be applied to the underlying HTML element. If you specify an attribute with the same name as a component parameter, the component parameter value will take precedence.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// Return the id from the AdditionalAttributes.
    /// </summary>
    private string? Id =>
       AdditionalAttributes?.TryGetValue("id", out var value) == true
           ? value?.ToString()
           : null;

    [Parameter]
    public string? Text { get; set; }

    /// <summary>
    /// Used resource storage.
    /// </summary>
    [CascadingParameter]
    public IGXResourceStorage? ResourceStorage { get; set; }

    private void Click()
    {
        if (OnClick != null && Target != null)
        {
            OnClick(Target);
        }
    }

    /// <summary>
    /// User has click the link.
    /// </summary>
    [Parameter]
    public Action<TItem>? OnClick { get; set; }

    [Parameter]
    public TItem? Target { get; set; }

}