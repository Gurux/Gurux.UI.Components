@*
<summary>
Uses a switch to set or clear selected bits in a bound numeric value.
</summary>
*@

@using System.Diagnostics.CodeAnalysis
@using System.Globalization
@using Microsoft.Extensions.Logging

@typeparam TItem

@inject IGXLocalStorage localStorage
@inject ILogger<InputMaskedCheckbox<TItem>> Logger

<CascadingValue Value="this">
    <div class="form-check form-switch">
        @if (@Text != null)
        {
            <label class="form-check-label">@Text</label>
        }
        <input id="@Id"
               type="checkbox"
               checked="@IsChecked"
               placeholder="@Placeholder"
               @attributes="AdditionalAttributes" class="@CssClass"
               disabled="@IsDisabled()"
               onchange="@(async (ChangeEventArgs e) => await UpdateString(e.Value))" />
        @ChildContent
    </div>
</CascadingValue>

@code
{
    /// <summary>
    /// Gets or sets the content rendered inside the component.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Gets or sets captured HTML attributes forwarded to the underlying element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// Gets the supplied HTML id or a Guid identifier generated once for this component instance.
    /// </summary>
    private string Id => GXComponentAttributes.GetId(AdditionalAttributes, ref _generatedId);

    private string? _generatedId;

    /// <summary>
    /// Gets or sets the text displayed by the component.
    /// </summary>
    [Parameter]
    public string? Text { get; set; }

    /// <summary>
    /// Gets or sets whether the component value is restored from and saved to browser local storage using its id.
    /// </summary>
    /// <seealso cref="Id" />
    [Parameter]
    public bool Save { get; set; } = false;

    /// <summary>
    /// Gets or sets whether the input is marked as requiring a value.
    /// </summary>
    [Parameter]
    public bool Required
    {
        get;
        set;
    }

    /// <summary>
    /// Gets or sets whether user interaction with the input is disabled.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// Returns the required HTML attribute when a value is required.
    /// </summary>
    private string? IsRequired()
    {
        return Required ? " required" : null;
    }

    /// <summary>
    /// Gets or sets the numeric value containing the bits controlled by the switch mask.
    /// </summary>
    [Parameter]
    public TItem? Value
    {
        get;
        set;
    }

    /// <summary>
    /// Gets or sets the bit mask that the checkbox or switch updates within the bound value.
    /// </summary>
    [Parameter]
    public TItem? Mask
    {
        get;
        set;
    }

    /// <summary>
    /// Gets whether all bits selected by the mask are set in the current value.
    /// </summary>
    private bool IsChecked
    {
        get
        {
            if (Value == null || Mask == null)
            {
                return false;
            }
            try
            {
                UInt64 value, mask;
                if (Value is byte)
                {
                    value = (byte)(object)Value;
                    mask = (byte)(object)Mask;
                }
                else if (Value is UInt16)
                {
                    value = (UInt16)(object)Value;
                    mask = (UInt16)(object)Mask;
                }
                else if (Value is UInt32)
                {
                    value = (UInt32)(object)Value;
                    mask = (UInt32)(object)Mask;
                }
                else if (Value is UInt64)
                {
                    value = (UInt64)(object)Value;
                    mask = (UInt64)(object)Mask;
                }
                else
                {
                    throw new Exception("Invalid value.");
                }
                return (value & mask) != 0;
            }
            catch (Exception ex)
            {
                Logger.LogError(ex.Message);
                return false;
            }
        }
        set
        {
            try
            {
                if (Mask == null)
                {
                    throw new Exception("Invalid mask.");
                }
                UInt64 value2, mask;
                value2 = Convert.ToUInt64(Value);
                mask = Convert.ToUInt64(Mask);
                if (value)
                {
                    value2 = (value2 | mask);
                }
                else
                {
                    value2 = value2 & ~mask;
                }
                //Don't remove cast or it will fail.
                if (Value is byte)
                {
                    Value = (TItem)(object)(byte)value2;
                }
                else if (Value is UInt16)
                {
                    Value = (TItem)(object)(UInt16)value2;
                }
                else if (Value is UInt32)
                {
                    Value = (TItem)(object)(UInt32)value2;
                }
                else if (Value is UInt64)
                {
                    Value = (TItem)(object)(UInt64)value2;
                }
                else if (Value is int)
                {
                    Value = (TItem)(object)(int)value2;
                }
                else
                {
                    throw new Exception("Invalid value.");
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex.Message);
            }
        }
    }

    /// <summary>
    /// Gets or sets the callback invoked when the bound value changes.
    /// </summary>
    [Parameter]
    public EventCallback<TItem?> ValueChanged
    {
        get;
        set;
    }

    /// <summary>
    /// Gets the CSS classes obtained by combining component defaults with captured attributes.
    /// </summary>
    private string? CssClass => GXComponentAttributes.GetClass(AdditionalAttributes, "form-check-input");

    /// <summary>
    /// Returns the disabled HTML attribute when editing is disabled.
    /// </summary>
    private string? IsDisabled()
    {
        return Disabled ? "disabled" : null;
    }

    /// <summary>
    /// Gets or sets the hint displayed when the input has no value.
    /// </summary>
    [Parameter]
    public string? Placeholder { get; set; }

    /// <summary>
    /// Sets or clears the masked bits according to the checked state, then notifies and optionally persists the value.
    /// </summary>
    private async Task UpdateString(object? value, bool init = false)
    {
        bool change = false;
        change = Value?.ToString() != value?.ToString();
        IsChecked = Convert.ToBoolean(value);
        if (change)
        {
            if (ValueChanged.HasDelegate)
            {
                await ValueChanged.InvokeAsync(Value);
            }
        }
        try
        {
            if (!init && Save && !string.IsNullOrEmpty(Id))
            {
                await localStorage.SetValueAsync(Id, ValueToString());
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex.Message);
        }
    }

    /// <summary>
    /// Returns the text representation of the masked input's bound value.
    /// </summary>
    private string? ValueToString()
    {
        TItem? result;
        if (!BindConverter.TryConvertTo<TItem>(Value, CultureInfo.InvariantCulture, out result))
        {
            throw new Exception("Invalid date time.");
        }
        return result?.ToString();
    }

    /// <summary>
    /// Restores the masked switch's saved value after the first render when persistence is enabled.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (firstRender && Save && !string.IsNullOrEmpty(Id))
        {
            try
            {
                TItem? result;
                string? str = await localStorage.GetValueAsync(Id);
                if (!string.IsNullOrEmpty(str))
                {
                    if (!BindConverter.TryConvertTo<TItem>(str, CultureInfo.InvariantCulture, out result))
                    {
                        throw new Exception("Invalid value.");
                    }
                    else
                    {
                        Value = result;
                    }
                    if (ValueChanged.HasDelegate)
                    {
                        await ValueChanged.InvokeAsync(Value);
                    }
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex.Message);
            }
        }
    }
}