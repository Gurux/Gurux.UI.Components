@using Microsoft.Extensions.Logging

<span class="@CssClass">
    @GetValue()
    @ChildContent
</span>

@code {
    /// <summary>
    /// Child content that the badge is attached to (for example an icon or text).
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string? Value { get; set; }

    /// Update text when changed.
    [Parameter]
    public bool Update { get; set; }

    [Inject]
    ILogger<Image> Logger { get; set; } = default!;

    /// Update text when changed.
    [Parameter]
    public EventCallback<bool> UpdateChanged { get; set; }

    private string? _localizedValue;
    private string? GetValue()
    {
        if (_localizedValue != null)
        {
            return _localizedValue;
        }
        return Value;
    }

    /// <summary>
    /// Used resource storage.
    /// </summary>
    [CascadingParameter]
    public IGXResourceStorage? ResourceStorage { get; set; }

    [Parameter]
    public string? CssClass { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (ResourceStorage != null && !string.IsNullOrEmpty(Value))
        {
            _localizedValue = await ResourceStorage.GetLocalizedTextAsync(Value);
            // Logger.LogInformation($"Loading localized text with Id: {Value}: {_localizedValue}");
        }
        else
        {
            _localizedValue = Value;
        }
    }

    protected override void OnInitialized()
    {
        if (ResourceStorage != null)
        {
            ResourceStorage.OnTextChanged += Updated;
        }
        base.OnInitializedAsync();
    }

    /// <summary>
    /// Update new text when changed.
    /// </summary>
    private void Updated(object? sender, GXTextChangedEventArgs arg)
    {
        if (_localizedValue == arg.PreviousText)
        {
            // Logger.LogInformation($"Updated localized text with Id: {_localizedValue}: {arg.CurrentText}");
            _localizedValue = arg.CurrentText;
            StateHasChanged();
        }
    }
}