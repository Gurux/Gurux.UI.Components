@*
<summary>
Displays a translated resource string and refreshes it when the resource changes.
</summary>
*@

@using Microsoft.Extensions.Logging

<span @attributes="GXComponentAttributes.WithoutCss(AdditionalAttributes)" class="@CssClass" style="@GXComponentAttributes.GetStyle(AdditionalAttributes)">
    @GetValue()
    @ChildContent
</span>

@implements IDisposable

@code {
    /// <summary>
    /// Gets or sets captured HTML attributes forwarded to the underlying element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private bool _disposed;
    /// <summary>
    /// Gets or sets the content rendered inside the component.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Gets or sets the resource key to translate and display.
    /// </summary>
    [Parameter]
    public string? Value { get; set; }

    /// <summary>
    /// Gets or sets whether the localization change should be propagated through the update callback.
    /// </summary>
    [Parameter]
    public bool Update { get; set; }

    /// <summary>
    /// Gets or sets the injected logger used to report component activity and errors.
    /// </summary>
    [Inject]
    ILogger<Image> Logger { get; set; } = default!;

    /// <summary>
    /// Gets or sets the callback invoked when the localization refresh flag changes.
    /// </summary>
    [Parameter]
    public EventCallback<bool> UpdateChanged { get; set; }

    private string? _localizedValue;
    /// <summary>
    /// Returns the translated text when available, falling back to the supplied resource key.
    /// </summary>
    private string? GetValue()
    {
        if (_localizedValue != null)
        {
            return _localizedValue;
        }
        return Value;
    }

    /// <summary>
    /// Gets or sets the service provider used to resolve optional component services.
    /// </summary>
    [Inject]
    public IServiceProvider Services { get; set; } = default!;

    /// <summary>
    /// Gets the optional service used to retrieve localized resources.
    /// </summary>
    public IGXResourceStorage? ResourceStorage => Services.GetService<IGXResourceStorage>();

    /// <summary>
    /// Gets the CSS classes obtained by combining component defaults with captured attributes.
    /// </summary>
    private string? CssClass => GXComponentAttributes.GetClass(AdditionalAttributes, null);

    /// <summary>
    /// Loads the translation for the supplied resource key, falling back to that key when no service is available.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        if (ResourceStorage != null && !string.IsNullOrEmpty(Value))
        {
            _localizedValue = await ResourceStorage.GetLocalizedTextAsync(Value);
            // Logger.LogInformation($"Loading localized text with Id: {Value}: {_localizedValue}");
        }
        else
        {
            _localizedValue = Value;
        }
    }

    /// <summary>
    /// Subscribes to localized text change notifications when a resource service is available.
    /// </summary>
    protected override void OnInitialized()
    {
        if (ResourceStorage != null)
        {
            ResourceStorage.OnTextChanged += Updated;
        }
        base.OnInitialized();
    }

    /// <summary>
    /// Refreshes the displayed localization when the changed text matches this component's resource.
    /// </summary>
    private void Updated(object? sender, GXTextChangedEventArgs arg)
    {
        _ = InvokeAsync(() =>
        {
            if (!_disposed && _localizedValue == arg.PreviousText)
            {
                _localizedValue = arg.CurrentText;
                StateHasChanged();
            }
        });
    }

    /// <summary>
    /// Stops handling localized text changes and marks the component as disposed.
    /// </summary>
    public void Dispose()
    {
        _disposed = true;
        if (ResourceStorage != null)
        {
            ResourceStorage.OnTextChanged -= Updated;
        }
    }
}