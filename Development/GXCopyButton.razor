@*
<summary>
Copies a value to the clipboard and displays a temporary success indicator.
</summary>
*@

@using Microsoft.JSInterop
@implements IDisposable
@inject IJSRuntime JS
@typeparam TItem

<script>
    function copyToClipboard(text) {
        if (navigator.clipboard) {
            navigator.clipboard.writeText(text);
        } else {
            const textarea = document.createElement("textarea");
            textarea.value = text;
            document.body.appendChild(textarea);
            textarea.select();
            document.execCommand("copy");
            document.body.removeChild(textarea);
        }
    }
</script>

@ChildContent
<button class="copy-btn @(AlignRight ? "align-right" : "")"
        onclick="@CopyToClipboard"
        title="@ButtonTitle"
        aria-label="@ButtonTitle">
    <span class="tooltip">@ButtonTitle</span>
    @if (_copied)
    {
        <!-- Check icon -->
        <svg xmlns="http://www.w3.org/2000/svg"
             viewBox="0 0 24 24"
             fill="none"
             stroke="currentColor"
             stroke-width="2"
             stroke-linecap="round"
             stroke-linejoin="round"
             width="18"
             height="18">
            <path d="M20 6 9 17l-5-5" />
        </svg>
    }
    else
    {
        <!-- Copy icon -->
        <svg xmlns="http://www.w3.org/2000/svg"
             viewBox="0 0 24 24"
             fill="none"
             stroke="currentColor"
             stroke-width="2"
             stroke-linecap="round"
             stroke-linejoin="round"
             width="18"
             height="18">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
        </svg>
    }
</button>

@code {
    /// <summary>
    /// Gets or sets the content rendered inside the component.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Gets or sets the value whose string representation is copied to the clipboard.
    /// </summary>
    [Parameter, EditorRequired]
    public TItem? Value { get; set; }


    /// <summary>
    /// Gets or sets how long the clipboard success indicator remains visible, in milliseconds.
    /// </summary>
    [Parameter]
    public int SuccessDurationMs { get; set; } = 3000;

    /// <summary>
    /// Gets or sets whether the copy button is aligned to the right.
    /// </summary>
    [Parameter]
    public bool AlignRight { get; set; }

    private bool _copied;
    private CancellationTokenSource? _cts;

    /// <summary>
    /// Gets the copy button tooltip for the current clipboard state.
    /// </summary>
    private string ButtonTitle => _copied ? "Copied" : "Copy";

    /// <summary>
    /// Copies the current value to the browser clipboard and temporarily displays a success indicator.
    /// </summary>
    private async Task CopyToClipboard()
    {
        if (Value != null)
        {
            await JS.InvokeVoidAsync("copyToClipboard", Value.ToString());

            _copied = true;
            StateHasChanged();

            _cts?.Cancel();
            _cts?.Dispose();
            _cts = new CancellationTokenSource();

            try
            {
                await Task.Delay(SuccessDurationMs, _cts.Token);
                _copied = false;
                await InvokeAsync(StateHasChanged);
            }
            catch (TaskCanceledException)
            {
                //It's possible that the user clicks the button again before the previous timer has completed.
                // In that case, we cancel the previous timer and start a new one,
                // so we can safely ignore TaskCanceledException here.
            }
        }
    }

    /// <summary>
    /// Cancels the pending clipboard success delay and releases its cancellation token source.
    /// </summary>
    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
