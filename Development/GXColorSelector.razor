@*
<summary>
Edits a typed color value with optional browser local storage persistence.
</summary>
*@

@using System.Diagnostics.CodeAnalysis
@using System.Globalization
@using Microsoft.Extensions.Logging
@using System.Net

@typeparam TItem

@inject IGXLocalStorage localStorage
@inject ILogger<GXColorSelector<TItem>> Logger

<CascadingValue Value="this">
    <input id="@Id"
           type="color"
           value="@Value"
           placeholder="@Placeholder"
           @attributes="GXComponentAttributes.WithoutCss(AdditionalAttributes)" style="@GXComponentAttributes.GetStyle(AdditionalAttributes)" class="@GXComponentAttributes.GetClass(AdditionalAttributes, "form-control")"
           onreset="@(() => Reset())"
           onchange="@((ChangeEventArgs e) => UpdateColor(e.Value))"
           required="@Required"
           readonly="readonly"
           aria-required="@Required" />
</CascadingValue>

@code
{

    /// <summary>
    /// Gets or sets captured HTML attributes forwarded to the underlying element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// Gets the supplied HTML id or a Guid identifier generated once for this component instance.
    /// </summary>
    private string Id => GXComponentAttributes.GetId(AdditionalAttributes, ref _generatedId);

    private string? _generatedId;

    /// <summary>
    /// Gets or sets whether the component value is restored from and saved to browser local storage using its id.
    /// </summary>
    /// <seealso cref="Id" />
    [Parameter]
    public bool Save { get; set; } = true;

    /// <summary>
    /// Gets or sets whether the input is marked as requiring a value.
    /// </summary>
    [Parameter]
    public bool Required { get; set; }

    /// <summary>
    /// Creates the color selector and rejects unsupported bound value types.
    /// </summary>
    public GXColorSelector()
    {
        Type type = Nullable.GetUnderlyingType(typeof(TItem)) ?? typeof(TItem);
        if (type != typeof(IPAddress) && type != typeof(UInt32) && type != typeof(UInt64) && type != typeof(string))
        {
            throw new InvalidOperationException($"Unsupported {GetType()} type param '{type}'.");
        }
    }

    /// <summary>
    /// Gets or sets the typed color value edited by the selector.
    /// </summary>
    [Parameter]
    public TItem? Value { get; set; }

    /// <summary>
    /// Clears the selected color and requests rendering.
    /// </summary>
    private void Reset()
    {
        UpdateColor(null);
    }

    /// <summary>
    /// Gets or sets the callback invoked when the bound value changes.
    /// </summary>
    [Parameter]
    public EventCallback<TItem?> ValueChanged { get; set; }

    /// <summary>
    /// Formats the current value as text for the rendered input.
    /// </summary>
    private string? ValueToString()
    {
        return Value?.ToString();
    }

    /// <summary>
    /// Gets or sets the hint displayed when the input has no value.
    /// </summary>
    [Parameter]
    public string? Placeholder { get; set; }

    /// <summary>
    /// Converts an edited color value, notifies changes, and saves it when persistence is enabled.
    /// </summary>
    private void UpdateColor(object? value, bool init = false)
    {
        bool change = false;
        if (value is string str &&
        !string.IsNullOrEmpty(str))
        {
            Value = default;
            TItem? result;
            if (!BindConverter.TryConvertTo<TItem>(value, CultureInfo.InvariantCulture, out result))
            {
                throw new Exception("Invalid color.");
            }
            change = Value?.ToString() != result?.ToString();
            Value = result;
            if (change)
            {
                if (ValueChanged.HasDelegate)
                {
                    ValueChanged.InvokeAsync(Value);
                }
            }
        }
        else
        {
            change = Value != null;
            Value = default;
            if (change)
            {
                if (ValueChanged.HasDelegate)
                {
                    ValueChanged.InvokeAsync(Value);
                }
            }
        }
        try
        {
            if (!init && Save && !string.IsNullOrEmpty(Id))
            {
                localStorage.SetValueAsync(string.Empty, Id, ValueToString());
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex.Message);
        }
    }

    /// <summary>
    /// Restores a saved color value after the first render when persistence is enabled.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (firstRender)
        {
            try
            {
                if (Save && !string.IsNullOrEmpty(Id))
                {
                    string? str = await localStorage.GetValueAsync(Id);
                    UpdateColor(str, true);
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex.Message);
            }
        }
    }
}
