@*
<summary>
Loads available authorization policy names and edits a filtered selection of policies.
</summary>
*@
@namespace Gurux.UI.Components
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using System.Net.Http.Json
@using System.Text.Json
@using System.Linq.Expressions
@using Microsoft.AspNetCore.Components.Forms
@implements IDisposable
@inject HttpClient Http
@inject IServiceProvider Services

<label for="@(_instanceId + "-filter")" class="visually-hidden"><GXLocalizedText Value="@Gurux.UI.Components.Properties.Resources.FilterPolicies" /></label>
<input id="@(_instanceId + "-filter")" class="form-control" type="search" placeholder="@Gurux.UI.Components.Properties.Resources.PolicyFilterPlaceholder"
       value="@_filter" @oninput="FilterChanged" disabled="@Disabled" />
@if (_loadFailed)
{
    <button type="button" class="btn btn-outline-secondary mt-2" @onclick="LoadAsync" disabled="@_loading"><GXLocalizedText Value="@Gurux.UI.Components.Properties.Resources.Retry" /></button>
}
<table class="table table-striped">
    <thead>
        <tr>
            <th scope="col">
                <GXLocalizedText Value="@Gurux.UI.Components.Properties.Resources.Name" />
                <div class="form-check form-switch">
                    <input id="@(_instanceId + "-all")" class="form-check-input" type="checkbox"
                           checked="@AllVisibleSelected" disabled="@(Disabled || _invalidValue || VisibleNames.Length == 0)"
                           @onchange="SelectVisibleAsync" />
                    <label class="form-check-label" for="@(_instanceId + "-all")"><GXLocalizedText Value="@Gurux.UI.Components.Properties.Resources.SelectVisible" /></label>
                </div>
            </th>
            <th scope="col"><GXLocalizedText Value="@Gurux.UI.Components.Properties.Resources.Policies" /></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var group in VisibleGroups)
        {
            <tr @key="group.Key">
                <td>@group.Key</td>
                <td>
                    <Gurux.UI.Components.Accordion.GXAccordion Id="@(_instanceId + "-group-" + Convert.ToHexString(System.Text.Encoding.UTF8.GetBytes(group.Key)))">
                        <HeaderTemplate>
                            <span>@string.Join(", ", group.Where(_selected.Contains).Select(ActionName))</span>
                        </HeaderTemplate>
                        <ChildContent>
                            @foreach (var name in group)
                            {
                                var id = _instanceId + "-" + Convert.ToHexString(System.Text.Encoding.UTF8.GetBytes(name));
                                <div class="form-check form-switch mb-2" @key="name">
                                    <input id="@id" class="form-check-input" type="checkbox" checked="@_selected.Contains(name)"
                                           disabled="@(Disabled || _invalidValue)" @onchange="@(e => SelectAsync(name, e))" />
                                    <label class="form-check-label" for="@id">@ActionName(name)</label>
                                    @if (_loaded && !_available.Contains(name))
                                    {
                                        <span class="badge text-bg-secondary ms-2"><GXLocalizedText Value="@Gurux.UI.Components.Properties.Resources.Unavailable" /></span>
                                    }
                                </div>
                            }
                        </ChildContent>
                    </Gurux.UI.Components.Accordion.GXAccordion>
                </td>
            </tr>
        }
        @if (VisibleNames.Length == 0 && !_loading)
        {
            <tr><td colspan="2"><GXLocalizedText Value="@Gurux.UI.Components.Properties.Resources.NoPoliciesFound" /></td></tr>
        }
    </tbody>
</table>

@code {
    /// <summary>
    /// Gets or sets the selected authorization policy names.
    /// </summary>
    [Parameter] public List<string>? Value { get; set; }
    /// <summary>
    /// Gets or sets the callback invoked with the validated, ordered policy selection.
    /// </summary>
    [Parameter] public EventCallback<List<string>?> ValueChanged { get; set; }

    /// <summary>Identifies the bound policy field for form change tracking.</summary>
    [Parameter] public Expression<Func<List<string>?>>? ValueExpression { get; set; }

    /// <summary>Owning form whose modified state is updated after a successful selection change.</summary>
    [CascadingParameter] public EditContext? EditContext { get; set; }

    /// <summary>
    /// Gets or sets whether user interaction with the input is disabled.
    /// </summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Stores the unique component identifier used by form labels and notification keys.</summary>
    private readonly string _instanceId = "policy-editor-" + Guid.NewGuid().ToString("N");
    /// <summary>Cancels outstanding operations when the component is disposed.</summary>
    private readonly CancellationTokenSource _lifetime = new();
    /// <summary>Stores selected authorization policy names using case-insensitive matching.</summary>
    private HashSet<string> _selected = new(StringComparer.OrdinalIgnoreCase);
    /// <summary>Stores the policy names supplied by the policy provider.</summary>
    private HashSet<string> _available = new(StringComparer.OrdinalIgnoreCase);
    /// <summary>Stores the last bound policy selection applied to this component.</summary>
    private string[] _observedValue = [];
    /// <summary>Stores the search text currently used to filter available results.</summary>
    private string _filter = "";
    /// <summary>Records whether the most recent policy loading attempt failed.</summary>
    private bool _loadFailed;
    /// <summary>Records whether the bound selection contains an invalid policy name.</summary>
    private bool _invalidValue;
    /// <summary>Records whether the component has applied its initial parameters.</summary>
    private bool _initialized;
    /// <summary>Records whether the current asynchronous loading operation is still in progress.</summary>
    private bool _loading;
    /// <summary>Records whether available policy names have been loaded successfully.</summary>
    private bool _loaded;
    /// <summary>Records whether the component has stopped accepting updates and released its subscriptions.</summary>
    private bool _disposed;

    /// <summary>
    /// Gets selected and available policy names matching the current filter, ordered by name.
    /// </summary>
    private string[] VisibleNames => _selected.Concat(_available).Distinct(StringComparer.OrdinalIgnoreCase)
        .Where(name => name.Contains(_filter, StringComparison.OrdinalIgnoreCase)).Order(StringComparer.Ordinal).ToArray();
    /// <summary>Groups visible policy names by the resource before the final dot.</summary>
    private IEnumerable<IGrouping<string, string>> VisibleGroups => VisibleNames.GroupBy(GroupName, StringComparer.OrdinalIgnoreCase);

    /// <summary>Gets the resource name, preserving dots within a resource name.</summary>
    private static string GroupName(string name)
    {
        int separator = name.LastIndexOf('.');
        return separator > 0 ? name[..separator] : name;
    }

    /// <summary>Gets the operation after the final dot, or the complete undivided policy name.</summary>
    private static string ActionName(string name)
    {
        int separator = name.LastIndexOf('.');
        return separator >= 0 ? name[(separator + 1)..] : name;
    }

    /// <summary>
    /// Gets whether every currently visible policy is selected and the list is nonempty.
    /// </summary>
    private bool AllVisibleSelected => VisibleNames.Length > 0 && VisibleNames.All(_selected.Contains);

    /// <summary>
    /// Validates and normalizes supplied policy names and synchronizes the current selection.
    /// </summary>
    protected override void OnParametersSet()
    {
        var names = (Value ?? []).Select(name => name?.Trim() ?? "").ToArray();
        if (_initialized && _observedValue.SequenceEqual(names, StringComparer.Ordinal))
        {
            return;
        }
        _initialized = true;
        _observedValue = names.ToArray();
        if (names.Any(name => name.Length is 0 or > 128))
        {
            _invalidValue = true;
            NotificationService?.ReportError(new ArgumentException(Gurux.UI.Components.Properties.Resources.InvalidPolicyName), ValueErrorKey);
            return;
        }
        _selected = names.ToHashSet(StringComparer.OrdinalIgnoreCase);
        _invalidValue = false;
        NotificationService?.RemoveByKey(ValueErrorKey);
    }
    /// <summary>
    /// Loads the available authorization policy names.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) { await LoadAsync(); StateHasChanged(); }
    }

    /// <summary>
    /// Gets the optional service used to report component errors as notifications.
    /// </summary>
    private IGXNotificationService? NotificationService => Services.GetService<IGXNotificationService>();
    /// <summary>
    /// Gets the optional service used to track and cancel asynchronous operations.
    /// </summary>
    private IGXProgress? Progress => Services.GetService<IGXProgress>();
    /// <summary>
    /// Gets the notification key used for policy loading failures.
    /// </summary>
    private string LoadErrorKey => _instanceId + ".Load";
    /// <summary>
    /// Gets the notification key used for invalid selected policy names.
    /// </summary>
    private string ValueErrorKey => _instanceId + ".Value";
    /// <summary>
    /// Gets the notification key used for failures in the value changed callback.
    /// </summary>
    private string CallbackErrorKey => _instanceId + ".ValueChanged";

    /// <summary>
    /// Loads available policy names from the server with progress tracking, cancellation, and error reporting.
    /// </summary>
    private async Task LoadAsync()
    {
        if (_disposed || _loading)
        {
            return;
        }
        _loading = true;
        _loadFailed = false;
        NotificationService?.RemoveByKey(LoadErrorKey);
        using var progress = Progress?.ProgressStart(Gurux.UI.Components.Properties.Resources.LoadingPolicies);
        using var cancellation = progress == null ? null : CancellationTokenSource.CreateLinkedTokenSource(_lifetime.Token, progress.CancellationToken);
        var token = cancellation?.Token ?? _lifetime.Token;
        try
        {
            var provider = Services.GetService<IGXPolicyNameProvider>();
            var names = provider != null
                ? await provider.GetAsync(token)
                : await Http.GetFromJsonAsync<string[]>("api/Policy/Available", token);
            if (_disposed)
            {
                return;
            }
            _available = (names ?? []).Select(name => name?.Trim() ?? "").Where(name => name.Length is > 0 and <= 128).ToHashSet(StringComparer.OrdinalIgnoreCase);
            _loaded = true;
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { _loadFailed = true; }
        catch (Exception ex)
        {
            if (!_disposed)
            {
                _loadFailed = true;
                NotificationService?.ReportError(ex, LoadErrorKey);
            }
        }
        finally { _loading = false; }
    }
    /// <summary>
    /// Updates the policy name filter from the search input.
    /// </summary>
    private void FilterChanged(ChangeEventArgs e) => _filter = e.Value?.ToString() ?? "";

    /// <summary>
    /// Adds or removes one policy from the selection and publishes the resulting value.
    /// </summary>
    private async Task SelectAsync(string name, ChangeEventArgs e)
    {
        if (Disabled || _invalidValue || _disposed)
        {
            return;
        }
        var next = new HashSet<string>(_selected, StringComparer.OrdinalIgnoreCase);
        if (e.Value is true)
        {
            next.Add(name);
        }
        else
        {
            next.Remove(name);
        }
        await PublishAsync(next);
    }

    /// <summary>
    /// Adds or removes all filtered policy names and publishes the resulting value.
    /// </summary>
    private async Task SelectVisibleAsync(ChangeEventArgs e)
    {
        if (Disabled || _invalidValue || _disposed)
        {
            return;
        }
        var next = new HashSet<string>(_selected, StringComparer.OrdinalIgnoreCase);
        foreach (var name in VisibleNames)
        {
            if (e.Value is true)
            {
                next.Add(name);
            }
            else
            {
                next.Remove(name);
            }
        }
        await PublishAsync(next);
    }

    /// <summary>
    /// Validates and publishes the selected policy names, restoring the prior selection when the callback fails.
    /// </summary>
    private async Task PublishAsync(HashSet<string> next)
    {
        var names = next.Order(StringComparer.Ordinal).ToList();
        if (names.Any(name => name.Length is 0 or > 128))
        {
            _invalidValue = true;
            NotificationService?.ReportError(new ArgumentException(Gurux.UI.Components.Properties.Resources.InvalidPolicyName), ValueErrorKey);
            return;
        }
        var previousSelection = _selected;
        var previousValue = _observedValue;
        _selected = new HashSet<string>(next, StringComparer.OrdinalIgnoreCase);
        _observedValue = names.ToArray();
        try
        {
            await ValueChanged.InvokeAsync(names.ToList());
            if (EditContext != null && ValueExpression != null)
            {
                EditContext.NotifyFieldChanged(FieldIdentifier.Create(ValueExpression));
            }
            NotificationService?.RemoveByKey(CallbackErrorKey);
        }
        catch (Exception ex)
        {
            _selected = previousSelection;
            _observedValue = previousValue;
            if (!_disposed)
            {
                NotificationService?.ReportError(ex, CallbackErrorKey);
            }
        }
    }
    /// <summary>
    /// Cancels pending policy loading and clears notifications owned by this editor.
    /// </summary>
    public void Dispose()
    {
        if (_disposed)
        {
            return;
        }
        _disposed = true;
        _lifetime.Cancel();
        _lifetime.Dispose();
        NotificationService?.RemoveByKey(LoadErrorKey);
        NotificationService?.RemoveByKey(ValueErrorKey);
        NotificationService?.RemoveByKey(CallbackErrorKey);
    }
}
