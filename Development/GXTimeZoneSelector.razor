@*
<summary>
Provides a searchable selection of system time zones and binds the chosen zone identifier.
</summary>
*@

@using System
@using System.Linq
@using Microsoft.AspNetCore.Components.Web.Virtualization

<GXDropdownSearch @attributes="GXComponentAttributes.WithoutCss(AdditionalAttributes)" style="@GXComponentAttributes.GetStyle(AdditionalAttributes)" class="@GXComponentAttributes.GetClass(AdditionalAttributes, "form-control")"
                Id="@Id"
                Immediate="true"
                RememberValue="@RememberValue"
                @bind-Value="@selected"
                Formatter="@((TimeZoneInfo? s) => s?.DisplayName)"
                ItemsProvider="@GetItems">
    <Template>
        @if (context != null)
        {
            @context.DisplayName
        }
    </Template>
</GXDropdownSearch>

@code {
    /// <summary>
    /// Gets or sets captured HTML attributes forwarded to the underlying element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// Gets the supplied HTML id or a Guid identifier generated once for this component instance.
    /// </summary>
    private string Id => GXComponentAttributes.GetId(AdditionalAttributes, ref _generatedId);

    private string? _generatedId;

    /// <summary>
    /// Gets or sets whether the most recently used value is restored from and saved to browser local storage.
    /// </summary>
    /// <seealso cref="Id" />
    [Parameter]
    public bool RememberValue { get; set; } = true;

    /// <summary>
    /// Gets or sets the selected time zone and synchronizes its identifier with the bound value.
    /// </summary>
    private TimeZoneInfo? selected
    {
        get
        {
            return TimeZones.Where(t => t.Id == Value).FirstOrDefault();
        }
        set
        {
            Value = value?.Id;
            if (ValueChanged.HasDelegate)
            {
                ValueChanged.InvokeAsync(value?.Id);
            }
        }
    }

    /// <summary>
    /// Gets or sets the selected time zone identifier.
    /// </summary>
    [Parameter]
    public string? Value { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked when the bound value changes.
    /// </summary>
    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>
    /// Gets or sets the placeholder text option.
    /// </summary>
    [Parameter]
    public string? Placeholder { get; set; } = "Select time zone";

    /// <summary>
    /// Gets or sets whether the UTC time zone is placed before other zones.
    /// </summary>
    [Parameter]
    public bool ShowUtcFirst { get; set; } = true;

    /// <summary>
    /// Gets or sets the available system time zones in display order.
    /// </summary>
    private IEnumerable<TimeZoneInfo> TimeZones { get; set; } = Array.Empty<TimeZoneInfo>();

    /// <summary>
    /// Returns time zones matching the request's case-insensitive display-name filter and their count.
    /// </summary>
    private ValueTask<ItemsProviderResult<TimeZoneInfo?>> GetItems(GXItemsProviderRequest request)
    {
        var list = TimeZones;
        if (!string.IsNullOrEmpty(request.Filter))
        {
            list = list.Where(s => s.DisplayName.Contains(request.Filter, StringComparison.OrdinalIgnoreCase));
        }
        return new(new ItemsProviderResult<TimeZoneInfo?>(list, list.Count()));
    }

    /// <summary>
    /// Builds the system time zone list, optionally placing UTC first and removing duplicate identifiers.
    /// </summary>
    protected override void OnInitialized()
    {
        var all = TimeZoneInfo.GetSystemTimeZones().ToList();
        if (ShowUtcFirst)
        {
            var utc = all.FirstOrDefault(t => t.Id == "UTC" || t.StandardName.Contains("UTC", StringComparison.OrdinalIgnoreCase));
            if (utc != null)
            {
                all.Remove(utc);
                all.Insert(0, utc);
            }
        }
        // Order by DisplayNamen.
        TimeZones = all
            .DistinctBy(t => t.Id)
            .ToList();
    }

    /// <summary>
    /// Updates the selected time zone id and invokes the bound value callback.
    /// </summary>
    private async Task OnChange(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        Value = value;
        await ValueChanged.InvokeAsync(value);
    }
}
