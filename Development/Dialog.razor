@using Microsoft.AspNetCore.Components.Web
@inject IGXLocalStorage LocalStorage
@inject Microsoft.JSInterop.IJSRuntime JS
@inject IServiceProvider Services
@using Microsoft.JSInterop
@implements IAsyncDisposable

<div class="modal fade show d-block" @attributes="AdditionalAttributes" id="@(Id ?? _elementId)" tabindex="-1" role="dialog" @onkeydown="OnKeyDown"
     @onpointermove="OnPointerMove" @onpointerup="OnPointerUp" style="left:@LeftPx; top:@TopPx;">
    <div @ref="_dialog" class="modal-dialog @(Resizable ? "dialog-resizable" : null)" role="document">
        <div class="modal-content">
            <div class="modal-header" @onpointerdown="OnPointerDown">
                <h5 class="modal-title" id="confirmanceModalLabel">@Title</h5>
                @if (HeaderContent is not null)
                {
                    <div class="dialog-header-actions" @onpointerdown:stopPropagation="true">
                        @HeaderContent
                    </div>
                }
                <button type="button" class="btn btn-close"
                        data-dismiss="modal" aria-label="Close"
                        onclick="@(() => Cancel())">
                </button>
            </div>
            <div class="modal-body">
                @ChildContent
            </div>
            <div class="modal-footer">
                @if (!string.IsNullOrEmpty(OkButtonTitle))
                {
                    <button type="button" class="btn btn-primary"
                            data-dismiss="modal" onclick="@(() => Ok())">
                        @OkButtonTitle
                    </button>
                }
                @if (!string.IsNullOrEmpty(CancelButtonTitle))
                {
                    <button type="button" class="btn btn-secondary"
                            data-dismiss="modal" onclick="@(() => Cancel())">
                        @CancelButtonTitle
                    </button>
                }
            </div>
        </div>
    </div>
</div>

@code
{
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Optional actions displayed at the right of the dialog title.</summary>
    [Parameter] public RenderFragment? HeaderContent { get; set; }

    /// <summary>
    /// Can the dialog be resized by dragging its bottom-right corner.
    /// If false, user can only move the dialog by dragging the header.
    /// </summary>
    [Parameter]
    public bool Resizable { get; set; }

    /// <summary>
    /// Whether to store the value in a local storage.
    /// </summary>
    /// <seealso cref="Id"/>
    [Parameter]
    public bool Save { get; set; } = true;

    /// <summary>
    /// Additional attributes that will be applied to the underlying HTML element. If you specify an attribute with the same name as a component parameter, the component parameter value will take precedence.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>Stable identifier used for the element and its saved layout.</summary>
    [Parameter] public string? Id { get; set; }

    /// <summary>
    /// User has accept the action.
    /// </summary>
    [Parameter]
    public EventCallback OnOk { get; set; }

    /// <summary>
    /// User has Cancel the action.
    /// </summary>
    [Parameter]
    public EventCallback OnCancel { get; set; }

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public string OkButtonTitle { get; set; } = "Save";

    [Parameter]
    public string CancelButtonTitle { get; set; } = "Cancel";

    // Dragging state
    private bool _dragging;
    private double _startX, _startY;
    private double _offsetX = 80, _offsetY = 80; // current top-left (px)
    private string LeftPx => _offsetX.ToString("0") + "px";
    private string TopPx => _offsetY.ToString("0") + "px";

    private readonly string _elementId = "dialog-" + Guid.NewGuid().ToString("N");
    private ElementReference _dialog;
    private IJSObjectReference? _module;
    private DotNetObjectReference<Dialog>? _reference;
    private string? _loadedKey;
    private bool _ready, _disposed;
    private double _width, _height;
    private string? StorageKey => Save && !string.IsNullOrWhiteSpace(Id)
        ? "Dialog:" + Uri.EscapeDataString(Id) + ":Layout" : null;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        string? key = StorageKey;
        if (_disposed || key == _loadedKey) return;
        _ready = false;
        _loadedKey = key;
        try
        {
            if (_module != null) await _module.InvokeVoidAsync("disconnect", _dialog);
            if (key == null) return;
            double[]? layout = null;
            string? json = await LocalStorage.GetValueAsync(key);
            if (!string.IsNullOrWhiteSpace(json))
            {
                try { layout = System.Text.Json.JsonSerializer.Deserialize<double[]>(json); }
                catch (System.Text.Json.JsonException) { }
            }
            if (_disposed || StorageKey != key) return;
            if (layout is not { Length: 4 } || layout.Any(value => !double.IsFinite(value)) ||
                layout[2] <= 0 || layout[3] <= 0) layout = null;
            if (layout != null)
            {
                _offsetX = layout[0];
                _offsetY = layout[1];
            }
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Gurux.UI.Components/Dialog.razor.js");
            if (_disposed) return;
            _reference ??= DotNetObjectReference.Create(this);
            var size = await _module.InvokeAsync<double[]>("observe", _dialog, _reference, key,
                layout == null ? 0 : layout[2], layout == null ? 0 : layout[3]);
            _width = size[0];
            _height = size[1];
            _ready = true;
            StateHasChanged();
        }
        catch (JSDisconnectedException) { }
        catch (Exception ex) { ReportStorageError(ex); }
    }

    [JSInvokable]
    public async Task SizeChanged(string key, double width, double height)
    {
        if (_disposed || !_ready || key != StorageKey || !double.IsFinite(width) ||
            !double.IsFinite(height) || width <= 0 || height <= 0) return;
        _width = width;
        _height = height;
        await SaveLayoutAsync();
    }

    private async Task SaveLayoutAsync()
    {
        string? key = StorageKey;
        if (_disposed || !_ready || key == null || key != _loadedKey) return;
        try
        {
            if (_module != null)
            {
                var size = await _module.InvokeAsync<double[]>("measure", _dialog);
                _width = size[0];
                _height = size[1];
            }
            await LocalStorage.SetValueAsync(key, System.Text.Json.JsonSerializer.Serialize(
                new[] { _offsetX, _offsetY, _width, _height }));
        }
        catch (JSDisconnectedException) { }
        catch (Exception ex) { ReportStorageError(ex); }
    }

    private void ReportStorageError(Exception exception)
    {
        if (Services.GetService(typeof(IGXNotificationService)) is IGXNotificationService notifications)
        {
            string key = _elementId + ":storage";
            notifications.RemoveByKey(key);
            notifications.ReportError(exception, key);
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try
        {
            if (_module != null)
            {
                await _module.InvokeVoidAsync("disconnect", _dialog);
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException) { }
        finally { _reference?.Dispose(); }
    }

    private void OnPointerDown(PointerEventArgs e)
    {
        _dragging = true;
        _startX = e.ClientX - _offsetX;
        _startY = e.ClientY - _offsetY;
    }

    private void OnPointerMove(PointerEventArgs e)
    {
        if (!_dragging)
        {
            return;
        }
        _offsetX = e.ClientX - _startX;
        _offsetY = e.ClientY - _startY;
        StateHasChanged();
    }

    private async Task OnPointerUp(PointerEventArgs e)
    {
        _dragging = false;
        await SaveLayoutAsync();
    }

    /// <summary>
    /// User has accept the action.
    /// </summary>
    private async Task Ok()
    {
        _dragging = false;
        await SaveLayoutAsync();
        await OnOk.InvokeAsync(true);
    }

    /// <summary>
    /// User has Cancel the action.
    /// </summary>
    private async Task Cancel()
    {
        _dragging = false;
        await SaveLayoutAsync();
        await OnCancel.InvokeAsync(false);
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await Cancel();
        }
    }
}
