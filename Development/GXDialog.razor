@*
<summary>
Displays a movable, optionally resizable dialog and can persist its position and size.
</summary>
*@

@using Microsoft.AspNetCore.Components.Web
@inject IServiceProvider Services
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inherits GXAdaptiveComponentBase

<div @attributes="GXComponentAttributes.WithoutCss(AdditionalAttributes)" class="@GXComponentAttributes.GetClass(AdditionalAttributes, DialogClass)" id="@ElementId" tabindex="-1" role="dialog" aria-modal="@(IsAdaptive ? "true" : null)" aria-labelledby="@(IsAdaptive ? ElementId + "-title" : null)" @onclick="OnBackdropClick" @onkeydown="OnKeyDown" @onkeydown:stopPropagation="true"
     @onpointermove="OnPointerMove" @onpointerup="OnPointerUp" style="@GXComponentAttributes.GetStyle(AdditionalAttributes, $"left:{LeftPx}; top:{TopPx};")">
    <div @ref="_dialog" class="modal-dialog @(Resizable ? "dialog-resizable" : null)" style="@AdaptivePosition" role="document" @onclick:stopPropagation="CloseOnBackdrop">
        <div class="modal-content">
            <div class="modal-header" @onpointerdown="OnPointerDown">
                <h5 class="modal-title" id="@(ElementId + "-title")">@Title</h5>
                @if (HeaderContent is not null)
                {
                    <div class="dialog-header-actions" @onpointerdown:stopPropagation="true">
                        @HeaderContent
                    </div>
                }
                <button type="button" class="btn-close"
                        data-dismiss="modal" aria-label="Close"
                        onclick="@(() => Cancel())">
                </button>
            </div>
            <div class="modal-body">
                @ChildContent
            </div>
            <div class="modal-footer">
                @FooterContent
                @if (EffectiveButtonOrder == GXDialogButtonOrder.PrimaryLast)
                {
                    @CancelAction
                    @PrimaryAction
                }
                else
                {
                    @PrimaryAction
                    @CancelAction
                }
            </div>
        </div>
    </div>
</div>

@code
{
    [Parameter] public GXDialogButtonOrder ButtonOrder { get; set; } = GXDialogButtonOrder.Auto;
    [Parameter] public GXDialogPresentation Presentation { get; set; } = GXDialogPresentation.Auto;
    [Parameter] public bool CloseOnEscape { get; set; } = true;
    [Parameter] public bool CloseOnBackdrop { get; set; }
    /// <summary>Default is off: native button Enter handling is retained; forms may opt into a default action.</summary>
    [Parameter] public bool ActivatePrimaryOnEnter { get; set; }
    private GXDialogButtonOrder EffectiveButtonOrder => ButtonOrder == GXDialogButtonOrder.Auto ? AdaptiveBehavior.DialogButtonOrder : ButtonOrder;
    private string DialogClass => AdaptiveClass("modal fade show d-block") + (IsAdaptive ? " gx-dialog-adaptive" : "") + (Presentation == GXDialogPresentation.BottomSheet ? " gx-dialog-sheet" : "");
    private bool EffectiveManageFocus => ManageFocus || IsAdaptive || ActivatePrimaryOnEnter;
    private bool _positioned;
    private string? AdaptivePosition => IsAdaptive && _positioned ? FormattableString.Invariant($"transform:translate({_offsetX}px,{_offsetY}px)") : null;
    private RenderFragment PrimaryAction => @<text>
        @if (!string.IsNullOrEmpty(OkButtonTitle))
        {
            <button type="button" class="btn btn-primary" data-dismiss="modal" onclick="@(() => Ok())">@OkButtonTitle</button>
        }
    </text>;
    private RenderFragment CancelAction => @<text>
        @if (!string.IsNullOrEmpty(CancelButtonTitle))
        {
            <button type="button" class="btn btn-secondary" data-dismiss="modal" onclick="@(() => Cancel())">@CancelButtonTitle</button>
        }
    </text>;

    protected override void OnParametersSet()
    {
        if (!Enum.IsDefined(ButtonOrder) || !Enum.IsDefined(Presentation))
        {
            throw new ArgumentOutOfRangeException(nameof(ButtonOrder));
        }
    }

    [JSInvokable]
    public Task AcceptFromKeyboard() => !_disposed && ActivatePrimaryOnEnter && !string.IsNullOrEmpty(OkButtonTitle) ? Ok() : Task.CompletedTask;

    private Task OnBackdropClick() => CloseOnBackdrop ? Cancel() : Task.CompletedTask;

    /// <summary>
    /// Gets or sets the content rendered inside the component.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Gets or sets optional content rendered alongside the dialog title.
    /// </summary>
    [Parameter] public RenderFragment? HeaderContent { get; set; }

    /// <summary>Gets or sets additional actions rendered before the standard dialog buttons.</summary>
    [Parameter] public RenderFragment? FooterContent { get; set; }

    /// <summary>
    /// Gets or sets whether the dialog can be resized by dragging its bottom-right corner.
    /// </summary>
    [Parameter]
    public bool Resizable { get; set; }

    /// <summary>Moves focus into the dialog, traps Tab navigation, and restores focus when it closes.</summary>
    [Parameter]
    public bool ManageFocus { get; set; }

    private IGXLocalStorage? LocalStorage => Services.GetService(typeof(IGXLocalStorage)) as IGXLocalStorage;
    private IJSRuntime? JS => Services.GetService(typeof(IJSRuntime)) as IJSRuntime;
    private string? _focusKey;

    /// <summary>
    /// Gets or sets whether the dialog's position and size are restored from and saved to browser local storage.
    /// </summary>
    /// <seealso cref="Id" />
    [Parameter]
    public bool Save { get; set; } = true;

    /// <summary>
    /// Gets or sets captured HTML attributes forwarded to the underlying element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// Gets or sets the preferred dialog id used for its element and saved layout; captured attributes or a generated Guid provide the fallback.
    /// </summary>
    [Parameter] public string? Id { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked when the dialog is accepted.
    /// </summary>
    [Parameter]
    public EventCallback OnOk { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked when the user requests cancellation.
    /// </summary>
    [Parameter]
    public EventCallback OnCancel { get; set; }

    /// <summary>
    /// Gets or sets the title displayed by the component.
    /// </summary>
    [Parameter]
    public string? Title { get; set; }

    /// <summary>
    /// Gets or sets the accept button label; an empty label hides the button.
    /// </summary>
    [Parameter]
    public string OkButtonTitle { get; set; } = "Save";

    /// <summary>
    /// Gets or sets the cancel button label; an empty label hides the button.
    /// </summary>
    [Parameter]
    public string CancelButtonTitle { get; set; } = "Cancel";

    // Dragging state
    private bool _dragging;
    private double _startX, _startY;
    private double _offsetX = 80, _offsetY = 80; // current top-left (px)
    /// <summary>
    /// Gets the dialog's horizontal position formatted as a CSS pixel value.
    /// </summary>
    private string LeftPx => IsAdaptive ? "0px" : _offsetX.ToString("0") + "px";
    /// <summary>
    /// Gets the dialog's vertical position formatted as a CSS pixel value.
    /// </summary>
    private string TopPx => IsAdaptive ? "0px" : _offsetY.ToString("0") + "px";

    private string? _generatedId;
    /// <summary>
    /// Gets the effective dialog id, preferring the explicit parameter over captured attributes and a generated Guid.
    /// </summary>
    private string ElementId => !string.IsNullOrWhiteSpace(Id)
        ? Id : GXComponentAttributes.GetId(AdditionalAttributes, ref _generatedId);
    private ElementReference _dialog;
    private IJSObjectReference? _module;
    private DotNetObjectReference<GXDialog>? _reference;
    private string? _loadedKey;
    private bool _ready, _disposed;
    private double _width, _height;
    /// <summary>
    /// Gets the local storage key for the dialog layout, or null when layout persistence is disabled.
    /// </summary>
    private string? StorageKey => Save && LocalStorage != null && JS != null
        ? "Dialog:" + Uri.EscapeDataString(ElementId) + ":Layout" + (IsAdaptive ? ":" + AdaptiveBehavior.Layout : "") : null;

    /// <summary>
    /// Restores the layout for a changed storage key and connects browser size observation when persistence is enabled.
    /// </summary>
    private bool _synchronizing;
    private bool _renderAgain;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed)
        {
            return;
        }
        if (_synchronizing)
        {
            _renderAgain = true;
            return;
        }
        _synchronizing = true;
        try
        {
            await SynchronizeBrowserAsync(firstRender);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or OperationCanceledException)
        {
            if (!_disposed)
            {
                ReportStorageError(ex);
            }
        }
        finally
        {
            _synchronizing = false;
            if (_renderAgain && !_disposed)
            {
                _renderAgain = false;
                StateHasChanged();
            }
        }
    }
    private async Task SynchronizeBrowserAsync(bool firstRender)
    {
        if (EffectiveManageFocus && _focusKey == null && JS is IJSRuntime runtime)
        {
            try
            {
                _module ??= await GetComponentModuleAsync(runtime, "./_content/Gurux.UI.Components/GXDialog.razor.js");
                if (_disposed || _module == null)
                {
                    return;
                }
                _focusKey = Guid.NewGuid().ToString("N");
                _reference ??= DotNetObjectReference.Create(this);
                await _module.InvokeVoidAsync("openDialog", _dialog, _focusKey, _reference, new { activatePrimaryOnEnter = ActivatePrimaryOnEnter });
            }
            catch (JSDisconnectedException) { }
            catch (Exception ex) { ReportStorageError(ex); }
        }
        if (_disposed)
        {
            return;
        }
        if (_module != null && _focusKey != null)
        {
            if (EffectiveManageFocus)
            {
                await _module.InvokeVoidAsync("updateDialog", _focusKey, new { activatePrimaryOnEnter = ActivatePrimaryOnEnter });
            }
            else
            {
                await _module.InvokeVoidAsync("closeDialog", _focusKey);
                _focusKey = null;
            }
        }
        string? key = StorageKey;
        if (_disposed || key == _loadedKey)
        {
            return;
        }
        _ready = false;
        _loadedKey = key;
        try
        {
            if (_module != null)
            {
                await _module.InvokeVoidAsync("disconnect", _dialog);
            }
            var storage = LocalStorage;
            var js = JS;
            if (key == null || storage == null || js == null)
            {
                return;
            }
            double[]? layout = null;
            string? json = await storage.GetValueAsync(key);
            if (!string.IsNullOrWhiteSpace(json))
            {
                try { layout = System.Text.Json.JsonSerializer.Deserialize<double[]>(json); }
                catch (System.Text.Json.JsonException) { }
            }
            if (_disposed || StorageKey != key)
            {
                return;
            }
            if (layout is not { Length: 4 } || layout.Any(value => !double.IsFinite(value)) || layout[2] <= 0 || layout[3] <= 0)
            {
                layout = null;
            }
            if (layout != null)
            {
                _positioned = IsAdaptive;
                _offsetX = layout[0];
                _offsetY = layout[1];
            }
            else
            {
                _positioned = false;
                _offsetX = 80;
                _offsetY = 80;
            }
            _module ??= await GetComponentModuleAsync(js, "./_content/Gurux.UI.Components/GXDialog.razor.js");
            if (_disposed || _module == null)
            {
                return;
            }
            _reference ??= DotNetObjectReference.Create(this);
            var size = await _module.InvokeAsync<double[]>("observe", _dialog, _reference, key,
                layout == null ? 0 : layout[2], layout == null ? 0 : layout[3]);
            _width = size[0];
            _height = size[1];
            _ready = true;
            StateHasChanged();
        }
        catch (JSDisconnectedException) { }
        catch (Exception ex) { ReportStorageError(ex); }
    }

    /// <summary>
    /// Accepts a valid browser size notification for the active layout key and persists the dialog layout.
    /// </summary>
    [JSInvokable]
    public async Task SizeChanged(string key, double width, double height)
    {
        if (_disposed || !_ready || key != StorageKey || !double.IsFinite(width) || !double.IsFinite(height) || width <= 0 || height <= 0)
        {
            return;
        }
        _width = width;
        _height = height;
        await SaveLayoutAsync();
    }

    /// <summary>
    /// Measures the dialog and saves its current position and size when layout tracking is ready.
    /// </summary>
    private async Task SaveLayoutAsync()
    {
        string? key = StorageKey;
        var storage = LocalStorage;
        if (_disposed || !_ready || key == null || key != _loadedKey || storage == null)
        {
            return;
        }
        try
        {
            if (_module != null)
            {
                var size = await _module.InvokeAsync<double[]>("measure", _dialog);
                _width = size[0];
                _height = size[1];
            }
            await storage.SetValueAsync(key, System.Text.Json.JsonSerializer.Serialize(
                new[] { _offsetX, _offsetY, _width, _height }));
        }
        catch (JSDisconnectedException) { }
        catch (Exception ex) { ReportStorageError(ex); }
    }

    /// <summary>
    /// Replaces the dialog's storage error notification with the specified exception.
    /// </summary>
    private void ReportStorageError(Exception exception)
    {
        if (Services.GetService(typeof(IGXNotificationService)) is IGXNotificationService notifications)
        {
            string key = ElementId + ":storage";
            notifications.RemoveByKey(key);
            notifications.ReportError(exception, key);
        }
    }

    /// <summary>
    /// Disconnects layout observation and releases the JavaScript module and .NET callback reference.
    /// </summary>
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        DisposeAdaptiveBehavior();
        try
        {
            if (_module != null)
            {
                if (_focusKey != null)
                {
                    await _module.InvokeVoidAsync("closeDialog", _focusKey);
                }
                await _module.InvokeVoidAsync("disconnect", _dialog);
                await ReleaseComponentModulesAsync();
            }
        }
        catch (JSDisconnectedException) { }
        finally { _reference?.Dispose(); await ReleaseComponentModulesAsync(); }
    }

    /// <summary>
    /// Starts dragging the dialog and records the pointer offset from its current position.
    /// </summary>
    private void OnPointerDown(PointerEventArgs e)
    {
        if (IsAdaptive && (e.Button != 0 || Presentation == GXDialogPresentation.BottomSheet || AdaptiveBehavior.ResponsiveMode == GXResponsiveLayoutMode.Compact || e.PointerType == "touch"))
        {
            return;
        }
        if (IsAdaptive && !_positioned)
        {
            _offsetX = 0;
            _offsetY = 0;
        }
        _positioned = true;
        _dragging = true;
        _startX = e.ClientX - _offsetX;
        _startY = e.ClientY - _offsetY;
    }

    /// <summary>
    /// Updates the dialog position while a drag operation is active.
    /// </summary>
    private void OnPointerMove(PointerEventArgs e)
    {
        if (!_dragging)
        {
            return;
        }
        _offsetX = e.ClientX - _startX;
        _offsetY = e.ClientY - _startY;
        StateHasChanged();
    }

    /// <summary>
    /// Ends dragging and saves the final dialog layout.
    /// </summary>
    private async Task OnPointerUp(PointerEventArgs e)
    {
        _dragging = false;
        await SaveLayoutAsync();
    }

    /// <summary>
    /// Invokes the dialog's accept callback.
    /// </summary>
    private async Task Ok()
    {
        _dragging = false;
        await SaveLayoutAsync();
        await OnOk.InvokeAsync(true);
    }

    /// <summary>
    /// Invokes the dialog's cancel callback.
    /// </summary>
    private async Task Cancel()
    {
        _dragging = false;
        await SaveLayoutAsync();
        await OnCancel.InvokeAsync(false);
    }

    /// <summary>
    /// Invokes the cancel callback when Escape is pressed.
    /// </summary>
    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && CloseOnEscape)
        {
            await Cancel();
        }

    }
}
