@*
<summary>
Renders child content and periodically refreshes it using a timer.
</summary>
*@

@implements IDisposable

<div>
    @ChildContent
</div>

@code {
    /// <summary>
    /// Gets or sets the content rendered inside the component.
    /// </summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }


    /// <summary>
    /// Gets or sets the automatic refresh interval in milliseconds.
    /// </summary>
    [Parameter] public int Interval { get; set; } = 1000;

    private System.Timers.Timer? _timer;

    /// <summary>
    /// Starts a repeating timer that requests rendering at the configured interval.
    /// </summary>
    protected override void OnInitialized()
    {
        _timer = new System.Timers.Timer(Interval);
        _timer.Elapsed += async (_, __) =>
        {
            await InvokeAsync(StateHasChanged);
        };
        _timer.AutoReset = true;
        _timer.Enabled = true;
    }

    /// <summary>
    /// Stops and disposes the component's automatic refresh timer.
    /// </summary>
    public void Dispose()
    {
        _timer?.Stop();
        _timer?.Dispose();
    }
}
