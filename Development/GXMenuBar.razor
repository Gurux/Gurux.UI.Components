@*
<summary>
Displays shared commands and dropdowns and updates their enabled state from progress and form changes.
</summary>
*@

@using Gurux.UI.Components.Enums
@using Microsoft.AspNetCore.Components.Routing

@inject NavigationManager NavigationManager
@inject IGXMenuService Menu
@inject IGXProgress Progress
@implements IDisposable

<div class="btn-group" role="group">
    @foreach (GXMenuItem it in Menu.GetItems(Location, Kind, MenuId))
    {
        @if (it.IsSeparator)
        {
            <hr role="separator" />
        }
        else if (it.Children.Count != 0)
        {
            <MenuControl @key="it" Dropdown="true" Text="@it.Text" Icon="@it.Icon"
                         ReadOnly="@IsDisabled(it)" MenuItems="@GetDropdownItems(it)" />
        }
        else
        {
            <button @key="it" type="button" class="nav-link btn btn-link" @onclick="() => InvokeCommandAsync(it)"
                    disabled="@IsDisabled(it)">
                @if (it.Icon != null)
                {
                    <Image Id="@it.Icon"></Image>
                }
                &nbsp;
                <LocalizedText Value="@it.Text" />
            </button>
        }
    }
</div>
@ChildContent
@code {
    /// <summary>Optional GXMenu.Id identifying a menu within the same location and kind.</summary>
    [Parameter] public Guid? MenuId { get; set; }
    /// <summary>Menu region rendered by this toolbar.</summary>
    [Parameter] public MenuLocation Location { get; set; } = MenuLocation.Top;
    /// <summary>Menu role rendered by this toolbar.</summary>
    [Parameter] public MenuKind Kind { get; set; } = MenuKind.MenuBar;

    /// <summary>
    /// Gets or sets the content rendered inside the component.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private bool _disposed;
    private IDisposable? _navigationRegistration;
    private CancellationTokenRegistration _navigationCancellation;

    private List<MenuItem> GetDropdownItems(GXMenuItem parent)
        => parent.Children.Select(child => MenuItem.Create(child.Icon ?? string.Empty, child.Text,
            EventCallback.Factory.Create(this, () => InvokeCommandAsync(child)), IsDisabled(child),
            child.Children.Count == 0 ? null : GetDropdownItems(child), child.IsSeparator)).ToList();

    private Task InvokeCommandAsync(GXMenuItem item)
        => IsDisabled(item) ? Task.CompletedTask : item.OnClick.InvokeAsync();

    /// <summary>
    /// Disables commands during progress operations or when their required form edit state is not satisfied.
    /// </summary>
    private bool IsDisabled(GXMenuItem item)
    {
        if (Progress.IsBusy)
        {
            return true;
        }
        var enabled = item.Enabled == EnableStyle.Always ||
            item.Enabled == EnableStyle.Modified && Menu.GetEditContext(Location, Kind, MenuId)?.IsModified() == true ||
            item.Enabled == EnableStyle.Unmodified && Menu.GetEditContext(Location, Kind, MenuId)?.IsModified() == false;
        return !enabled;
    }

    /// <summary>
    /// Subscribes to menu, progress, and navigation changes that affect displayed commands.
    /// </summary>
    protected override void OnInitialized()
    {
        Menu.Changed += OnChanged;
        Progress.Changed += OnChanged;
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    /// <summary>Registers the navigation guard when this component becomes interactive.</summary>
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _navigationRegistration = NavigationManager.RegisterLocationChangingHandler(OnLocationChanging);
        }
    }

    private ValueTask OnLocationChanging(LocationChangingContext context)
    {
        _navigationCancellation.Dispose();
        _navigationCancellation = default;
        if (_disposed || context.CancellationToken.IsCancellationRequested)
        {
            return ValueTask.CompletedTask;
        }
        var sourceLocation = NavigationManager.Uri;
        var restore = Menu.ClearForNavigation(Location, Kind, MenuId);
        _navigationCancellation = context.CancellationToken.Register(() =>
        {
            if (!_disposed)
            {
                _ = InvokeAsync(() =>
                {
                    if (!_disposed && NavigationManager.Uri == sourceLocation)
                    {
                        restore();
                    }
                });
            }
        });
        return ValueTask.CompletedTask;
    }

    /// <summary>
    /// Releases cancellation handling after successful navigation, leaving destination commands intact.
    /// </summary>
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _navigationCancellation.Dispose();
        _navigationCancellation = default;
    }

    /// <summary>
    /// Schedules a component render when the backing service changes, unless the component is disposed.
    /// </summary>
    private void OnChanged()
    {
        if (_disposed)
        {
            return;
        }
        _ = InvokeAsync(() =>
        {
            if (!_disposed)
            {
                StateHasChanged();
            }
        });
    }

    /// <summary>
    /// Detaches menu, progress, and navigation change handlers.
    /// </summary>
    public void Dispose()
    {
        _disposed = true;
        _navigationRegistration?.Dispose();
        _navigationCancellation.Dispose();
        _navigationCancellation = default;
        Menu.Changed -= OnChanged;
        Progress.Changed -= OnChanged;
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
