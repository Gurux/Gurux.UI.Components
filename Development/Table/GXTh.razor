@*
<summary>
Renders a responsive table header and coordinates sorting through the parent table.
</summary>
*@

@using Gurux.UI.Components.Enums
@using System.Linq.Expressions
@inherits ComponentBase
@implements IDisposable

@typeparam TItem

@if (!_hidden)
{
    <th id="@GetId()" data-gx-column="@(Id ?? Name)" style="@(GXComponentAttributes.CombineStyles(GXComponentAttributes.GetStyle(AdditionalAttributes),
        Parent?.GetColumnWidth(Id ?? Name) is string width ? $"width:{width};min-width:{width};max-width:{width}" : null))" class="@GXComponentAttributes.GetClass(AdditionalAttributes, GXFh.GetCssClass(Parent?.GetColumnVisibility(Id ?? Name, Visibility) ?? Visibility, "sort-th"))" @attributes="GXComponentAttributes.WithoutCss(AdditionalAttributes)"
        onclick="@(() => SortTable())">
        @ChildContent
        <span class="@(GetSortIcon())"></span>
    </th>
}

@code
{
    /// <summary>
    /// Builds the header id from the parent table id and the explicit column id or name with a lowercase initial.
    /// </summary>
    private string? GetId()
    {
        string? value = null;
        if (Parent != null)
        {
            if (!string.IsNullOrEmpty(Parent.Id))
            {
                value = Parent.Id + "-";
            }
        }
        if (!string.IsNullOrEmpty(Id))
        {
            value += Id;
        }
        else if (!string.IsNullOrEmpty(Name))
        {
            value += Name[0].ToString().ToLower() + Name.Substring(1);
        }
        else
        {
            value = null;
        }
        return value;
    }

    /// <summary>
    /// Gets or sets the containing component supplied through a cascading parameter.
    /// </summary>
    [CascadingParameter]
    private IGXTable? Parent { get; set; }

    /// <summary>
    /// Gets or sets the content rendered inside the component.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Gets or sets the direction used to sort the table.
    /// </summary>
    [Parameter]
    public SortMode SortMode { get; set; } = SortMode.None;

    /// <summary>
    /// Gets or sets the column identifier used for serialization and the rendered header id.
    /// </summary>
    [Parameter]
    public string? Id { get; set; }

    /// <summary>
    /// Gets or sets the property path used to filter and sort the column.
    /// </summary>
    [Parameter]
    public string? Name { get; set; }

    /// <summary>
    /// Gets or sets the item associated with the column header.
    /// </summary>
    [Parameter]
    public TItem? Target { get; set; }

    /// <summary>
    /// Gets or sets the expression identifying the item property used to sort this column.
    /// </summary>
    [Parameter]
    public Expression<Func<TItem, object>>? Sort { get; set; }

    /// <summary>
    /// Gets or sets the responsive breakpoints and print settings at which the cell is displayed.
    /// </summary>
    [Parameter]
    public Visibility Visibility { get; set; } = Visibility.All;

    /// <summary>
    /// Is hidden.
    /// </summary>
    bool _hidden => Parent?.IsHidden(Id ?? Name) == true;

    /// <summary>
    /// Gets or sets captured HTML attributes forwarded to the underlying element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string? _registeredName;

    protected override void OnParametersSet()
    {
        string? name = Id ?? Name;
        if (_registeredName != name && _registeredName != null)
        {
            Parent?.UnregisterColumn(_registeredName);
        }
        _registeredName = string.IsNullOrWhiteSpace(name) ? null : name;
        if (_registeredName != null)
        {
            Parent?.RegisterColumn(_registeredName, ChildContent, Visibility);
        }
    }

    public void Dispose()
    {
        if (_registeredName != null)
        {
            Parent?.UnregisterColumn(_registeredName);
        }
    }

    /// <summary>
    /// Verifies that a parent table exists and initializes the column identifier, sorting, and visibility.
    /// </summary>
    protected override void OnInitialized()
    {
        if (Parent == null)
        {
            throw new ArgumentNullException(nameof(Parent), "Th must exist within a GXTable");
        }
        if (SortMode != SortMode.None && string.IsNullOrEmpty(Parent.OrderBy))
        {
            Parent.SortMode = SortMode;
            Parent.OrderBy = Sort != null ? GetPath(Sort) : Name;
        }
        base.OnInitialized();
    }

    /// <summary>
    /// Updates the parent table's sort column and toggles the sort direction.
    /// </summary>
    public virtual async Task SortTable()
    {
        if (Parent != null)
        {
            string? orderBy = Sort != null ? GetPath(Sort) : Name;
            if (string.IsNullOrEmpty(orderBy))
            {
                return;
            }
            if (orderBy != Parent.OrderBy)
            {
                Parent.OrderBy = orderBy;
                Parent.SortMode = SortMode.Ascending;
            }
            else
            {
                Parent.SortMode = (SortMode)(((int)++Parent.SortMode) % 3);
            }
            await Parent.NotificationShortChange();
        }
    }

    /// <summary>
    /// Extracts a dotted property path from the column's member access expression.
    /// </summary>
    public static string GetPath(Expression<Func<TItem, object>> expr)
    {
        Expression? body = expr.Body;
        if (body is UnaryExpression unary && unary.NodeType == ExpressionType.Convert)
        {
            body = unary.Operand;
        }

        var parts = new Stack<string>();

        while (body != null)
        {
            switch (body)
            {
                case MemberExpression member:
                    parts.Push(member.Member.Name);
                    body = member.Expression!;
                    break;

                case ParameterExpression param:
                    if (!string.IsNullOrEmpty(param.Name))
                    {
                        parts.Push(param.Name);
                    }
                    body = null;
                    break;

                default:
                    body = null;
                    break;
            }
        }
        //Remove the first item.
        parts.Pop();
        return string.Join(".", parts);
    }

    /// <summary>
    /// Returns the ascending or descending sort icon classes when this is the active sort column.
    /// </summary>
    public string GetSortIcon()
    {
        if (Parent != null && Parent.OrderBy == (Sort != null ? GetPath(Sort) : Name))
        {
            switch (Parent.SortMode)
            {
                case SortMode.Ascending:
                    return "icon-sort icon-sort-asc";
                case SortMode.Descending:
                    return "icon-sort icon-sort-desc";
            }
        }
        return "";
    }

}
