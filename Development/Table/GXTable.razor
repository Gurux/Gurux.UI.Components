@*
<summary>
Displays typed rows with paging, sorting, selection, filtering, and optional row reordering.
</summary>
*@

@using Gurux.UI.Components.ContextMenu
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Web.Virtualization
@using System.Reflection
@using Gurux.UI.Components.Enums
@using Microsoft.Extensions.Logging
@using Microsoft.JSInterop

@typeparam TItem
@implements IGXTable
@implements IAsyncDisposable
@inject ILogger<GXTable<TItem>> Logger

<CascadingValue Value="this">
    @{
        var header = PrepareColumnHeader();
        bool showColumnConfiguration = AllowColumnCustomization && AvailableColumns.Count != 0;
    }
    @if (Filter && FilterContent != null)
    {
        @if (ShowAllUsers)
        {
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox"
                       onchange="@((ChangeEventArgs __e) => ShowAllUserData = @Convert.ToBoolean(__e.Value))" />
                <label>@Properties.Resources.ShowDataForAllUsers</label>
            </div>
        }
        @if (ShowRemoved)
        {
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox"
                       onchange="@((ChangeEventArgs __e) => Removed = @Convert.ToBoolean(__e.Value))" />
                <label>@ShowRemovedMessage</label>
            </div>
        }
    }
    @if (Filter && FilterContent != null)
    {
        <MenuControl>
            <ChildContent>
                <MenuItem Text="Search" Id="Search" OnClick="@Search" />
            </ChildContent>
        </MenuControl>
        <br />
    }
    @if (showColumnConfiguration && _showColumnEditor)
    {
            var editorContext = CreateColumnEditorContext();
            <Dialog Id="@(Id + "-columns")" Title="@ColumnSelectorText" Save="false" ManageFocus="true" OkButtonTitle="Save" CancelButtonTitle="Cancel"
                    OnOk="SaveColumnEditorAsync" OnCancel="CloseColumnEditorAsync" aria-modal="true" aria-labelledby="@(Id + "-columns-title")">
            <FooterContent>
                @if (ColumnEditorFooterContent != null)
                {
                    @ColumnEditorFooterContent(editorContext)
                }
            </FooterContent>
            <ChildContent>
            <div class="gx-table-columns">
            @if (ColumnEditorContent != null)
            {
                @ColumnEditorContent(editorContext)
            }
            else
            {
            <GXTable TItem="GXTableColumn" @ref="_columnEditor" ItemsProvider="@GetColumnItems"
                     Save="false" Filter="false" Total="false" ShowAllData="true" ShowAllUsers="false" ShowRemoved="false"
                     RearrangeRows="@(!_savingColumns)" OnItemMoved="@OnColumnMoved" ItemKey="@(column => column.Name)">
                <HeaderContent>
                    <th>@ColumnSelectorText</th>
                    <th>Visibility</th>
                </HeaderContent>
                <ItemContent Context="column">
                    <td><label class="form-check mb-0">
                        <input class="form-check-input" type="checkbox" @bind:get="@IsDraftColumnVisible(column.Name)"
                               disabled="@_savingColumns"
                               @bind:set="@((bool visible) => ToggleDraftColumnAsync(column.Name, visible))" />
                        <span class="form-check-label">
                            @if (ColumnOptions == null && _registeredColumns.TryGetValue(column.Name, out var header) && header.Content != null)
                            {
                                @header.Content
                            }
                            else
                            {
                                @column.Text
                            }
                        </span>
                    </label></td>
                    <td><select class="form-select form-select-sm w-auto" aria-label="@(column.Text + " visibility")"
                            @bind:get="@GetDraftVisibility(column.Name)" disabled="@_savingColumns"
                            @bind:set="@((Visibility visibility) => SetDraftVisibilityAsync(column.Name, visibility))">
                        @foreach (var visibility in Enum.GetValues<Visibility>())
                        {
                            <option value="@visibility">@visibility</option>
                        }
                    </select></td>
                </ItemContent>
            </GXTable>
            }
            <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@_savingColumns" @onclick="ResetColumnDraftAsync">Reset</button>
            @if (_columnError != null)
            {
                <div role="alert" class="text-danger">@_columnError</div>
            }
            </div>
            </ChildContent>
            </Dialog>
    }
    <table id="@Id" @attributes="GXComponentAttributes.WithoutCss(AdditionalAttributes)" class="@GetCssClass()" style="@GXComponentAttributes.GetStyle(AdditionalAttributes)">
        <thead>
            @if (Filter && FilterContent != null)
            {
                <tr>
                    @if (RearrangeRows)
                    {
                        <th width="1%"></th>
                    }
                    @if (SelectionMode == SelectionMode.Multiple)
                    {
                        <th width="1%"></th>
                    }
                </tr>
                <tr>
                    @if (RearrangeRows)
                    {
                        <th width="1%"></th>
                    }
                    @if (SelectionMode == SelectionMode.Multiple)
                    {
                        <th width="1%"></th>
                    }
                    @OrderedCells(FilterContent)
                    @if (Menu && MenuContent != null)
                    {
                        <th width="1%"></th>
                    }
                    @if (showColumnConfiguration)
                    {
                        <th class="gx-table-configuration-cell" aria-hidden="true"></th>
                    }
                </tr>
            }
            @if (HeaderContent != null || showColumnConfiguration)
            {
                <tr>
                    @if (RearrangeRows)
                    {
                        <th width="1%"></th>
                    }
                    @if (SelectionMode == SelectionMode.Multiple)
                    {
                        <th width="1%">
                            <input class="form-check-input" type="checkbox"
                                   checked="@IsAllSelected()"
                                   onchange="@((ChangeEventArgs __e) => ToggleAllRow(Convert.ToBoolean(__e.Value)))" />
                        </th>
                    }
                    @header
                    @if (HeaderContent == null)
                    {
                        @foreach (var column in OrderedColumns)
                        {
                            @if (!((IGXTable)this).IsHidden(column.Name))
                            {
                                <th class="@Fh.GetCssClass(GetColumnVisibility(column.Name, GetDefaultColumnVisibility(column.Name)), null)"></th>
                            }
                        }
                    }
                    @if (Menu && MenuContent != null)
                    {
                        <th width="1%"></th>
                    }
                    @if (showColumnConfiguration)
                    {
                        <th class="gx-table-configuration-cell" scope="col">
                            <button type="button" class="gx-table-configuration-button btn btn-outline-secondary btn-sm"
                                    title="@ColumnSelectorText" aria-label="@ColumnSelectorText" aria-haspopup="dialog"
                                    aria-expanded="@(_showColumnEditor ? "true" : "false")" aria-controls="@(Id + "-columns")" @onclick="OpenColumnEditorAsync">
                                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round">
                                    <polygon points="19.61,9.53 22.31,10 22.31,14 19.61,14.47 19.13,15.63 20.70,17.87 17.87,20.70 15.63,19.13 14.47,19.61 14,22.31 10,22.31 9.53,19.61 8.37,19.13 6.13,20.70 3.30,17.87 4.87,15.63 4.39,14.47 1.69,14 1.69,10 4.39,9.53 4.87,8.37 3.30,6.13 6.13,3.30 8.37,4.87 9.53,4.39 10,1.69 14,1.69 14.47,4.39 15.63,4.87 17.87,3.30 20.70,6.13 19.13,8.37" />
                                    <circle cx="12" cy="12" r="3" />
                                </svg>
                            </button>
                        </th>
                    }
                </tr>
            }
        </thead>
        <tbody class="dropzone"
               ondragover="event.preventDefault();">
            @foreach (TItem it in @GetItems())
            {
                @if (ItemContent != null)
                {
                    <tr @key="@(GetItemKey(it) ?? (object?)it)" class=@(GetSelectedClass(it)) onclick="@(() => SelectRow(it))"
                        alt="Drag"
                        title="@(@RearrangeRows ? "Drag row to new location" : "")"
                        draggable="@RearrangeRows"
                        @ondragstart="@(() => HandleDragStart(it))"
                        @ondrop="@(() => HandleDrop(it))"
                        @ondragenter="HandleDragEnter"
                        @ondragleave="HandleDragLeave">
                        @if (RearrangeRows)
                        {
                            <td style="cursor:all-scroll;" class="drag-cell"
                                draggable="true"
                                onmousedown="@(() => HandleDragStart(it))">
                                <span class="icon-move" aria-hidden="true"></span>
                            </td>
                        }
                        @if (SelectionMode == SelectionMode.Multiple)
                        {
                            <td>
                                <input class="form-check-input" type="checkbox"
                                       disabled="@IsCheckboxDisabled(it)"
                                       checked="@IsSelected(it)"
                                       onchange="@((ChangeEventArgs __e) => ToggleRow(it, Convert.ToBoolean(__e.Value)))" />
                            </td>
                        }
                        <CascadingValue Value="@(new GXTableRowContext(it, EditLink?.Invoke(it)))">
                            @OrderedCells(ItemContent(it))
                        </CascadingValue>
                        @if (Menu && MenuContent != null)
                        {
                            @if (it != null && (Compare(it, Active) || it.Equals(Active)))
                            {
                                <td class="gx-table-menu-cell">
                                    <ContextMenuController>
                                        @MenuContent
                                    </ContextMenuController>
                                </td>
                            }
                            else
                            {
                                <td>&nbsp;</td>
                            }
                        }
                        @if (showColumnConfiguration)
                        {
                            <td class="gx-table-configuration-cell" aria-hidden="true"></td>
                        }
                    </tr>
                }
            }
        </tbody>
    </table>
    @*Add pagination.*@
    @if (Pages.Count > 1 && !ShowAllData)
    {
        <ul class="pagination justify-content-center">
            @if (CurrentPage != 0)
            {
                <li onclick="@(() => SelectPage(0))"
                    style="cursor: pointer;"
                    class="page-link" href="#">&laquo;</li>
            }
            @foreach (int pos in Pages)
            {
                @if (pos >= CurrentPage - Spread && pos <= CurrentPage + Spread)
                {
                    <li onclick="@(() => SelectPage(pos))"
                        style="cursor: pointer;"
                        class="page-item @(CurrentPage == pos ? "active" : null)">
                        <span class="page-link" href="#">@(1 + pos)</span>
                    </li>
                }

            }
            @if (CurrentPage != TotalPages - 1)
            {
                <li onclick="@(() => SelectPage(TotalPages - 1))"
                    style="cursor: pointer;"
                    class="page-link" href="#">&raquo;</li>
            }
        </ul>
    }
    <div class="gx-table-footer d-flex justify-content-between align-items-center gap-3">
        @if (Total)
        {
            <label>
                @if (@TotalCount == -1)
                {
                    @(Properties.Resources.Total + " " + Properties.Resources.Unknown)
                }
                else
                {
                    @(Properties.Resources.Total + " " + TotalCount.ToString("N0"))
                }
            </label>
        }
        @if (!ShowAllData)
        {
            <div class="gx-table-page-size ms-auto flex-shrink-0 d-flex align-items-center gap-2">
                <label for="@GetPageSizeId()" class="mb-0">@Properties.Resources.RowsPerPage</label>
                <GXInputDropdown class="form-select w-auto"
                                 Id="@GetPageSizeId()"
                                 Items="@RowsPerPage"
                                 TValue="int" Value="@PageSize"
                                 ValueExpression="@(() => PageSize)"
                                 ValueChanged="SetPageSize">
                </GXInputDropdown>
            </div>
        }
    </div>
    @ChildContent
</CascadingValue>

@code {
    /// <summary>
    /// Gets or sets captured HTML attributes forwarded to the underlying element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// Gets or sets the service provider used to resolve optional component services.
    /// </summary>
    [Inject]
    public IServiceProvider Services { get; set; } = default!;

    /// <summary>
    /// Gets the optional service used to report component errors as notifications.
    /// </summary>
    private IGXNotificationService? NotificationService { get; set; }

    private IGXLocalStorage? LocalStorage { get; set; }

    /// <summary>Persists table column preferences when an explicit table id is supplied.</summary>
    [Parameter]
    public bool Save { get; set; } = true;

    /// <summary>Optional stable personal preference identity independent of the table's HTML id.</summary>
    [Parameter]
    public string? PreferencesId { get; set; }

    private readonly Dictionary<string, double> _columnWidths = new(StringComparer.Ordinal);
    private IJSObjectReference? _widthModule;
    private IJSObjectReference? _widthHandler;
    private DotNetObjectReference<GXTable<TItem>>? _widthReference;
    private Task? _widthInitialization;

    private string? ColumnWidthsKey => GetStorageKey("ColumnWidths");
    private string? ColumnSettingsKey => GetStorageKey("Columns");
    private string? SortKey => GetStorageKey("Sort");

    private sealed class SortPreferences
    {
        public string? OrderBy { get; set; }
        public SortMode SortMode { get; set; }
    }

    private string? GetStorageKey(string setting)
    {
        string? id = !string.IsNullOrWhiteSpace(PreferencesId) ? PreferencesId : GXComponentAttributes.GetValue(AdditionalAttributes, "id");
        return Save && !string.IsNullOrWhiteSpace(id) ? $"GXTable:{id}:{setting}" : null;
    }

    /// <summary>Returns the saved CSS pixel width of a named column.</summary>
    public string? GetColumnWidth(string? name) => ColumnWidthsKey != null && name != null &&
        _columnWidths.TryGetValue(name, out double width)
        ? width.ToString(System.Globalization.CultureInfo.InvariantCulture) + "px" : null;

    /// <summary>Persists a column width after the user finishes resizing it.</summary>
    [JSInvokable]
    public async Task SaveColumnWidthAsync(string name, double width)
    {
        string? key = ColumnWidthsKey;
        if (key == null || LocalStorage == null || string.IsNullOrWhiteSpace(name) || !double.IsFinite(width) || width <= 0)
        {
            return;
        }
        _columnWidths[name] = width;
        try
        {
            await LocalStorage.SetValueAsync(key, System.Text.Json.JsonSerializer.Serialize(_columnWidths));
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    /// <summary>
    /// Resolves the optional notification service used to report table errors.
    /// </summary>
    protected override void OnInitialized()
    {
        NotificationService = Services.GetService<IGXNotificationService>();
        LocalStorage = Services.GetService<IGXLocalStorage>();
    }

    /// <summary>
    /// Gets the supplied HTML id or a Guid identifier generated once for this component instance.
    /// </summary>
    public string Id => GXComponentAttributes.GetId(AdditionalAttributes, ref _generatedId);

    private string? _generatedId;

    /// <summary>
    /// Returns the table-specific id used to persist the page size selector's value.
    /// </summary>
    private string? GetPageSizeId()
    {
        if (Id != null)
        {
            return Id + "-page-size";
        }
        return null;
    }

    int[] RowsPerPage = new int[] { 10, 20, 50, 100 };

    /// <summary>
    /// Determines whether a row checkbox is disabled and whether the row should be checked.
    /// </summary>
    /// <param name="item">The row item whose checkbox state is being evaluated.</param>
    /// <param name="disabled">Whether the checkbox should be disabled.</param>
    /// <param name="check">Whether the row should be added to the checked-item collection.</param>
    public delegate void CheckboxDisabledEventHandler(TItem item, out bool disabled, out bool check);

    /// <summary>
    /// Gets or sets whether the control for including removed items is displayed.
    /// </summary>
    [Parameter]
    public bool ShowRemoved { get; set; } = true;

    /// <summary>
    /// Gets or sets whether rows can be reordered by dragging.
    /// </summary>
    [Parameter]
    public bool RearrangeRows { get; set; }

    /// <summary>
    /// Gets or sets whether the control for including all users' data is displayed.
    /// </summary>
    [Parameter]
    public bool ShowAllUsers { get; set; } = true;

    /// <summary>
    /// Gets or sets whether requests include data belonging to all users.
    /// </summary>
    protected bool ShowAllUserData { get; set; } = false;

    /// <summary>
    /// Gets or sets whether all items are displayed without pagination.
    /// </summary>
    [Parameter]
    public bool ShowAllData { get; set; }

    /// <summary>
    /// Gets or sets whether the provider should return removed items.
    /// </summary>
    public bool Removed { get; set; }

    /// <summary>
    /// Gets or sets whether the total item count is displayed.
    /// </summary>
    [Parameter]
    public bool Total { get; set; } = true;

    /// <summary>
    /// Gets or sets whether the table's filter controls are shown.
    /// </summary>
    [Parameter]
    public bool Filter { get; set; } = true;

    /// <summary>
    /// Gets or sets whether the table menu is displayed.
    /// </summary>
    [Parameter]
    public bool Menu { get; set; } = true;

    /// <summary>
    /// Gets or sets the callback invoked when the sort mode or sorted column changes.
    /// </summary>
    [Parameter]
    public EventCallback<(SortMode Sort, string Column)> SortChanged { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked when the active table row changes.
    /// </summary>
    [Parameter]
    public EventCallback<TItem> OnRowChanged { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked when a table cell is selected.
    /// </summary>
    [Parameter]
    public EventCallback<TItem> OnCellChanged { get; set; }

    /// <summary>
    /// Gets or sets the callback used to determine a row checkbox's disabled and checked states.
    /// </summary>
    [Parameter]
    public CheckboxDisabledEventHandler? OnCheckboxDisabled { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked with a dragged item and its destination index.
    /// </summary>
    [Parameter]
    public EventCallback<(TItem Item, int Index)> OnItemMoved { get; set; }

    /// <summary>
    /// Gets or sets the callback used to add an item.
    /// </summary>
    [Parameter]
    public EventCallback<TItem> OnItemAdded { get; set; }

    /// <summary>
    /// Gets or sets the callback used to remove an item.
    /// </summary>
    [Parameter]
    public EventCallback<TItem> OnItemRemoved { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked with the current search filter.
    /// </summary>
    [Parameter]
    public EventCallback OnSearch { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked with the checked items after row selection changes.
    /// </summary>
    [Parameter]
    public EventCallback<IEnumerable<TItem>> OnChecked { get; set; }


    /// <summary>
    /// Gets or sets the label displayed beside the removed-items control.
    /// </summary>
    [Parameter]
    public string ShowRemovedMessage { get; set; } = Properties.Resources.ShowRemoved;

    /// <summary>
    /// Gets whether at least one table row is checked.
    /// </summary>
    [Parameter]
    public bool AnyChecked { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked when the table's checked-row state changes.
    /// </summary>
    [Parameter]
    public EventCallback<bool> AnyCheckedChanged { get; set; }


    /// <summary>
    /// Resets pagination and invokes the search callback with the current filter.
    /// </summary>
    private async Task Search()
    {
        CurrentPage = 0;
        if (OnSearch.HasDelegate)
        {
            await OnSearch.InvokeAsync();
        }
    }

    private TItem? DropItem;

    /// <summary>
    /// Records the table item being dragged for a subsequent row reorder operation.
    /// </summary>
    private void HandleDragStart(TItem item)
    {
        Logger.LogError("Drag start: {0}", item);
        DropItem = item;
    }

    /// <summary>
    /// Logs that a drag operation entered a table row.
    /// </summary>
    private void HandleDragEnter()
    {
        Logger.LogError("Drag enter.");
    }

    /// <summary>
    /// Logs that a drag operation left a table row.
    /// </summary>
    private void HandleDragLeave()
    {
        Logger.LogError("Drag leave.");
    }

    /// <summary>
    /// Invokes the row movement callback with the dragged item and destination row index.
    /// </summary>
    private async Task HandleDrop(TItem item)
    {
        Logger.LogError("Drag drop: {0}", item);
        if (DropItem != null && OnItemMoved.HasDelegate && Items != null)
        {
            List<TItem> tmp = new(Items);
            int pos = tmp.IndexOf(item);
            var dropped = DropItem;
            DropItem = default;
            await OnItemMoved.InvokeAsync((dropped, pos));
        }
    }

    /// <summary>
    /// Gets or sets the number of page links displayed before and after the current page.
    /// </summary>
    [Parameter]
    public int Spread { get; set; } = 2;

    private List<int> Pages = new List<int>();

    /// <summary>
    /// Gets or sets the currently focused table item.
    /// </summary>
    [Parameter]
    public TItem? Active { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked when the active item changes.
    /// </summary>
    [Parameter]
    public EventCallback<TItem> ActiveChanged { get; set; }


    /// <summary>
    /// Selected items.
    /// </summary>
    private Dictionary<object, TItem> _selectedItems = new();

    /// <summary>
    /// Returns the displayed row indices of checked items and the active item without duplicates.
    /// </summary>
    public int[] GetSelectedRows()
    {
        List<int> rows = new List<int>();
        var list = GetItems().ToList();
        foreach (var it in _selectedItems.Values)
        {
            int index = list.IndexOf(it);
            if (index != -1)
            {
                rows.Add(index);
            }
        }
        if (Active != null)
        {
            int index = list.IndexOf(Active);
            if (index != -1 && !rows.Contains(index))
            {
                rows.Add(index);
            }
        }
        return rows.ToArray();
    }

    /// <summary>
    /// Gets the selected table items.
    /// </summary>
    public IEnumerable<TItem> SelectedItems
    {
        get
        {
            return _selectedItems.Values;
        }
    }

    /// <summary>
    /// Returns the selected items, or the active item when no items are selected.
    /// </summary>
    public IEnumerable<TItem> SingleOrDefault()
    {
        if (_selectedItems.Values.Any())
        {
            return _selectedItems.Values;
        }
        if (Active != null)
        {
            return new TItem[] { Active };
        }
        return new TItem[0];
    }

    /// <summary>
    /// Gets or sets the zero-based index of the current page.
    /// </summary>
    [Parameter]
    public int CurrentPage { get; set; }
    /// <summary>
    /// Gets or sets the callback invoked when the current page changes.
    /// </summary>
    [Parameter]
    public EventCallback<int> CurrentPageChanged { get; set; }

    /// <summary>
    /// Gets or sets the number of items requested for each page.
    /// </summary>
    [Parameter]
    public int PageSize { get; set; } = 10;

    /// <summary>
    /// Gets or sets the callback invoked when the page size changes.
    /// </summary>
    [Parameter]
    public EventCallback<int> PageSizeChanged { get; set; }

    /// <summary>
    /// Adjusts the requested page to the available item range and notifies the page callback.
    /// </summary>
    private async Task UpdateCurrentPage(int value)
    {
        if (value == CurrentPage)
        {
            return;
        }
        if (value < 0)
        {
            CurrentPage = 0;
        }
        else if (TotalCount == -1)
        {
            if (value == CurrentPage)
            {
                CurrentPage = 1 + CurrentPage;
            }
        }
        else if (PageSize * value > TotalCount)
        {
            CurrentPage = TotalCount / PageSize;
        }
        else
        {
            CurrentPage = value;
        }
        await CurrentPageChanged.InvokeAsync(CurrentPage);
    }

    /// <summary>
    /// Corrects a nonpositive page size and reconciles the current page with the item range.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        if (PageSize <= 0)
        {
            PageSize = 10;
            await PageSizeChanged.InvokeAsync(PageSize);
        }
        await UpdateCurrentPage(CurrentPage);
    }

    /// <summary>
    /// Applies a positive page size, invokes its callback, and selects the first page.
    /// </summary>
    private async Task SetPageSize(int value)
    {
        if (value <= 0)
        {
            return;
        }
        PageSize = value;
        await PageSizeChanged.InvokeAsync(value);
        await SelectPage(0);
    }

    /// <summary>
    /// Gets the total number of items reported by the provider.
    /// </summary>
    public int TotalCount { get; private set; }

    /// <summary>
    /// Gets the number of pages calculated from the total count and page size.
    /// </summary>
    public int TotalPages
    {
        get
        {
            if (TotalCount == -1)
            {
                return 2 + CurrentPage;
            }
            return (int)Math.Ceiling(TotalCount / (double)PageSize);
        }
    }

    /// <summary>
    /// Selects the requested zero-based page and refreshes the displayed items.
    /// </summary>
    /// <param name="index">Page index</param>
    private async Task SelectPage(int index)
    {
        await UpdateCurrentPage(index);
        await RefreshDataAsync(true);
    }

    /// <summary>
    /// Gets or sets the names of columns to display; unspecified columns remain hidden when a list is provided.
    /// </summary>
    [Parameter]
    public string[]? Columns { get; set; }

    /// <summary>Default visible columns, applied when no personal selection has been saved.</summary>
    [Parameter] public string[]? DefaultColumns { get; set; }

    /// <summary>Default column order, applied when no personal order has been saved.</summary>
    [Parameter] public string[]? DefaultColumnOrder { get; set; }

    /// <summary>Default responsive visibility, overridden by personal column settings.</summary>
    [Parameter] public IReadOnlyDictionary<string, Visibility>? DefaultColumnVisibility { get; set; }

    /// <summary>Available columns and their display labels.</summary>
    [Parameter] public IReadOnlyList<GXTableColumn>? ColumnOptions { get; set; }
    /// <summary>Allows users to choose columns and change their responsive and print visibility.</summary>
    [Parameter] public bool AllowColumnCustomization { get; set; }
    /// <summary>Replaces the default column editor UI while retaining the dialog and its Save, Cancel and Reset actions.</summary>
    [Parameter] public RenderFragment<GXTableColumnEditorContext>? ColumnEditorContent { get; set; }
    /// <summary>Adds custom actions, such as Save as Default, before the editor's Save and Cancel buttons.</summary>
    [Parameter] public RenderFragment<GXTableColumnEditorContext>? ColumnEditorFooterContent { get; set; }
    /// <summary>Applies custom draft defaults after Reset, before the user saves or cancels.</summary>
    [Parameter] public EventCallback<GXTableColumnEditorContext> OnColumnEditorReset { get; set; }
    /// <summary>Caption for the column selector.</summary>
    [Parameter] public string ColumnSelectorText { get; set; } = "Columns";
    /// <summary>Loads visible column identifiers. Null uses the default columns.</summary>
    [Parameter] public Func<Task<string[]?>>? ColumnsProvider { get; set; }
    /// <summary>Persists visible column identifiers before they are applied.</summary>
    [Parameter] public EventCallback<string[]> ColumnsChanged { get; set; }
    private bool _savingColumns;
    private string? _columnError;
    private string[]? _visibleColumns;
    private string[]? _parameterColumns;
    private string[]? _parameterDefaultColumns;
    private string[]? _defaultColumns;
    private string[]? _columnOrder;
    private string?[]? _sourceColumnNames;
    private GXTable<GXTableColumn>? _columnEditor;
    private bool _showColumnEditor;
    private ColumnPreferences? _columnDraft;
    private bool _draftResetWidths;

    private GXTableColumnEditorContext CreateColumnEditorContext()
    {
        var draft = _columnDraft!;
        var columns = OrderColumns(draft.Order ?? DefaultColumnOrder).ToArray();
        Task Run(Func<Task> action) => _disposed ? Task.CompletedTask : InvokeAsync(() =>
            !_disposed && _showColumnEditor && ReferenceEquals(_columnDraft, draft) ? action() : Task.CompletedTask);
        return new GXTableColumnEditorContext
        {
            Columns = Array.AsReadOnly(columns),
            ColumnOrder = Array.AsReadOnly(columns.Select(column => column.Name).ToArray()),
            VisibleColumns = Array.AsReadOnly(columns.Where(column => IsDraftColumnVisible(column.Name)).Select(column => column.Name).ToArray()),
            Visibility = new System.Collections.ObjectModel.ReadOnlyDictionary<string, Visibility>(
                columns.ToDictionary(column => column.Name, column => GetDraftVisibility(column.Name), StringComparer.Ordinal)),
            Widths = new System.Collections.ObjectModel.ReadOnlyDictionary<string, double>(
                _draftResetWidths ? new Dictionary<string, double>(StringComparer.Ordinal) : new Dictionary<string, double>(_columnWidths, StringComparer.Ordinal)),
            IsSaving = _savingColumns,
            Error = _columnError,
            SetVisible = (name, visible) => Run(() => ToggleDraftColumnAsync(name, visible)),
            SetVisibility = (name, visibility) => Run(() => SetDraftVisibilityAsync(name, visibility)),
            Move = (name, index) => Run(() => MoveDraftColumnAsync(name, index)),
            Reset = () => Run(ResetColumnDraftAsync),
            Save = () => Run(SaveColumnEditorAsync),
            Cancel = () => Run(CloseColumnEditorAsync)
        };
    }

    private async Task OpenColumnEditorAsync()
    {
        if (!AllowColumnCustomization || AvailableColumns.Count == 0 || _showColumnEditor) return;
        _columnDraft = new ColumnPreferences
        {
            VisibleColumns = _visibleColumns?.ToArray(),
            Visibility = new(_columnVisibility, StringComparer.Ordinal),
            Order = _columnOrder?.ToArray()
        };
        _draftResetWidths = false;
        _columnError = null;
        _showColumnEditor = true;
        await InvokeAsync(StateHasChanged);
        if (_columnEditor != null) await _columnEditor.RefreshDataAsync(true);
    }

    private Task CloseColumnEditorAsync()
    {
        if (_savingColumns) return Task.CompletedTask;
        _showColumnEditor = false;
        _columnEditor = null;
        _columnDraft = null;
        _draftResetWidths = false;
        _columnError = null;
        return InvokeAsync(StateHasChanged);
    }

    private bool IsDraftColumnVisible(string name) =>
        _columnDraft?.VisibleColumns == null || _columnDraft.VisibleColumns.Contains(name, StringComparer.Ordinal);

    private Visibility GetDraftVisibility(string name) =>
        _columnDraft?.Visibility is { } values && values.TryGetValue(name, out var visibility)
            ? visibility : GetDefaultColumnVisibility(name);

    private Task ToggleDraftColumnAsync(string name, bool visible)
    {
        if (_savingColumns || _columnDraft == null || !AvailableColumns.Any(column => column.Name == name)) return Task.CompletedTask;
        _columnDraft.VisibleColumns = AvailableColumns.Where(column => column.Name == name ? visible : IsDraftColumnVisible(column.Name))
            .Select(column => column.Name).ToArray();
        return InvokeAsync(StateHasChanged);
    }

    private Task SetDraftVisibilityAsync(string name, Visibility visibility)
    {
        if (_savingColumns || _columnDraft == null || !Enum.IsDefined(visibility) || !AvailableColumns.Any(column => column.Name == name))
            return Task.CompletedTask;
        (_columnDraft.Visibility ??= new(StringComparer.Ordinal))[name] = visibility;
        return InvokeAsync(StateHasChanged);
    }

    private Task MoveDraftColumnAsync(string name, int index)
    {
        if (_savingColumns || _columnDraft == null) return Task.CompletedTask;
        var order = OrderColumns(_columnDraft.Order ?? DefaultColumnOrder).Select(column => column.Name).ToList();
        if (index < 0 || index >= order.Count || !order.Remove(name)) return Task.CompletedTask;
        order.Insert(index, name);
        _columnDraft.Order = order.ToArray();
        return RefreshColumnEditorAsync();
    }

    private async Task ResetColumnDraftAsync()
    {
        if (_savingColumns || _columnDraft == null) return;
        _columnDraft.VisibleColumns = _defaultColumns?.ToArray() ?? AvailableColumns.Select(column => column.Name).ToArray();
        _columnDraft.Visibility = new(StringComparer.Ordinal);
        _columnDraft.Order = null;
        _draftResetWidths = true;
        if (OnColumnEditorReset.HasDelegate)
            await OnColumnEditorReset.InvokeAsync(CreateColumnEditorContext());
        await RefreshColumnEditorAsync();
    }

    private async Task SaveColumnEditorAsync()
    {
        if (_savingColumns || _columnDraft == null) return;
        var draft = _columnDraft;
        _savingColumns = true;
        _columnError = null;
        var storage = LocalStorage;
        string? settingsKey = ColumnSettingsKey;
        string? widthsKey = ColumnWidthsKey;
        string? previousSettings = null;
        string? previousWidths = null;
        var previousColumns = _visibleColumns;
        bool resetWidths = _draftResetWidths;
        bool settingsWritten = false;
        bool widthsWritten = false;
        bool saved = false;
        try
        {
            var visibility = draft.Visibility ?? new(StringComparer.Ordinal);
            if (settingsKey != null && storage != null) previousSettings = await storage.GetValueAsync(settingsKey);
            if (resetWidths && widthsKey != null && storage != null)
            {
                previousWidths = await storage.GetValueAsync(widthsKey);
                await storage.SetValueAsync(widthsKey, "{}");
                widthsWritten = true;
            }
            await PersistColumnsAsync(draft.VisibleColumns, visibility, draft.Order);
            settingsWritten = settingsKey != null && storage != null;
            await ColumnsChanged.InvokeAsync(draft.VisibleColumns ?? AvailableColumns.Select(column => column.Name).ToArray());
            _visibleColumns = draft.VisibleColumns?.ToArray();
            _columnOrder = draft.Order?.ToArray();
            _columnVisibility.Clear();
            foreach (var column in visibility) _columnVisibility[column.Key] = column.Value;
            if (resetWidths) _columnWidths.Clear();
            saved = true;
        }
        catch (Exception ex)
        {
            _visibleColumns = previousColumns;
            if (settingsWritten && settingsKey != null && storage != null)
            {
                try { await storage.SetValueAsync(settingsKey, previousSettings); }
                catch (Exception restoreError) { NotificationService?.ReportError(restoreError); }
            }
            if (widthsWritten && widthsKey != null && storage != null)
            {
                try { await storage.SetValueAsync(widthsKey, previousWidths); }
                catch (Exception restoreError) { NotificationService?.ReportError(restoreError); }
            }
            _columnError = ex.Message;
            NotificationService?.ReportError(ex);
        }
        finally
        {
            _savingColumns = false;
            if (saved) await CloseColumnEditorAsync();
            else await InvokeAsync(StateHasChanged);
        }
    }
    private bool _columnsInitialized;
    private bool _disposed;
    private readonly Dictionary<string, RegisteredColumn> _registeredColumns = new(StringComparer.Ordinal);
    private readonly Dictionary<string, Visibility> _columnVisibility = new(StringComparer.Ordinal);

    private sealed record RegisteredColumn(RenderFragment? Content, Visibility Visibility);

    private sealed class ColumnPreferences
    {
        public ColumnPreferences() { }
        public string[]? VisibleColumns { get; set; }
        public Dictionary<string, Visibility>? Visibility { get; set; }
        public string[]? Order { get; set; }
    }

    private IReadOnlyList<GXTableColumn> AvailableColumns => ColumnOptions ??
        (_sourceColumnNames ?? []).OfType<string>().Where(_registeredColumns.ContainsKey)
            .Concat(_registeredColumns.Keys).Distinct(StringComparer.Ordinal).Select(name => new GXTableColumn(name, name)).ToArray();

    private RenderFragment? PrepareColumnHeader()
    {
        if (HeaderContent == null) return null;
        var content = HeaderContent(default!);
        if (!AllowColumnCustomization && EffectiveColumnOrder == null) return content;
        var cells = new GXTableCellOrder(content);
        _sourceColumnNames = cells.Names;
        return cells.Render(EffectiveColumnOrder);
    }

    private RenderFragment OrderedCells(RenderFragment content) => !AllowColumnCustomization && EffectiveColumnOrder == null ? content
        : new GXTableCellOrder(content).Render(EffectiveColumnOrder, _sourceColumnNames);

    private string[]? EffectiveColumnOrder => _columnOrder ?? DefaultColumnOrder;

    private IReadOnlyList<GXTableColumn> OrderedColumns => OrderColumns(EffectiveColumnOrder);

    private IReadOnlyList<GXTableColumn> OrderColumns(string[]? order) => AvailableColumns.OrderBy(column =>
    {
        int position = order == null ? -1 : Array.IndexOf(order, column.Name);
        return position < 0 ? int.MaxValue : position;
    }).ToArray();

    private ValueTask<ItemsProviderResult<GXTableColumn>> GetColumnItems(GXItemsProviderRequest request)
        => ValueTask.FromResult(new ItemsProviderResult<GXTableColumn>(OrderColumns((_columnDraft != null ? _columnDraft.Order : _columnOrder) ?? DefaultColumnOrder), AvailableColumns.Count));

    private Task OnColumnMoved((GXTableColumn Item, int Index) moved) => MoveDraftColumnAsync(moved.Item.Name, moved.Index);

    /// <summary>Moves a column to a zero-based position and persists its order when Save and an explicit table id are set.</summary>
    public async Task MoveColumnAsync(string name, int index)
    {
        if (_savingColumns) return;
        var order = OrderedColumns.Select(column => column.Name).ToList();
        if (index < 0 || index >= order.Count || !order.Remove(name)) return;
        order.Insert(index, name);
        _savingColumns = true;
        _columnError = null;
        try
        {
            var updated = order.ToArray();
            await PersistColumnsAsync(_visibleColumns, _columnVisibility, updated);
            _columnOrder = updated;
        }
        catch (Exception ex) { _columnError = ex.Message; NotificationService?.ReportError(ex); }
        finally
        {
            _savingColumns = false;
            if (_columnEditor != null) await _columnEditor.RefreshDataAsync(true);
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>Restores configured column selection, order, responsive visibility and widths.</summary>
    public async Task ResetColumnsAsync()
    {
        if (_savingColumns) return;
        _savingColumns = true;
        _columnError = null;
        bool widthsWritten = false;
        try
        {
            var defaults = _defaultColumns?.ToArray() ?? AvailableColumns.Select(column => column.Name).ToArray();
            await ColumnsChanged.InvokeAsync(defaults);
            if (ColumnWidthsKey is string key && LocalStorage != null)
            {
                await LocalStorage.SetValueAsync(key, "{}");
                widthsWritten = true;
            }
            await PersistColumnsAsync(defaults, new(StringComparer.Ordinal), null);
            _visibleColumns = defaults;
            _columnOrder = null;
            _columnVisibility.Clear();
            _columnWidths.Clear();
        }
        catch (Exception ex)
        {
            if (widthsWritten && ColumnWidthsKey is string key && LocalStorage != null)
            {
                try { await LocalStorage.SetValueAsync(key, System.Text.Json.JsonSerializer.Serialize(_columnWidths)); }
                catch (Exception restoreError) { NotificationService?.ReportError(restoreError); }
            }
            _columnError = ex.Message;
            NotificationService?.ReportError(ex);
        }
        finally
        {
            _savingColumns = false;
            if (_columnEditor != null) await _columnEditor.RefreshDataAsync(true);
            await InvokeAsync(StateHasChanged);
        }
    }

    private Visibility GetDefaultColumnVisibility(string name) =>
        GetConfiguredVisibility(name, _registeredColumns.TryGetValue(name, out var column) ? column.Visibility : Visibility.All);

    private Visibility GetConfiguredVisibility(string? name, Visibility fallback) => name != null &&
        DefaultColumnVisibility?.TryGetValue(name, out var visibility) == true && Enum.IsDefined(visibility) ? visibility : fallback;

    /// <summary>Registers a header using its stable Id or Name, including hidden headers.</summary>
    public void RegisterColumn(string name, RenderFragment? content, Visibility visibility)
    {
        if (_disposed || string.IsNullOrWhiteSpace(name)) return;
        bool changed = !_registeredColumns.TryGetValue(name, out var previous) || previous.Visibility != visibility;
        _registeredColumns[name] = new(content, visibility);
        if (changed && AllowColumnCustomization) _ = RefreshColumnEditorAsync();
    }

    /// <summary>Removes the customization entry when a header is removed.</summary>
    public void UnregisterColumn(string name)
    {
        if (!_disposed && _registeredColumns.Remove(name) && AllowColumnCustomization) _ = RefreshColumnEditorAsync();
    }

    private Task RefreshColumnEditorAsync() => InvokeAsync(async () =>
    {
        if (_disposed) return;
        if (_columnEditor != null) await _columnEditor.RefreshDataAsync(true);
        StateHasChanged();
    });

    /// <summary>Returns the user's visibility override or the component's configured default.</summary>
    public Visibility GetColumnVisibility(string? name, Visibility defaultValue) =>
        name != null && _columnVisibility.TryGetValue(name, out var visibility) ? visibility : GetConfiguredVisibility(name, defaultValue);

    private async Task PersistColumnsAsync(string[]? columns, Dictionary<string, Visibility> visibility, string[]? order)
    {
        if (ColumnSettingsKey is string key && LocalStorage != null)
        {
            await LocalStorage.SetValueAsync(key, System.Text.Json.JsonSerializer.Serialize(new ColumnPreferences
            {
                VisibleColumns = columns,
                Visibility = visibility,
                Order = order
            }));
        }
    }

    /// <summary>Changes responsive visibility for every cell with the matching column identifier.</summary>
    public async Task SetColumnVisibilityAsync(string name, Visibility visibility)
    {
        if (_savingColumns || !Enum.IsDefined(visibility) || !AvailableColumns.Any(c => c.Name == name)) return;
        _savingColumns = true;
        _columnError = null;
        try
        {
            var updated = new Dictionary<string, Visibility>(_columnVisibility, StringComparer.Ordinal) { [name] = visibility };
            await PersistColumnsAsync(_visibleColumns, updated, _columnOrder);
            _columnVisibility[name] = visibility;
        }
        catch (Exception ex)
        {
            _columnError = ex.Message;
            NotificationService?.ReportError(ex);
        }
        finally
        {
            _savingColumns = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (SortKey is string sortKey && LocalStorage != null)
        {
            try
            {
                string? json = await LocalStorage.GetValueAsync(sortKey);
                if (!string.IsNullOrEmpty(json))
                {
                    var sort = System.Text.Json.JsonSerializer.Deserialize<SortPreferences>(json);
                    if (sort != null && !string.IsNullOrWhiteSpace(sort.OrderBy) && Enum.IsDefined(sort.SortMode))
                    {
                        OrderBy = sort.OrderBy;
                        SortMode = sort.SortMode;
                    }
                }
            }
            catch (Exception ex)
            {
                NotificationService?.ReportError(ex);
            }
        }
        if (ColumnWidthsKey is string key && LocalStorage != null)
        {
            try
            {
                string? json = await LocalStorage.GetValueAsync(key);
                if (!string.IsNullOrEmpty(json))
                {
                    var widths = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, double>>(json);
                    if (widths != null)
                    {
                        foreach (var column in widths)
                        {
                            if (!string.IsNullOrWhiteSpace(column.Key) && double.IsFinite(column.Value) && column.Value > 0)
                            {
                                _columnWidths[column.Key] = column.Value;
                            }
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                NotificationService?.ReportError(ex);
            }
        }
        _parameterColumns = Columns;
        _parameterDefaultColumns = DefaultColumns;
        _defaultColumns = (Columns ?? DefaultColumns)?.ToArray();
        _visibleColumns = Columns ?? DefaultColumns;
        _columnsInitialized = true;
        if (ColumnsProvider != null)
        {
            try { _visibleColumns = await ColumnsProvider(); }
            catch (Exception ex)
            {
                _columnError = ex.Message;
                NotificationService?.ReportError(ex);
            }
        }
        if (ColumnSettingsKey is string settingsKey && LocalStorage != null)
        {
            try
            {
                string? json = await LocalStorage.GetValueAsync(settingsKey);
                if (!string.IsNullOrEmpty(json))
                {
                    var preferences = System.Text.Json.JsonSerializer.Deserialize<ColumnPreferences>(json);
                    if (preferences != null)
                    {
                        _columnOrder = preferences.Order?.Where(name => !string.IsNullOrWhiteSpace(name)).Distinct(StringComparer.Ordinal).ToArray();
                        if (preferences.VisibleColumns != null) _visibleColumns = preferences.VisibleColumns;
                        if (preferences.Visibility != null)
                        {
                            foreach (var column in preferences.Visibility)
                            {
                                if (!string.IsNullOrWhiteSpace(column.Key) && Enum.IsDefined(column.Value))
                                    _columnVisibility[column.Key] = column.Value;
                            }
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                _columnError = ex.Message;
                NotificationService?.ReportError(ex);
            }
        }
    }

    protected override void OnParametersSet()
    {
        if (!AllowColumnCustomization)
        {
            _showColumnEditor = false;
            _columnEditor = null;
            _columnDraft = null;
            _draftResetWidths = false;
        }
        // Re-rendering an owner with the same default must not discard a loaded or edited selection.
        if (!ReferenceEquals(Columns, _parameterColumns))
        {
            _parameterColumns = Columns;
            _defaultColumns = (Columns ?? DefaultColumns)?.ToArray();
            _visibleColumns = Columns ?? DefaultColumns;
        }
        if (!ReferenceEquals(DefaultColumns, _parameterDefaultColumns))
        {
            // Personal selections loaded from storage or committed by the editor have their own array.
            if (Columns == null && ReferenceEquals(_visibleColumns, _parameterDefaultColumns))
                _visibleColumns = DefaultColumns;
            _parameterDefaultColumns = DefaultColumns;
            _defaultColumns = (Columns ?? DefaultColumns)?.ToArray();
        }
    }

    /// <summary>Changes a column, retaining the previous selection if saving fails.</summary>
    public async Task ToggleColumnAsync(string name, bool visible)
    {
        var available = AvailableColumns;
        if (_savingColumns || !available.Any(c => c.Name == name)) return;
        var selected = available.Where(c => c.Name == name ? visible : !((IGXTable)this).IsHidden(c.Name))
            .Select(c => c.Name).ToArray();
        _savingColumns = true;
        _columnError = null;
        try
        {
            await ColumnsChanged.InvokeAsync(selected);
            await PersistColumnsAsync(selected, _columnVisibility, _columnOrder);
            _visibleColumns = selected;
        }
        catch (Exception ex)
        {
            _columnError = ex.Message;
            NotificationService?.ReportError(ex);
        }
        finally
        {
            _savingColumns = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>
    /// Gets or sets whether table cells can render editable content.
    /// </summary>
    [Parameter]
    public bool CanEdit { get; set; } = true;

    /// <summary>Gets or sets the stable row identifier. Defaults to the item's Id property.</summary>
    [Parameter]
    public Func<TItem, object>? ItemKey { get; set; }

    /// <summary>Gets or sets the row edit URL used by cells with EditLink enabled.</summary>
    [Parameter]
    public Func<TItem, string>? EditLink { get; set; }

    private object? GetItemKey(TItem? item) => item == null ? null :
        ItemKey != null ? ItemKey(item) : item.GetType().GetProperty("Id")?.GetValue(item);

    /// <summary>
    /// Gets or sets whether row selection is disabled, single, or multiple.
    /// </summary>
    [Parameter]
    public SelectionMode SelectionMode { get; set; } = SelectionMode.Single;

    private CancellationTokenSource? _cts;

    /// <summary>
    /// Returns table items ordered by the configured property and sort direction.
    /// </summary>
    private IEnumerable<TItem> GetItems()
    {
        if (Items == null)
        {
            return new TItem[0];
        }
        if (!string.IsNullOrEmpty(OrderBy))
        {
            Type type = typeof(TItem);
            if (typeof(TItem) == typeof(string))
            {
                if (SortMode == SortMode.Ascending)
                {
                    return Items.OrderBy(o => o);
                }
                else if (SortMode == SortMode.Descending)
                {
                    return Items.OrderByDescending(o => o);
                }
            }
            else if (SortMode == SortMode.Ascending)
            {
                System.Reflection.PropertyInfo? prop = type.GetProperty(OrderBy);
                if (prop != null)
                {
                    return Items.OrderBy(o => prop.GetValue(o, null));
                }
            }
            else if (SortMode == SortMode.Descending)
            {
                System.Reflection.PropertyInfo? prop = type.GetProperty(OrderBy);
                if (prop != null)
                {
                    return Items.OrderByDescending(o => prop.GetValue(o, null));
                }
            }
        }
        return Items;
    }

    /// <summary>
    /// Gets the row items currently loaded by the table.
    /// </summary>
    public IEnumerable<TItem>? Items { get; private set; }

    /// <summary>
    /// Gets or sets the asynchronous provider used to retrieve items and their total count.
    /// </summary>
    [Parameter]
    public GXItemsProviderDelegate<TItem>? ItemsProvider { get; set; }


    /// <summary>
    /// Gets the CSS classes obtained by combining component defaults with captured attributes.
    /// </summary>
    private string? CssClass => GXComponentAttributes.GetClass(AdditionalAttributes, "table table-striped table-responsive");

    /// <summary>
    /// Adds the row-reordering CSS class when dragging is enabled.
    /// </summary>
    private string? GetCssClass()
    {
        if (RearrangeRows)
        {
            return GXComponentAttributes.CombineClasses(CssClass, "table-rearrange-rows");
        }
        return CssClass;
    }

    /// <summary>
    /// Gets or sets custom content displayed in the table's filter area.
    /// </summary>
    [Parameter]
    public RenderFragment? FilterContent { get; set; }

    /// <summary>
    /// Gets or sets custom content displayed in the table's menu area.
    /// </summary>
    [Parameter]
    public RenderFragment? MenuContent { get; set; }

    /// <summary>
    /// Gets or sets the content rendered inside the table header.
    /// </summary>
    [Parameter]
    public RenderFragment<TItem>? HeaderContent { get; set; }

    /// <summary>
    /// Gets or sets the table's child content, including column and row definitions.
    /// </summary>
    [Parameter]
    public RenderFragment<TItem>? ChildContent { get; set; }

    /// <summary>
    /// Gets or sets the template used to render an item.
    /// </summary>
    [Parameter]
    public RenderFragment<TItem>? ItemContent { get; set; }

    /// <summary>
    /// Removes matching items from the table and updates the rendered selection state.
    /// </summary>
    /// <param name="items">Removed items.</param>
    public void RemoveItems(IEnumerable<TItem> items)
    {
        if (Items != null && items != null && items.Any())
        {
            if (ItemKey != null || typeof(TItem).GetProperty("Id") != null)
            {
                bool updated = false;
                List<TItem> tmp = new List<TItem>(Items);
                foreach (var removed in items)
                {
                    foreach (var it in tmp)
                    {
                        object? value = GetItemKey(removed);
                        if (value != null && value.Equals(GetItemKey(it)))
                        {
                            --TotalCount;
                            _selectedItems.Remove(value);
                            AnyChecked = _selectedItems.Any();
                            if (Compare(Active, it)) Active = default;
                            tmp.Remove(it);
                            updated = true;
                            break;
                        }
                    }
                }
                if (updated)
                {
                    Items = tmp;
                    Pages.Clear();
                    if (!ShowAllData)
                    {
                        for (int pos = 0; pos != TotalPages; ++pos)
                        {
                            Pages.Add(pos);
                        }
                    }
                    InvokeAsync(StateHasChanged);
                }
            }
        }
    }

    /// <summary>
    /// Retrieves items from the provider and optionally requests rendering after a successful load.
    /// </summary>
    /// <param name="renderOnSuccess">Is UI render after success operation.</param>
    public async Task RefreshDataAsync(bool renderOnSuccess)
    {
        _cts?.Cancel();
        _cts = new CancellationTokenSource();
        CancellationToken cancellationToken = _cts.Token;
        GXItemsProviderRequest req = new GXItemsProviderRequest(ShowAllData ? 0 : CurrentPage * PageSize,
            ShowAllData ? 0 : PageSize,
            ShowAllUserData,
            Removed,
            SortMode == SortMode.None ? null : OrderBy,
            SortMode == SortMode.Descending,
            null,
            cancellationToken);
        try
        {
            if (ItemsProvider == null)
            {
                throw new Exception("ItemsProvider not set.");
            }
            var result = await ItemsProvider(req);
            Items = result.Items;
            //Update selected items.
            List<TItem> list = new List<TItem>();
            if (Items != null)
            {
                foreach (var it in _selectedItems)
                {
                    foreach (var it2 in Items)
                    {
                        if (Compare(it.Value, it2))
                        {
                            list.Add(it2);
                            break;
                        }
                    }
                }
            }
            _selectedItems.Clear();
            foreach (var it in list)
            {
                if (it is null)
                {
                    continue;
                }
                object? value = GetItemKey(it);
                if (value != null)
                {
                    _selectedItems.Add(value, it);
                }
            }
            //Select active item again.
            if (Active != null)
            {
                TItem active = Active;
                Active = default;
                if (Items != null)
                {
                    foreach (var it in Items)
                    {
                        if (Compare(active, it))
                        {
                            Active = it;
                            break;
                        }
                    }
                }
            }
            TotalCount = result.TotalItemCount;
            Pages.Clear();
            if (!ShowAllData)
            {
                for (int pos = 0; pos != TotalPages; ++pos)
                {
                    Pages.Add(pos);
                }
            }
            // Only apply result if the task was not canceled.
            if (!cancellationToken.IsCancellationRequested && renderOnSuccess)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            if (ex is OperationCanceledException oce && oce.CancellationToken == cancellationToken)
            {
                // Exception is ignored on cancel.
            }
            else
            {
                NotificationService?.ReportError(ex);
            }
        }
    }

    /// <summary>
    /// Gets or sets the property name used to sort items.
    /// </summary>
    [Parameter]
    public string? OrderBy { get; set; }

    /// <summary>
    /// Gets or sets the direction used to sort the table.
    /// </summary>
    [Parameter]
    public SortMode SortMode { get; set; } = SortMode.None;

    /// <summary>
    /// Refreshes the table after its sort column or direction changes.
    /// </summary>

    public async Task NotificationShortChange()
    {
        if (SortKey is string key && LocalStorage != null && !string.IsNullOrWhiteSpace(OrderBy) && Enum.IsDefined(SortMode))
        {
            try
            {
                await LocalStorage.SetValueAsync(key, System.Text.Json.JsonSerializer.Serialize(new SortPreferences
                {
                    OrderBy = OrderBy,
                    SortMode = SortMode
                }));
            }
            catch (Exception ex)
            {
                NotificationService?.ReportError(ex);
            }
        }
        if (SortChanged.HasDelegate && !string.IsNullOrEmpty(OrderBy))
        {
            await SortChanged.InvokeAsync((SortMode, OrderBy));
        }
        CurrentPage = 0;
        await RefreshDataAsync(true);
    }

    /// <summary>
    /// Returns the row CSS class according to whether its identifier matches the active item.
    /// </summary>
    protected string GetSelectedClass(TItem? active)
    {
        object? current = null, value = null;
        if (active != null)
        {
            value = GetItemKey(active);
        }
        if (Active != null)
        {
            current = GetItemKey(Active);
        }
        return value != null && value.Equals(current) ? "table-info" : "table-striped";
    }

    /// <summary>
    /// Sets the active table row and invokes the row change callback.
    /// </summary>
    public async Task SelectRow(object? selected)
    {
        if (selected is not TItem item)
        {
            return;
        }
        Active = item;
        if (ActiveChanged.HasDelegate)
        {
            await ActiveChanged.InvokeAsync(item);
        }
        if (OnRowChanged.HasDelegate)
        {
            await OnRowChanged.InvokeAsync(item);
        }
        StateHasChanged();
    }

    /// <summary>
    /// Invokes the callback for the selected table cell.
    /// </summary>
    public async Task SelectCell(object selected)
    {
        var item = (TItem)selected;
        Active = item;
        if (ActiveChanged.HasDelegate)
        {
            await ActiveChanged.InvokeAsync(item);
        }
        if (OnRowChanged.HasDelegate)
        {
            await OnRowChanged.InvokeAsync(item);
        }
        if (OnCellChanged.HasDelegate)
        {
            await OnCellChanged.InvokeAsync(item);
        }
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Determines whether every displayed table item is checked.
    /// </summary>
    /// <returns>True, if all the rows are selected.</returns>
    protected string? IsAllSelected()
    {
        if (Items != null && _selectedItems.Count == Items.Count() && Items.Any())
        {
            return "checked";
        }
        return null;
    }

    /// <summary>
    /// Evaluates a row's checkbox state and applies any checked state requested by the callback.
    /// </summary>
    private string? IsCheckboxDisabled(TItem target)
    {
        bool disabled = false;
        bool check = false;
        if (OnCheckboxDisabled != null)
        {
            OnCheckboxDisabled.Invoke(target, out disabled, out check);
        }
        if (check)
        {
            SetRowSelection(target, check);
        }
        if (!disabled)
        {
            return null;
        }
        return "disabled";
    }

    /// <summary>
    /// Determines whether the item is checked or is the active row.
    /// </summary>
    /// <param name="selected">Selected item.</param>
    /// <returns>True, if the row is selected.</returns>
    protected string? IsSelected(TItem? selected)
    {
        bool ret = false;
        if (selected != null)
        {
            object? value = GetItemKey(selected);
            if (value != null)
            {
                ret = _selectedItems.ContainsKey(value);
            }
        }
        if (ret)
        {
            return "checked";
        }
        return null;
    }


    /// <summary>
    /// Compares two table items by their nonnull row identifiers.
    /// </summary>
    private bool Compare(TItem? item1, TItem? item2)
    {
        if (item1 == null || item2 == null)
        {
            return false;
        }
        object? value1 = GetItemKey(item1);
        object? value2 = GetItemKey(item2);
        return value1 == null ? false : value1.Equals(value2);
    }

    /// <summary>
    /// Checks or unchecks all displayed rows and notifies selection callbacks.
    /// </summary>
    /// <param name="select">Selected item</param>
    protected void ToggleAllRow(bool select)
    {
        if (Items != null)
        {
            foreach (var it in Items)
            {
                object? value = GetItemKey(it);
                if (value != null)
                {
                    if (!select && _selectedItems.ContainsKey(value))
                    {
                        _selectedItems.Remove(value);
                    }
                    else if (select && !_selectedItems.ContainsKey(value))
                    {
                        _selectedItems.Add(value, it);
                    }
                }
            }
        }
    }

    /// <summary>
    /// Adds or removes one item from the table's checked-item collection.
    /// </summary>
    /// <param name="selected">Selected item</param>
    /// <param name="select">Is item selected or deselected.</param>
    private void SetRowSelection(TItem? selected, bool select)
    {
        if (selected != null)
        {
            object? value = GetItemKey(selected);
            if (value != null)
            {
                if (!select && _selectedItems.ContainsKey(value))
                {
                    _selectedItems.Remove(value);
                }
                else if (select && !_selectedItems.ContainsKey(value))
                {
                    _selectedItems.Add(value, selected);
                }
            }
            AnyChecked = _selectedItems.Any();


        }
    }

    /// <summary>
    /// Updates a row's checked state and invokes the checked-items and checked-state callbacks.
    /// </summary>
    protected async Task ToggleRow(TItem? selected, bool select)
    {
        SetRowSelection(selected, select);
        await AnyCheckedChanged.InvokeAsync(AnyChecked);
        await OnChecked.InvokeAsync(_selectedItems.Values);
    }
    /// <summary>
    /// Determines whether the named table column is excluded from the configured visible columns.
    /// </summary>
    /// <param name="name">Name of the column.</param>
    /// <returns>True, if table column is hidden.</returns>
    bool IGXTable.IsHidden(string? name)
    {
        var visibleColumns = _columnsInitialized ? _visibleColumns : Columns ?? DefaultColumns;
        if (string.IsNullOrEmpty(name) || visibleColumns == null)
        {
            return false;
        }
        return !visibleColumns.Contains(name, StringComparer.Ordinal);
    }

    /// <summary>
    /// Loads the initial table data from the items provider.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (ColumnWidthsKey != null && Services.GetService<IJSRuntime>() is IJSRuntime js)
        {
            _widthInitialization ??= InitializeColumnResizingAsync(js);
            await _widthInitialization;
        }
        if (firstRender)
        {
            await RefreshDataAsync(true);
        }
    }

    /// <summary>
    /// Cancels any pending request to the items provider.
    /// </summary>
    public void Dispose()
    {
        _disposed = true;
        _showColumnEditor = false;
        _columnDraft = null;
        _columnEditor = null;
        _draftResetWidths = false;
        _cts?.Cancel();
    }

    private async Task InitializeColumnResizingAsync(IJSRuntime js)
    {
        _widthModule = await js.InvokeAsync<IJSObjectReference>("import", "./_content/Gurux.UI.Components/Table/widths.js");
        _widthReference = DotNetObjectReference.Create(this);
        _widthHandler = await _widthModule.InvokeAsync<IJSObjectReference>("initialize", Id, _widthReference);
    }

    /// <summary>Removes browser resize listeners and releases interop references.</summary>
    public async ValueTask DisposeAsync()
    {
        Dispose();
        try
        {
            if (_widthInitialization != null) await _widthInitialization;
            if (_widthHandler != null)
            {
                await _widthHandler.InvokeVoidAsync("dispose");
                await _widthHandler.DisposeAsync();
            }
            if (_widthModule != null) await _widthModule.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        finally { _widthReference?.Dispose(); }
    }
}
