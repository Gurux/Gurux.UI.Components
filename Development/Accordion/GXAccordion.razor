@*
<summary>
Displays collapsible content with a text or templated header.
</summary>
*@

@namespace Gurux.UI.Components.Accordion

@inject NavigationManager NavigationManager
<CascadingValue Value="this">
    <div class="accordion" id="@Id">
        <div class="accordion-item">
            <h2 class="accordion-header" id="@("heading-" + Id)">
                <button type="button" class="@GetButtonClass()" onclick="@(() => Toggle())" aria-expanded="@(IsExpand ? "true" : "false")">
                    @if (HeaderTemplate != null)
                    {
                        @HeaderTemplate
                    }
                    else
                    {
                        @Header
                    }
                </button>
            </h2>
            @if (IsExpand)
            {
                <div id="@("collapse-" + Id)" class="@GetCollapseClass()">
                    <div class="accordion-body">
                        @ChildContent
                    </div>
                </div>
            }
        </div>
    </div>
</CascadingValue>

@code {
    /// <summary>
    /// Gets or sets the current expanded state of the accordion item.
    /// </summary>
    internal bool IsExpand { get; set; }

    /// <summary>
    /// Gets or sets captured HTML attributes forwarded to the underlying element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// Gets the supplied HTML id or a Guid identifier generated once for this component instance.
    /// </summary>
    private string Id => GXComponentAttributes.GetId(AdditionalAttributes, ref _generatedId);

    private string? _generatedId;

    /// <summary>
    /// Gets or sets the initial expanded state of the accordion item.
    /// </summary>
    [Parameter]
    public bool Expand { get; set; }

    /// <summary>
    /// Gets or sets the template rendered in the accordion header.
    /// </summary>
    [Parameter]
    public RenderFragment? HeaderTemplate { get; set; }

    /// <summary>
    /// Gets or sets the accordion header text.
    /// </summary>
    [Parameter]
    public string? Header { get; set; }

    /// <summary>
    /// Gets or sets the content rendered inside the component.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Toggles the accordion's expanded state and schedules rendering.
    /// </summary>
    private void Toggle()
    {
        IsExpand = !IsExpand;
        InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Returns the accordion header button classes for the current expanded state.
    /// </summary>
    private string GetButtonClass()
    {
        if (IsExpand)
        {
            return "accordion-button";
        }
        return "accordion-button collapsed";
    }

    /// <summary>
    /// Returns the accordion body classes for the current expanded state.
    /// </summary>
    private string GetCollapseClass()
    {
        if (IsExpand)
        {
            return "accordion-collapse collapse show";
        }
        return "accordion-collapse collapse";
    }

    /// <summary>
    /// Sets the current expanded state from the initial Expand parameter.
    /// </summary>
    protected override void OnInitialized()
    {
        IsExpand = Expand;
        base.OnInitialized();
    }
}
