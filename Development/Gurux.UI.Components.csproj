<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <Company>Gurux Ltd</Company>
        <Authors>Gurux Ltd</Authors>
        <Copyright>Copyright (c) 1998-2026 Gurux Ltd. All rights reserved.</Copyright>
        <PackageProjectUrl>https://www.gurux.fi</PackageProjectUrl>
        <Description>Reusable Gurux UI components for web, Windows, iOS, and Android applications.</Description>
        <Version Condition=" '$(BUILD_BUILDNUMBER)' == '' ">4.0.2611.1101-local</Version>
        <Version Condition=" '$(BUILD_BUILDNUMBER)' != '' ">$(BUILD_BUILDNUMBER)</Version>
        <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
        <TargetFrameworks>net11.0;net10.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <RepositoryUrl>https://github.com/gurux/gurux.ui.components</RepositoryUrl>
        <PackageTags>UI </PackageTags>
        <PackageId>Gurux.UI.Components</PackageId>
        <PackageIcon>Gurux.UI.Components.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseExpression>GPL-2.0-only</PackageLicenseExpression>
        <ApplicationIcon>Gurux.UI.Components.ico</ApplicationIcon>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>
    <ItemGroup>
        <SupportedPlatform Include="browser" />
    </ItemGroup>
    <!-- ASP.NET versions are managed per target framework. Exclude them from NuGet
         Update All, which otherwise attempts to apply the .NET 11 version to .NET 10.
         Update these explicit versions here when upgrading each target framework. -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.15" IsImplicitlyDefined="true" />
        <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.15" IsImplicitlyDefined="true" />
        <PackageReference Include="System.ServiceModel.Syndication" Version="11.0.0" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
        <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="11.0.0" IsImplicitlyDefined="true" />
        <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="11.0.0" IsImplicitlyDefined="true" />
        <PackageReference Include="System.ServiceModel.Syndication" Version="11.0.0" />
    </ItemGroup>

    <ItemGroup>
        <Compile Update="Properties\Resources.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>Resources.resx</DependentUpon>
        </Compile>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Update="Properties\Resources.resx">
            <Generator>ResXFileCodeGenerator</Generator>
            <LastGenOutput>Resources.Designer.cs</LastGenOutput>
        </EmbeddedResource>
    </ItemGroup>
    <ItemGroup>
        <None Include="Gurux.UI.Components.png" Pack="true" PackagePath="\" />
    </ItemGroup>
    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="TemplateToken\" />
      <Folder Include="wwwroot\" />
    </ItemGroup>
</Project>
