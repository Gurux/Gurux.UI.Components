@*
<summary>
Edits a string value and optionally restores and saves it in browser local storage.
</summary>
*@

@using System.Diagnostics.CodeAnalysis
@using System.Globalization
@using Microsoft.Extensions.Logging

@inject IGXLocalStorage localStorage
@inject ILogger<GXInputText> Logger
<CascadingValue Value="this">
    <input id="@Id"
           type="text"
           value="@Value"
           placeholder="@Placeholder"
           @attributes="AdditionalAttributes" class="@CssClass"
           onchange="@(async (ChangeEventArgs e) => await UpdateString(e.Value))" />
</CascadingValue>

@code
{
    /// <summary>
    /// Gets or sets captured HTML attributes forwarded to the underlying element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// Gets the supplied HTML id or a Guid identifier generated once for this component instance.
    /// </summary>
    private string Id => GXComponentAttributes.GetId(AdditionalAttributes, ref _generatedId);

    private string? _generatedId;

    /// <summary>
    /// Gets or sets whether the component value is restored from and saved to browser local storage using its id.
    /// </summary>
    /// <seealso cref="Id" />
    [Parameter]
    public bool Save { get; set; } = false;

    /// <summary>
    /// Gets or sets whether the input is marked as requiring a value.
    /// </summary>
    [Parameter]
    public bool Required
    {
        get;
        set;
    }

    /// <summary>
    /// Returns the required HTML attribute when a string value is required.
    /// </summary>
    private string? IsRequired()
    {
        return Required ? " required" : null;
    }

    /// <summary>
    /// Gets or sets the string edited by the input.
    /// </summary>
    [Parameter]
    public string? Value
    {
        get;
        set;
    }

    /// <summary>
    /// Gets or sets the callback invoked when the bound value changes.
    /// </summary>
    [Parameter]
    public EventCallback<string?> ValueChanged
    {
        get;
        set;
    }

    /// <summary>
    /// Gets the CSS classes obtained by combining component defaults with captured attributes.
    /// </summary>
    private string? CssClass => GXComponentAttributes.GetClass(AdditionalAttributes, "form-control");

    /// <summary>
    /// Gets or sets the hint displayed when the input has no value.
    /// </summary>
    [Parameter]
    public string? Placeholder { get; set; }

    /// <summary>
    /// Applies the edited input value, notifies the bound value callback, and saves it when persistence is enabled.
    /// </summary>
    private async Task UpdateString(object? value)
    {
        string? tmp = Convert.ToString(value);
        bool change = Value != tmp;
        Value = tmp;
        if (change)
        {
            if (ValueChanged.HasDelegate)
            {
                await ValueChanged.InvokeAsync(Value);
            }
            try
            {
                if (Save && !string.IsNullOrEmpty(Id))
                {
                    await localStorage.SetValueAsync(Id, Convert.ToString(Value));
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex.Message);
            }
        }
    }


    /// <summary>
    /// Restores a saved string value after the first render when persistence is enabled.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (firstRender && Save && !string.IsNullOrEmpty(Id))
        {
            try
            {
                Value = await localStorage.GetValueAsync(Id);
                if (!string.IsNullOrEmpty(Value))
                {
                    if (ValueChanged.HasDelegate)
                    {
                        await ValueChanged.InvokeAsync(Value);
                    }
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex.Message);
            }
        }
    }
}