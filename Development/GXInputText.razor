@*
<summary>
Edits a string value and optionally restores and saves it in browser local storage.
</summary>
*@

@using System.Diagnostics.CodeAnalysis
@using System.Globalization
@using System.Linq.Expressions
@using Microsoft.Extensions.Logging

@inject IGXLocalStorage localStorage
@inject ILogger<GXInputText> Logger
<CascadingValue Value="this">
    <input id="@Id"
           type="text"
           value="@Value"
           placeholder="@Placeholder" required="@Required"
           @attributes="GXComponentAttributes.WithoutCss(AdditionalAttributes)" style="@GXComponentAttributes.GetStyle(AdditionalAttributes)" class="@GXComponentAttributes.GetClass(AdditionalAttributes, "form-control")"
           onchange="@(async (ChangeEventArgs e) => await UpdateString(e.Value))" />
</CascadingValue>

@code
{
    /// <summary>
    /// Gets or sets captured HTML attributes forwarded to the underlying element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// Gets the supplied HTML id or a Guid identifier generated once for this component instance.
    /// </summary>
    protected string Id => GXComponentAttributes.GetId(AdditionalAttributes, ref _generatedId);

    private string? _generatedId;

    /// <summary>
    /// Gets or sets whether the component value is restored from and saved to browser local storage using its id.
    /// </summary>
    /// <seealso cref="Id" />
    [Parameter]
    public bool Save { get; set; } = false;

    /// <summary>
    /// Gets or sets whether the input is marked as requiring a value.
    /// </summary>
    [Parameter]
    public bool Required { get; set; }

    /// <summary>
    /// Returns the required HTML attribute when a string value is required.
    /// </summary>
    private string? IsRequired()
    {
        return Required ? " required" : null;
    }

    /// <summary>
    /// Gets or sets the string edited by the input.
    /// </summary>
    [Parameter]
    public string? Value { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked when the bound value changes.
    /// </summary>
    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>The bound model field, used to notify the containing form of edits.</summary>
    [Parameter]
    public Expression<Func<string?>>? ValueExpression { get; set; }

    /// <summary>The optional containing form; standalone filters do not require one.</summary>
    [CascadingParameter]
    protected EditContext? EditContext { get; set; }

    private void NotifyFieldChanged()
    {
        if (EditContext != null && ValueExpression != null)
        {
            EditContext.NotifyFieldChanged(FieldIdentifier.Create(ValueExpression));
        }
    }
    /// <summary>
    /// Gets or sets the hint displayed when the input has no value.
    /// </summary>
    [Parameter]
    public string? Placeholder { get; set; }

    /// <summary>
    /// Applies the edited input value, notifies the bound value callback, and saves it when persistence is enabled.
    /// </summary>
    protected async Task UpdateString(object? value)
    {
        string? tmp = Convert.ToString(value);
        bool change = Value != tmp;
        Value = tmp;
        if (change)
        {
            if (ValueChanged.HasDelegate)
            {
                await ValueChanged.InvokeAsync(Value);
            }
            NotifyFieldChanged();
            try
            {
                if (Save && !string.IsNullOrEmpty(Id))
                {
                    await localStorage.SetValueAsync(Id, Convert.ToString(Value));
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex.Message);
            }
        }
    }


    /// <summary>
    /// Restores a saved string value after the first render when persistence is enabled.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (firstRender && Save && !string.IsNullOrEmpty(Id))
        {
            try
            {
                var restored = await localStorage.GetValueAsync(Id);
                // A missing entry is not a change; an explicitly saved empty string is.
                if (restored != null && Value != restored)
                {
                    Value = restored;
                    if (ValueChanged.HasDelegate)
                    {
                        await ValueChanged.InvokeAsync(Value);
                    }
                    NotifyFieldChanged();
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex.Message);
            }
        }
    }
}