@*
<summary>
Edits an integer duration using time and optional day inputs in the configured unit.
</summary>
*@

@using Gurux.UI.Components.Enums
@using System.Diagnostics.CodeAnalysis
@using System.Globalization

@typeparam TValue
@inherits InputBase<TValue>
@if (Days == true)
{
    <span class="d-inline-block">
        <input @attributes="AdditionalAttributes" class="@(GXComponentAttributes.CombineClasses("form-control", CssClass))" type="number" step="1" min="0" max="365"
               value="@GetDaysAsString()"
               onchange="@((ChangeEventArgs __e) => SetDaysAsString(__e.Value))" />
        <input class="@(GXComponentAttributes.CombineClasses("form-control", CssClass))" type="time" step="@Step"
               value="@BindConverter.FormatValue(CurrentValueAsString)"
               onchange="@((ChangeEventArgs __e) => SetTimeAsString(__e.Value))" />
    </span>
}
else
{
    <input @attributes="AdditionalAttributes" type="time" class="@(GXComponentAttributes.CombineClasses("form-control", CssClass))" step="@Step" value="@BindConverter.FormatValue(CurrentValueAsString)"
           onchange="@((ChangeEventArgs __e) => CurrentValueAsString = Convert.ToString(__e.Value))" />

}
@code {
    /// <summary>
    /// Gets or sets whether the numeric duration represents seconds, minutes, or hours.
    /// </summary>
    [Parameter]
    public TimeSpanUnit TimeSpanUnit { get; set; } = TimeSpanUnit.Second;

    /// <summary>
    /// Gets or sets whether a separate input for the duration's day component is shown.
    /// </summary>
    [Parameter]
    public bool? Days { get; set; }


    /// <summary>
    /// Gets the HTML time input increment in seconds corresponding to the configured duration unit.
    /// </summary>
    private int Step
    {
        get
        {
            int value = 60;
            switch (TimeSpanUnit)
            {
                case TimeSpanUnit.Second:
                    value = 1;
                    break;
                case TimeSpanUnit.Minute:
                    value = 60;
                    break;
                case TimeSpanUnit.Hour:
                    value = 3600;
                    break;
                default:
                    break;
            }
            return value;
        }
    }



    /// <summary>
    /// Creates the duration input and verifies that its bound type is int or nullable int.
    /// </summary>
    public InputIntegerTimeSpan()
    {
        if ((Nullable.GetUnderlyingType(typeof(TValue)) ?? typeof(TValue)) != typeof(int))
        {
            throw new InvalidOperationException("InputIntegerTimeSpan supports only int and int?.");
        }
    }

    /// <summary>
    /// Gets the current duration converted to its integer representation.
    /// </summary>
    private int IntegerValue => Convert.ToInt32(CurrentValue, CultureInfo.InvariantCulture);
    /// <summary>
    /// Converts an integer duration to the component's supported bound type.
    /// </summary>
    private static TValue FromInteger(int value) => (TValue)(object)value;

    /// <summary>
    /// Parses a TimeSpan to an integer duration and reports empty, invalid, or out-of-range values.
    /// </summary>
    protected override bool TryParseValueFromString(string? value,
        [MaybeNullWhen(false)] out TValue result,
        [NotNullWhen(false)] out string? validationErrorMessage)
    {
        result = default!;
        validationErrorMessage = null;
        if (string.IsNullOrWhiteSpace(value))
        {
            if (Nullable.GetUnderlyingType(typeof(TValue))is not null)
            {
                return true;
            }
            validationErrorMessage = "Enter a time value.";
            return false;
        }
        if (!TimeSpan.TryParse(value, CultureInfo.CurrentCulture, out var time))
        {
            validationErrorMessage = "Enter a valid time value.";
            return false;
        }
        try
        {
            result = FromInteger(checked((int)(TimeSpanUnit switch
            {
                TimeSpanUnit.Second => time.TotalSeconds,
                TimeSpanUnit.Minute => time.TotalMinutes,
                TimeSpanUnit.Hour => time.TotalHours,
                _ => throw new ArgumentOutOfRangeException()
            })));
            return true;
        }
        catch (OverflowException)
        {
            validationErrorMessage = "The time value is too large.";
            return false;
        }
    }

    /// <summary>
    /// Updates the duration's day component while retaining the time-of-day component.
    /// </summary>
    private void SetDaysAsString(object? value)
    {
        if (string.IsNullOrWhiteSpace(Convert.ToString(value)))
        {
            CurrentValueAsString = null;
            return;
        }
        if (int.TryParse(Convert.ToString(value), out int tmp))
        {
            var days = TimeSpan.FromDays(tmp);
            TimeSpan ret;
            switch (TimeSpanUnit)
            {
                case TimeSpanUnit.Second:
                    ret = TimeSpan.FromSeconds(IntegerValue);
                    ret -= TimeSpan.FromDays((int)ret.TotalDays);
                    CurrentValue = FromInteger((int)(days.TotalSeconds + ret.TotalSeconds));
                    break;
                case TimeSpanUnit.Minute:
                    ret = TimeSpan.FromMinutes(IntegerValue);
                    ret -= TimeSpan.FromDays((int)ret.TotalDays);
                    CurrentValue = FromInteger((int)(days.TotalMinutes + ret.TotalMinutes));
                    break;
                case TimeSpanUnit.Hour:
                    ret = TimeSpan.FromHours(IntegerValue);
                    ret -= TimeSpan.FromDays((int)ret.TotalDays);
                    CurrentValue = FromInteger((int)(days.TotalHours + ret.TotalHours));
                    break;
                default:
                    break;
            }
        }
    }

    /// <summary>
    /// Updates the duration's time component while retaining its whole-day component.
    /// </summary>
    private void SetTimeAsString(object? value)
    {
        if (string.IsNullOrWhiteSpace(Convert.ToString(value)))
        {
            CurrentValueAsString = null;
            return;
        }
        if (TimeSpan.TryParse(Convert.ToString(value), out TimeSpan time))
        {
            var days = GetTime(IntegerValue);
            days = TimeSpan.FromDays((int)days.TotalDays);
            switch (TimeSpanUnit)
            {
                case TimeSpanUnit.Second:
                    CurrentValue = FromInteger((int)(days.TotalSeconds + time.TotalSeconds));
                    break;
                case TimeSpanUnit.Minute:
                    CurrentValue = FromInteger((int)(days.TotalMinutes + time.TotalMinutes));
                    break;
                case TimeSpanUnit.Hour:
                    CurrentValue = FromInteger((int)(days.TotalHours + time.TotalHours));
                    break;
            }
        }
    }

    /// <summary>
    /// Returns the current duration's day component for the days input.
    /// </summary>
    private string? GetDaysAsString()
    {
        if (CurrentValue is null)
        {
            return null;
        }
        string? result;
        switch (TimeSpanUnit)
        {
            case TimeSpanUnit.Second:
                result = TimeSpan.FromSeconds(IntegerValue).Days.ToString();
                break;
            case TimeSpanUnit.Minute:
                result = TimeSpan.FromMinutes(IntegerValue).Days.ToString();
                break;
            case TimeSpanUnit.Hour:
                result = TimeSpan.FromHours(IntegerValue).Days.ToString();
                break;
            default:
                result = null;
                break;
        }
        return result;
    }

    /// <summary>
    /// Converts a numeric duration to a TimeSpan using the configured unit.
    /// </summary>
    private TimeSpan GetTime(int value)
    {
        TimeSpan result;
        switch (TimeSpanUnit)
        {
            case TimeSpanUnit.Second:
                result = TimeSpan.FromSeconds(value);
                break;
            case TimeSpanUnit.Minute:
                result = TimeSpan.FromMinutes(value);
                break;
            case TimeSpanUnit.Hour:
                result = TimeSpan.FromHours(value);
                break;
            default:
                throw new ArgumentOutOfRangeException();
        }
        return result;
    }

    /// <summary>
    /// Formats the integer duration as a TimeSpan using the configured unit.
    /// </summary>
    protected override string? FormatValueAsString(TValue? value)
    {
        if (value is null)
        {
            return null;
        }
        int integer = Convert.ToInt32(value, CultureInfo.InvariantCulture);
        string result;
        switch (TimeSpanUnit)
        {
            case TimeSpanUnit.Second:
                result = TimeSpan.FromSeconds(integer).ToString();
                break;
            case TimeSpanUnit.Minute:
                result = TimeSpan.FromMinutes(integer).ToString("hh\\:mm");
                break;
            case TimeSpanUnit.Hour:
                result = TimeSpan.FromHours(integer).ToString();
                break;
            default:
                result = "";
                break;
        }
        return result;
    }
}