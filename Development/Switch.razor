@using Microsoft.Extensions.Logging
@using System.Globalization

@inject IGXLocalStorage localStorage
@inject ILogger<Switch<TItem>> Logger
@typeparam TItem

<CascadingValue Value="this">
    <div class="form-inline">
        @if (!string.IsNullOrEmpty(PreText))
        {
            <label>@PreText</label>
        }
        <div class="form-check form-switch">
            <input id="@Id" class="form-check-input"
                   type="checkbox"
                   checked="@IsChecked()"
                   disabled="@IsDisabled()"
                   onchange="@(async (ChangeEventArgs e) => await UpdateCheck(Convert.ToBoolean(e.Value)))">
            @if (!string.IsNullOrEmpty(Text))
            {
                <label>@Text</label>
            }
            @ChildContent
        </div>
    </div>
</CascadingValue>

@code {
    /// <summary>
    /// Additional attributes that will be applied to the underlying HTML element. If you specify an attribute with the same name as a component parameter, the component parameter value will take precedence.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// Return the id from the AdditionalAttributes.
    /// </summary>
    private string? Id =>
       AdditionalAttributes?.TryGetValue("id", out var value) == true
           ? value?.ToString()
           : null;

    /// <summary>
    /// Whether to store the value in a cookie.
    /// </summary>
    /// <seealso cref="Id"/>see
    [Parameter]
    public bool Save { get; set; } = true;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Switch pre-text.
    /// </summary>
    [Parameter]
    public string? PreText { get; set; }

    /// <summary>
    /// Switch text.
    /// </summary>
    [Parameter]
    public string? Text { get; set; }


    /// <summary>
    /// Is switch disabled
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// Is switch checked
    /// </summary>
    [Parameter]
    public TItem Value { get; set; } = default!;

    /// <summary>
    /// Constructor.
    /// </summary>
    public Switch()
    {
        Type type = Nullable.GetUnderlyingType(typeof(TItem)) ?? typeof(TItem);
        if (type != typeof(bool) && type != typeof(Boolean))
        {
            throw new InvalidOperationException($"Unsupported {GetType()} type param '{type}'.");
        }
    }


    private string? IsChecked()
    {
        if (BindConverter.TryConvertTo<bool>(Value, CultureInfo.InvariantCulture, out var result))
        {
            return result ? "checked" : null;
        }
        throw new Exception("Invalid boolean value.");
    }

    private string? IsDisabled()
    {
        return Disabled ? "disabled" : null;
    }

    private async Task UpdateCheck(bool value)
    {
        var tmp = (TItem)(object)value;
        if (!EqualityComparer<TItem>.Default.Equals(Value, tmp))
        {
            Value = tmp;
            if (ValueChanged.HasDelegate)
            {
                await ValueChanged.InvokeAsync(tmp);
            }
            if (OnChange != null)
            {
                OnChange(tmp);
            }
            try
            {
                if (Save && !string.IsNullOrEmpty(Id))
                {
                    await localStorage.SetValueAsync(Id, Convert.ToString(Value));
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex.Message);
            }
        }
    }

    /// <summary>
    /// Receive notification when user changes the value.
    /// </summary>
    [Parameter]
    public EventCallback<TItem> ValueChanged { get; set; }

    /// <summary>
    /// Receive notification when user changes the value.
    /// </summary>
    [Parameter]
    public Action<TItem>? OnChange { get; set; }

    /// <summary>
    /// Update default cookie value.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (Save && !string.IsNullOrEmpty(Id))
            {
                string? value = await localStorage.GetValueAsync(Id);
                if (!string.IsNullOrEmpty(value))
                {
                    Value = (TItem)(object)bool.Parse(value);
                    if (ValueChanged.HasDelegate)
                    {
                        await ValueChanged.InvokeAsync(Value);
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex.Message);
        }
    }
}