@*
<summary>
Edits a boolean-compatible value using a switch with callbacks and optional persistence.
</summary>
*@

@using Microsoft.Extensions.Logging
@using System.Globalization

@inject IGXLocalStorage localStorage
@inject ILogger<Switch<TItem>> Logger
@typeparam TItem

<CascadingValue Value="this">
    <div class="form-inline">
        @if (!string.IsNullOrEmpty(PreText))
        {
            <label>@PreText</label>
        }
        <div class="form-check form-switch">
            <input id="@Id" class="form-check-input"
                   type="checkbox"
                   checked="@IsChecked()"
                   disabled="@IsDisabled()"
                   onchange="@(async (ChangeEventArgs e) => await UpdateCheck(Convert.ToBoolean(e.Value)))">
            @if (!string.IsNullOrEmpty(Text))
            {
                <label>@Text</label>
            }
            @ChildContent
        </div>
    </div>
</CascadingValue>

@code {
    /// <summary>
    /// Gets or sets captured HTML attributes forwarded to the underlying element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// Gets the supplied HTML id or a Guid identifier generated once for this component instance.
    /// </summary>
    private string Id => GXComponentAttributes.GetId(AdditionalAttributes, ref _generatedId);

    private string? _generatedId;

    /// <summary>
    /// Gets or sets whether the component value is restored from and saved to browser local storage using its id.
    /// </summary>
    /// <seealso cref="Id" />
    [Parameter]
    public bool Save { get; set; } = true;

    /// <summary>
    /// Gets or sets the content rendered inside the component.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Gets or sets the text displayed before the switch.
    /// </summary>
    [Parameter]
    public string? PreText { get; set; }

    /// <summary>
    /// Gets or sets the text displayed by the component.
    /// </summary>
    [Parameter]
    public string? Text { get; set; }


    /// <summary>
    /// Gets or sets whether user interaction with the input is disabled.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// Gets or sets the boolean-compatible value represented by the switch.
    /// </summary>
    [Parameter]
    public TItem Value { get; set; } = default!;

    /// <summary>
    /// Creates the switch and rejects unsupported boolean bound types.
    /// </summary>
    public Switch()
    {
        Type type = Nullable.GetUnderlyingType(typeof(TItem)) ?? typeof(TItem);
        if (type != typeof(bool) && type != typeof(Boolean))
        {
            throw new InvalidOperationException($"Unsupported {GetType()} type param '{type}'.");
        }
    }


    /// <summary>
    /// Converts the bound value to a boolean and returns the checked attribute when it is true.
    /// </summary>
    private string? IsChecked()
    {
        if (BindConverter.TryConvertTo<bool>(Value, CultureInfo.InvariantCulture, out var result))
        {
            return result ? "checked" : null;
        }
        throw new Exception("Invalid boolean value.");
    }

    /// <summary>
    /// Returns the disabled HTML attribute when switch editing is disabled.
    /// </summary>
    private string? IsDisabled()
    {
        return Disabled ? "disabled" : null;
    }

    /// <summary>
    /// Applies a changed checked state, invokes value callbacks, and persists the value when enabled.
    /// </summary>
    private async Task UpdateCheck(bool value)
    {
        var tmp = (TItem)(object)value;
        if (!EqualityComparer<TItem>.Default.Equals(Value, tmp))
        {
            Value = tmp;
            if (ValueChanged.HasDelegate)
            {
                await ValueChanged.InvokeAsync(tmp);
            }
            if (OnChange.HasDelegate)
            {
                await OnChange.InvokeAsync(tmp);
            }
            try
            {
                if (Save && !string.IsNullOrEmpty(Id))
                {
                    await localStorage.SetValueAsync(Id, Convert.ToString(Value));
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex.Message);
            }
        }
    }

    /// <summary>
    /// Gets or sets the callback invoked when the bound value changes.
    /// </summary>
    [Parameter]
    public EventCallback<TItem> ValueChanged { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked when the user changes the value.
    /// </summary>
    [Parameter]
    public EventCallback<TItem> OnChange { get; set; }

    /// <summary>
    /// Restores a saved switch value when persistence is enabled.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (Save && !string.IsNullOrEmpty(Id))
            {
                string? value = await localStorage.GetValueAsync(Id);
                if (!string.IsNullOrEmpty(value))
                {
                    Value = (TItem)(object)bool.Parse(value);
                    if (ValueChanged.HasDelegate)
                    {
                        await ValueChanged.InvokeAsync(Value);
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex.Message);
        }
    }
}