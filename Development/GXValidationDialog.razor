@using Gurux.UI.Components.Help
<Dialog Title="@Title" OkButtonTitle="@OkButtonTitle" CancelButtonTitle="@CancelButtonTitle" OnOk="OnOk" OnCancel="OnCancel"
        HeaderContent="@(string.IsNullOrWhiteSpace(HelpTopic) ? null : RenderHelp)">
    <ChildContent>
        <CascadingValue Value="_context">
            <DataAnnotationsValidator />
            <ValidationSummary />
            @ChildContent
        </CascadingValue>
    </ChildContent>
</Dialog>

@code {
    private RenderFragment RenderHelp => @<div>
        <HelpContext Topic="@(HelpTopic!)" />
        <Help />
    </div>;

    [Parameter] public object? Model { get; set; }
    [Parameter] public EditContext? EditContext { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? HelpTopic { get; set; }
    [Parameter] public string OkButtonTitle { get; set; } = "Save";
    [Parameter] public string CancelButtonTitle { get; set; } = "Cancel";
    [Parameter] public EventCallback OnOk { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private EditContext _context = default!;
    private readonly object _emptyModel = new();
    protected override void OnParametersSet()
    {
        object model = Model ?? _emptyModel;
        if (EditContext != null)
        {
            _context = EditContext;
        }
        else if (_context == null || !ReferenceEquals(_context.Model, model))
        {
            _context = new(model);
        }
    }
}
