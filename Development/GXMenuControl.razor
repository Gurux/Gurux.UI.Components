@*
<summary>
Renders command buttons or a dropdown with configurable right and bottom alignment.
</summary>
*@

@using System.Diagnostics
@using Microsoft.Extensions.Logging
@using Microsoft.AspNetCore.Components.Authorization
@inject ILogger<GXMenuControl> Logger
@inject IServiceProvider Services
@implements IDisposable
@implements IAsyncDisposable
@inherits GXAdaptiveComponentBase
@using Microsoft.JSInterop

<CascadingValue Value="this">
    <div @ref="_adaptiveRoot" @onpointerdown="BeginPress" @onpointermove="MoveLongPress" @onpointerup="CancelLongPress" @onpointercancel="CancelLongPress" @oncontextmenu="OpenContext" @oncontextmenu:preventDefault="IsAdaptive" @attributes="GXComponentAttributes.WithoutCss(AdditionalAttributes)" class="@GXComponentAttributes.GetClass(AdditionalAttributes, AdaptiveClass(Dropdown ? (Submenu ? "btn-group gx-menu-control gx-menu-submenu" : "btn-group gx-menu-control") : "btn-group"))" role="group" style="@GXComponentAttributes.GetStyle(AdditionalAttributes, GetStyle())" @onkeydown="OnKeyDown" @onkeydown:stopPropagation="@(Dropdown && _isOpen)">
        @if (Dropdown)
        {
            <button @ref="_toggle" type="button" class="nav-link btn btn-link gx-menu-toggle" disabled="@(ReadOnly || !Items.Any(IsVisible))"
                    role="@(IsAdaptive && Submenu ? "menuitem" : null)" aria-haspopup="@(IsAdaptive ? "menu" : null)" aria-expanded="@(_isOpen ? "true" : "false")" aria-controls="@_popupId" @onclick="ClickToggle">
                @if (!string.IsNullOrEmpty(Icon))
                {
                    <GXImage Id="@Icon" />
                }
                <GXLocalizedText Value="@Text" />
                <span aria-hidden="true">▾</span>
            </button>
            @if (_isOpen)
            {
                @if (!Submenu)
                {
                    <button type="button" class="gx-menu-dismiss" tabindex="-1" aria-label="Close menu" @onclick="Close" />
                }
                <div role="@(IsAdaptive ? "menu" : null)" id="@_popupId" class="gx-menu-popup @(Submenu ? "gx-menu-popup-nested" : null) @(RightCorner ? "gx-menu-popup-right" : null) @(Bottom ? "gx-menu-popup-above" : null) @(!Submenu && AdaptiveBehavior.Menu == GXMenuPresentation.ActionSheet ? "gx-menu-sheet" : null)">
                    @CommandButtons
                </div>
            }
        }
        else
        {
            @CommandButtons
        }
    </div>
    @ChildContent
</CascadingValue>

@code {
    private RenderFragment CommandButtons => @<text>
        @foreach (GXMenuEntry it in Items.Where(IsVisible))
        {
            @if (it.IsSeparator)
            {
                <hr class="gx-menu-separator" role="separator" />
            }
            else if (it.Children is { Count: > 0 })
            {
                <GXMenuControl @key="it" Dropdown="true" Submenu="true" Text="@it.Text" Icon="@it.Id"
                             ReadOnly="@(ReadOnly || it.ReadOnly)" MenuItems="@it.Children" OnSelected="CloseBranchAsync"
                             ParentCanExecute="@(() => CanExecuteAsync(it))" />
            }
            else
            {
            <button @attributes="GXComponentAttributes.WithoutCss(it.AdditionalAttributes)" type="button" role="@(IsAdaptive ? "menuitem" : null)" class="@GXComponentAttributes.GetClass(it.AdditionalAttributes, "btn button")" disabled="@(ReadOnly || it.ReadOnly)" style="@GetButtonStyle(it)" @onclick="() => SelectAsync(it)">
                @if (!string.IsNullOrEmpty(it.Image))
                {
                    <GXImage Value="@it.Image" />
                }
                else if (!string.IsNullOrEmpty(it.Id))
                {
                    <GXImage Id="@it.Id" />
                }
                &nbsp;
                <GXLocalizedText Value="@it.Text" />
            </button>
            }
        }
    </text>;

    /// <summary>Renders a labelled dropdown instead of a row of command buttons.</summary>
    [Parameter]
    public bool Dropdown { get; set; }

    /// <summary>Expands inside a parent popup, using the parent's outside-click dismissal.</summary>
    [Parameter]
    public bool Submenu { get; set; }

    /// <summary>Notifies an enclosing menu when a descendant command is selected.</summary>
    [Parameter]
    public EventCallback OnSelected { get; set; }

    /// <summary>Resource key or text displayed on the dropdown toggle.</summary>
    [Parameter]
    public string? Text { get; set; }

    /// <summary>Optional resource icon displayed on the dropdown toggle.</summary>
    [Parameter]
    public string? Icon { get; set; }

    /// <summary>Disables the toggle and all commands in this control.</summary>
    [Parameter]
    public bool ReadOnly { get; set; }

    private readonly string _popupId = $"gx-menu-{Guid.NewGuid():N}";
    private ElementReference _toggle;
    private bool _isOpen;
    private bool _disposed;
    private GXCommandAuthorization? _authorization;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    /// <summary>Checks whether the enclosing command branch is still executable.</summary>
    [Parameter]
    public Func<Task<bool>>? ParentCanExecute { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _authorization = new GXCommandAuthorization(Services, () =>
        {
            if (!_disposed)
            {
                _ = InvokeAsync(RefreshAuthorizationAsync);
            }
        });
    }

    protected override Task OnParametersSetAsync() => EvaluateAuthorizationAsync();

    internal async Task RefreshAuthorizationAsync()
    {
        await EvaluateAuthorizationAsync();
        if (!_disposed)
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task EvaluateAuthorizationAsync()
    {
        if (_disposed || _authorization == null)
        {
            return;
        }
        await _authorization.RefreshAsync(Policies(Items).ToArray(), AuthenticationState);
        if (!_disposed && !Items.Any(IsVisible))
        {
            Close();
        }
    }

    private static IEnumerable<string?> Policies(IEnumerable<GXMenuEntry> items)
    {
        foreach (var item in items)
        {
            yield return item.Policy;
            if (item.Children != null)
            {
                foreach (var policy in Policies(item.Children))
                    {
                        yield return policy;
                    }
            }
        }
    }

    private bool IsVisible(GXMenuEntry item) => !_disposed && _authorization?.IsAllowed(item.Policy) == true &&
        (item.Children is not { Count: > 0 } || item.Children.Any(IsVisible));

    private async Task<bool> CanExecuteAsync(GXMenuEntry item)
    {
        if (_disposed || ReadOnly || item.ReadOnly || item.IsSeparator || !Items.Contains(item) || _authorization == null)
        {
            return false;
        }
        var policy = item.Policy;
        var authorizationVersion = _authorization.Version;
        if (ParentCanExecute != null && !await ParentCanExecute())
        {
            return false;
        }
        if (!await _authorization.CanExecuteAsync(policy, AuthenticationState))
        {
            return false;
        }
        if (ParentCanExecute != null && !await ParentCanExecute())
        {
            return false;
        }
        return !_disposed && authorizationVersion == _authorization.Version && !ReadOnly && !item.ReadOnly &&
            !item.IsSeparator && Items.Contains(item) && policy == item.Policy;
    }

    private ElementReference _adaptiveRoot;
    private IJSObjectReference? _adaptiveModule;
    private bool _adaptiveFocused;
    private Task ClickToggle() => ConsumeLongPressClick() ? Task.CompletedTask : Toggle();
    private Task BeginPress(PointerEventArgs args) => StartLongPressAsync(args, () => !_isOpen && Dropdown ? Toggle() : Task.CompletedTask);
    private Task OpenContext()
    {
        MarkContextGestureHandled();
        return IsAdaptive && Dropdown && !_isOpen ? Toggle() : Task.CompletedTask;
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsAdaptive && _isOpen && Services.GetService(typeof(IJSRuntime)) is IJSRuntime runtime)
        {
            _adaptiveModule ??= await GetComponentModuleAsync(runtime, "./_content/Gurux.UI.Components/ContextMenu/GXContextMenuController.razor.js");
            if (!_disposed && _adaptiveModule != null)
            {
                await _adaptiveModule.InvokeVoidAsync("configureMenu", _adaptiveRoot, IsAdaptive && _isOpen);
            }
            if (!_disposed && IsAdaptive && _isOpen && _adaptiveModule != null && !_adaptiveFocused)
            {
                _adaptiveFocused = true;
                await _adaptiveModule.InvokeVoidAsync("focusMenu", _adaptiveRoot, "Home");
            }
        }
        else
        {
            _adaptiveFocused = false;
            if (_adaptiveModule != null)
            {
                await _adaptiveModule.InvokeVoidAsync("configureMenu", _adaptiveRoot, false);
            }
        }
    }
    private Task? _browserDisposal;
    public async ValueTask DisposeAsync()
    {
        Dispose();
        if (_browserDisposal != null)
        {
            await _browserDisposal;
        }
    }
    private async Task ReleaseBrowserAsync()
    {
        try
        {
            if (_adaptiveModule != null)
            {
                await _adaptiveModule.InvokeVoidAsync("configureMenu", _adaptiveRoot, false);
            }
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or OperationCanceledException) { }
        finally { await ReleaseComponentModulesAsync(); }
    }

    private async Task Toggle()
    {
        if (_disposed || ReadOnly)
        {
            return;
        }
        if (_isOpen) { Close(); return; }
        if (ParentCanExecute != null && !await ParentCanExecute())
        {
            return;
        }
        await RefreshAuthorizationAsync();
        if (ParentCanExecute != null && !await ParentCanExecute())
        {
            return;
        }
        if (!_disposed && !ReadOnly && Items.Any(IsVisible))
        {
            _isOpen = true;
        }
    }

    private void Close() => _isOpen = false;

    private async Task CloseBranchAsync()
    {
        Close();
        await OnSelected.InvokeAsync();
    }

    private async Task OnKeyDown(KeyboardEventArgs args)
    {
        if (IsAdaptive && Dropdown && !_isOpen && (args.Key == "ArrowDown" || Submenu && args.Key == "ArrowRight"))
        {
            await Toggle();
        }
        else if (Dropdown && _isOpen && (args.Key == "Escape" || IsAdaptive && Submenu && args.Key == "ArrowLeft"))
        {
            Close();
            await _toggle.FocusAsync(preventScroll: true);
        }
        else if (IsAdaptive && Dropdown && _isOpen && _adaptiveModule != null && args.Key is "ArrowDown" or "ArrowUp" or "Home" or "End")
        {
            await _adaptiveModule.InvokeVoidAsync("focusMenu", _adaptiveRoot, args.Key);
        }
    }

    private async Task SelectAsync(GXMenuEntry item)
    {
        if (!await CanExecuteAsync(item))
        {
            return;
        }
        // Invoke directly after the final authorization check. Public selection notifications
        // must not change policy/registration between authorization and the command callback.
        Close();
        try { await item.OnClick.InvokeAsync(); }
        finally { if (!_disposed)
        {
            await CloseBranchAsync();
        } }
    }

    /// <summary>
    /// Gets or sets captured HTML attributes forwarded to the underlying element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// Gets or sets the content rendered inside the component.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Gets or sets whether the menu is aligned to the right.
    /// </summary>
    [Parameter]
    public bool RightCorner { get; set; }

    /// <summary>
    /// Gets or sets whether the menu is positioned at the bottom.
    /// </summary>
    [Parameter]
    public bool Bottom { get; set; }

    /// <summary>
    /// Combines a menu item's captured styles with the component's button styling.
    /// </summary>
    private string? GetButtonStyle(GXMenuEntry item)
        => GXComponentAttributes.GetStyle(item.AdditionalAttributes, RightCorner ? "background-color: dodgerblue;" : null);
    /// <summary>
    /// Returns positioning styles for the menu's right and bottom alignment options.
    /// </summary>
    private string? GetStyle()
    {
        if (RightCorner)
        {
            if (Bottom)
            {
                return "position: fixed;bottom: 20px;right: 20px;";
            }
            return "float: right;";
        }
        if (Bottom)
        {
            return "position: absolute; bottom:0;";
        }
        return null;
    }

    /// <summary>
    /// Gets or sets commands supplied as data, in addition to declarative child items.
    /// </summary>
    [Parameter]
    public List<GXMenuEntry>? MenuItems { get; set; }

    private readonly List<GXMenuEntry> _childItems = new();
    private IEnumerable<GXMenuEntry> Items => (MenuItems ?? Enumerable.Empty<GXMenuEntry>()).Concat(_childItems);

    /// <summary>
    /// Registers a child menu item with the containing menu.
    /// </summary>
    /// <param name="item">Menu item</param>
    internal void AddMenuItem(GXMenuEntry item)
    {
        _childItems.Add(item);
        InvokeAsync(StateHasChanged);
    }

    /// <summary>Unregisters a declarative command when its component is removed.</summary>
    internal void RemoveMenuItem(GXMenuEntry item)
    {
        if (_childItems.Remove(item) && !_disposed)
        {
            _ = InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>Stops child removal notifications from scheduling renders during disposal.</summary>
    public void Dispose()
    {
        if (_disposed)
        {
            return;
        }
        _disposed = true;
        DisposeAdaptiveBehavior();
        _authorization?.Dispose();
        _childItems.Clear();
        _browserDisposal = ReleaseBrowserAsync();
    }

    /// <summary>
    /// Closes the popup if its toggle becomes disabled or the control becomes flat.
    /// </summary>
    protected override void OnParametersSet()
    {
        if (ReadOnly || !Dropdown)
        {
            Close();
        }
    }
}
