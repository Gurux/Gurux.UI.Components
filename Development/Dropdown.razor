@using Microsoft.AspNetCore.Components.Web.Virtualization
@using Microsoft.Extensions.Logging
@using System.Linq.Expressions
@using System.Diagnostics

@typeparam TItem
@inject IGXLocalStorage localStorage
@inject ILogger<Dropdown<TItem>> Logger

@if (Items != null)
{
    <select id="@Id"
            @ref="_element"
            class="form-select"
            value="@Value"
            onchange="@((ChangeEventArgs e) => SelectionChanged(e))">
        @foreach (var it in Items)
        {
            <option value="@it">@it</option>
        }
    </select>
}

@code {
    [Parameter]
    public Expression<Func<TItem?>>? ValueExpression { get; set; }

    private ElementReference _element;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
    }

    /// <summary>
    /// Additional attributes that will be applied to the underlying HTML element. If you specify an attribute with the same name as a component parameter, the component parameter value will take precedence.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// Return the id from the AdditionalAttributes.
    /// </summary>
    private string? Id =>
       AdditionalAttributes?.TryGetValue("id", out var value) == true
           ? value?.ToString()
           : null;

    /// <summary>
    /// Whether to store the value in a cookie.
    /// </summary>
    /// <seealso cref="Id"/>see
    [Parameter]
    public bool Save { get; set; } = true;

    /// <summary>
    /// Selected item.
    /// </summary>
    [Parameter]
    public TItem? Value
    {
        get;
        set;
    }

    /// <summary>
    /// Notified when the selected value is changed.
    /// </summary>
    [Parameter]
    public EventCallback<TItem?> ValueChanged
    {
        get;
        set;
    }

    /// <summary>
    /// Notified when the selected item is changed.
    /// </summary>
    [Parameter]
    public EventCallback<TItem> OnSelected { get; set; }

    [Parameter]
    public string? CssClass { get; set; }

    /// <summary>
    /// Is the drop down control disabled.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    private async Task SelectionChanged(ChangeEventArgs e)
    {
        Value = default;
        if (Items != null)
        {
            foreach (TItem it in Items)
            {
                if (it?.ToString() == e.Value?.ToString())
                {
                    Value = it;
                    break;
                }
            }
        }
        if (ValueChanged.HasDelegate)
        {
            await ValueChanged.InvokeAsync(Value);
        }
        if (OnSelected.HasDelegate)
        {
            await OnSelected.InvokeAsync(Value);
        }
        try
        {
            if (Save && !string.IsNullOrEmpty(Id))
            {
                await localStorage.SetValueAsync(Id, Convert.ToString(Value));
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex.Message);
        }
    }

    /// <summary>
    /// Update default cookie value.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        try
        {
            //Get the default value from the cookies
            // if it's not set.
            if (Save && Items != null && !string.IsNullOrEmpty(Id))
            {
                string? value = await localStorage.GetValueAsync(Id);
                if (!string.IsNullOrEmpty(value))
                {
                    foreach (var it in Items)
                    {
                        if (it != null &&
                            it.ToString() == value)
                        {
                            if (Value?.GetHashCode() != it.GetHashCode())
                            {
                                Value = it;
                                if (ValueChanged.HasDelegate)
                                {
                                    await ValueChanged.InvokeAsync(it);
                                }
                                if (OnSelected.HasDelegate)
                                {
                                    await OnSelected.InvokeAsync(it);
                                }
                            }
                            break;
                        }
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex.Message);
        }
    }

    /// <summary>
    /// Possible static values.
    /// </summary>
    /// <remarks>
    /// If values are added they are not asked from the Gurux.DLMS.AMI.
    /// </remarks>
    [Parameter]
    public IEnumerable<TItem>? Items
    {
        get;
        set;
    }
}
