@*
<summary>
Renders a typed dropdown with static items, selection callbacks, and optional value persistence.
</summary>
*@

@using Microsoft.AspNetCore.Components.Web.Virtualization
@using Microsoft.Extensions.Logging
@using System.Linq.Expressions
@using System.Diagnostics

@typeparam TItem
@inject IGXLocalStorage localStorage
@inject ILogger<Dropdown<TItem>> Logger

@if (Items != null)
{
    <select @attributes="GXComponentAttributes.WithoutCss(AdditionalAttributes)" id="@Id"
            @ref="_element"
            class="@CssClass" style="@GXComponentAttributes.GetStyle(AdditionalAttributes)" disabled="@Disabled"
            value="@Value"
            onchange="@((ChangeEventArgs e) => SelectionChanged(e))">
        @foreach (var it in Items)
        {
            <option value="@it">@it</option>
        }
    </select>
}

@code {
    /// <summary>
    /// Gets or sets the expression identifying the bound value for form validation.
    /// </summary>
    [Parameter]
    public Expression<Func<TItem?>>? ValueExpression { get; set; }

    private ElementReference _element;

    /// <summary>
    /// Completes the base component's post-render lifecycle.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
    }

    /// <summary>
    /// Gets or sets captured HTML attributes forwarded to the underlying element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// Gets the supplied HTML id or a Guid identifier generated once for this component instance.
    /// </summary>
    private string Id => GXComponentAttributes.GetId(AdditionalAttributes, ref _generatedId);

    private string? _generatedId;

    /// <summary>
    /// Gets or sets whether the component value is restored from and saved to browser local storage using its id.
    /// </summary>
    /// <seealso cref="Id" />
    [Parameter]
    public bool Save { get; set; } = true;

    /// <summary>
    /// Gets or sets the selected dropdown item.
    /// </summary>
    [Parameter]
    public TItem? Value
    {
        get;
        set;
    }

    /// <summary>
    /// Gets or sets the callback invoked when the bound value changes.
    /// </summary>
    [Parameter]
    public EventCallback<TItem?> ValueChanged
    {
        get;
        set;
    }

    /// <summary>
    /// Gets or sets the callback invoked when the user selects an item.
    /// </summary>
    [Parameter]
    public EventCallback<TItem> OnSelected { get; set; }

    /// <summary>
    /// Gets the CSS classes obtained by combining component defaults with captured attributes.
    /// </summary>
    private string? CssClass => GXComponentAttributes.GetClass(AdditionalAttributes, "form-select");

    /// <summary>
    /// Gets or sets whether user interaction with the input is disabled.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// Updates the selected item, notifies selection callbacks, and saves the value when persistence is enabled.
    /// </summary>
    private async Task SelectionChanged(ChangeEventArgs e)
    {
        Value = default;
        if (Items != null)
        {
            foreach (TItem it in Items)
            {
                if (it?.ToString() == e.Value?.ToString())
                {
                    Value = it;
                    break;
                }
            }
        }
        if (ValueChanged.HasDelegate)
        {
            await ValueChanged.InvokeAsync(Value);
        }
        if (OnSelected.HasDelegate)
        {
            await OnSelected.InvokeAsync(Value);
        }
        try
        {
            if (Save && !string.IsNullOrEmpty(Id))
            {
                await localStorage.SetValueAsync(Id, Convert.ToString(Value));
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex.Message);
        }
    }

    /// <summary>
    /// Restores the saved dropdown selection when value persistence is enabled.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        try
        {
            //Get the default value from the cookies
            // if it's not set.
            if (Save && Items != null && !string.IsNullOrEmpty(Id))
            {
                string? value = await localStorage.GetValueAsync(Id);
                if (!string.IsNullOrEmpty(value))
                {
                    foreach (var it in Items)
                    {
                        if (it != null &&
                            it.ToString() == value)
                        {
                            if (Value?.GetHashCode() != it.GetHashCode())
                            {
                                Value = it;
                                if (ValueChanged.HasDelegate)
                                {
                                    await ValueChanged.InvokeAsync(it);
                                }
                                if (OnSelected.HasDelegate)
                                {
                                    await OnSelected.InvokeAsync(it);
                                }
                            }
                            break;
                        }
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex.Message);
        }
    }

    /// <summary>
    /// Gets or sets the items available for display or selection.
    /// </summary>
    /// <remarks> If values are added they are not asked from the Gurux.DLMS.AMI. </remarks>
    [Parameter]
    public IEnumerable<TItem>? Items
    {
        get;
        set;
    }
}
