@*
<summary>
Registers tab pages, resolves the active page, and renders headers for accessible tabs.
</summary>
*@

@*
Usage example in a Razor component:

@using Gurux.UI.Components.Tab

<GXTabControl InitialTab="0" SelectionChanged="OnTabSelectionChanged">
    <GXTabPage Text="General">
        <p>General settings.</p>
    </GXTabPage>
    <GXTabPage Text="Details">
        <p>Additional details.</p>
    </GXTabPage>
</GXTabControl>

<p>Selected tab: @selectedTab</p>

@code {
    private string selectedTab = "General";

    private void OnTabSelectionChanged(GXTabPage page)
    {
        selectedTab = page.Text;
    }
}

InitialTab is a zero-based index and defaults to 0 (the first tab).
SelectionChanged is optional and is called when the selection changes,
not when the initial tab is registered.
Set TabPage.Path to navigate to a URL when the tab is clicked.
*@

@namespace Gurux.UI.Components.Tab
@using System.Diagnostics
@using Microsoft.AspNetCore.Components.Routing
@implements IDisposable

@inject NavigationManager NavigationManager
@inject IServiceProvider Services

<CascadingValue Value="_scope">
<CascadingValue Value="this">
    <ul class="nav nav-tabs @(StickyHeader ? "gx-sticky-tabs" : null)"
        role="tablist"
        style="width:100%">
        @foreach (var it in GetPages())
        {
            <li class="nav-item" role="presentation">
                <button type="button" class="@GetActiveClass(it)"
                        @onclick="@( () => ActivatePage(it))">
                    @if (TabTextTemplate != null)
                    {
                        @TabTextTemplate(it)
                    }
                    else
                    {
                        @if (!string.IsNullOrEmpty(@it.Icon))
                        {
                            <GXTabIcon Id="@it.Icon" Color="@it.IconColor" />
                        }
                        @it.Text
                    }
                </button>
            </li>
        }
    </ul>
    @ChildContent
</CascadingValue>
</CascadingValue>

@code {
    /// <summary>Nesting information for tab controls.</summary>
    public sealed record TabScope(int Depth);
    /// <summary>Parent tab nesting information.</summary>
    [CascadingParameter] public TabScope? ParentScope { get; set; }
    /// <summary>Persists selection in tab, tab2 and subsequent URL query parameters.</summary>
    [Parameter] public bool PersistSelectionInUrl { get; set; }
    /// <summary>Optional application-specific routing group.</summary>
    [Parameter] public string? RouteGroup { get; set; }
    /// <summary>Optional routing adapter; otherwise uses the registered adapter or query-only routing.</summary>
    [Parameter] public ITabRouteResolver? RouteResolver { get; set; }
    private TabScope _scope = new(1);
    private string? _activeFallback;
    private int Depth => ParentScope?.Depth ?? 0;
    private ITabRouteResolver? EffectiveRouteResolver => RouteResolver ?? Services.GetService(typeof(ITabRouteResolver)) as ITabRouteResolver;

    /// <inheritdoc />
    public override Task SetParametersAsync(ParameterView parameters)
    {
        parameters.SetParameterProperties(this);
        if (!parameters.TryGetValue<bool>(nameof(StickyHeader), out _))
        {
            StickyHeader = !PersistSelectionInUrl || Depth == 0;
        }
        _activeFallback = parameters.TryGetValue<string?>(nameof(Active), out var active) ? active : null;
        _scope = new(Depth + 1);
        if (PersistSelectionInUrl)
        {
            Active = ReadActive();
        }
        return base.SetParametersAsync(ParameterView.Empty);
    }

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        base.OnInitialized();
        NavigationManager.LocationChanged += LocationChanged;
    }

    private string? ReadActive() => EffectiveRouteResolver is { } resolver
        ? resolver.GetActive(NavigationManager, RouteGroup, Depth, _activeFallback)
        : TabUrlState.Active(NavigationManager, Depth, _activeFallback);

    private void LocationChanged(object? sender, LocationChangedEventArgs args)
    {
        if (!PersistSelectionInUrl || disposed)
        {
            return;
        }
        _ = InvokeAsync(() =>
        {
            if (disposed)
            {
                return;
            }
            Active = ReadActive();
            OnParametersSet();
            StateHasChanged();
        });
    }

    private async Task NotifySelectionAsync(GXTabPage page, bool navigateToPath)
    {
        if (PersistSelectionInUrl)
        {
            await SelectionChanged.InvokeAsync(page);
            var tab = string.IsNullOrWhiteSpace(page.Path) ? page.Text : page.Path;
            if (!string.IsNullOrWhiteSpace(tab))
            {
                var url = EffectiveRouteResolver is { } resolver
                    ? resolver.GetSelectionUrl(NavigationManager, RouteGroup, Depth, tab)
                    : TabUrlState.SelectionUrl(NavigationManager, Depth, tab);
                if (!string.Equals(NavigationManager.Uri, url, StringComparison.Ordinal))
                {
                    NavigationManager.NavigateTo(url);
                }
            }
        }
        else
        {
            if (navigateToPath && NavigateOnSelection && !string.IsNullOrEmpty(page.Path))
            {
                NavigationManager.NavigateTo(page.Path);
            }
            await SelectionChanged.InvokeAsync(page);
        }
    }

    /// <summary>Keeps headers at the top of their scrolling container; defaults to true, except for nested controls using URL persistence.</summary>
    [Parameter]
    public bool StickyHeader { get; set; } = true;

    /// <summary>
    /// Gets or sets the tab page components registered inside the tab control.
    /// </summary>

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Gets or sets the zero-based index of the initially selected tab; defaults to the first tab.
    /// </summary>
    [Parameter]
    public int InitialTab { get; set; } = 0;

    /// <summary>
    /// Gets or sets the path of the tab that should be selected when resolving the active page.
    /// </summary>
    [Parameter]
    public string? Active { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked for user-driven tab selection changes.
    /// </summary>
    [Parameter]
    public EventCallback<GXTabPage> SelectionChanged { get; set; }

    /// <summary>Navigate to a tab's path when URL selection persistence is disabled; disable for tabs inside an edit form.</summary>
    [Parameter]
    public bool NavigateOnSelection { get; set; } = true;

    /// <summary>
    /// Gets or sets the template used to render each tab header.
    /// </summary>
    [Parameter]
    public RenderFragment<GXTabPage>? TabTextTemplate { get; set; }

    private GXTabPage? activePage;
    private bool disposed;
    private bool userSelected;
    private GXTabPage? selectedPage;
    private string? previousActive;
    private (GXTabPage Page, string Text, string? Icon, string? IconColor, string? Path, string? Padge, int Count, TraceLevel Type)[] previousHeaders = [];
    /// <summary>
    /// Gets or sets the active registered tab, rejecting inaccessible pages.
    /// </summary>
    public GXTabPage? ActivePage
    {
        get => activePage;
        set
        {
            if (value != null && (!value.IsAccessible || !Pages.Contains(value)) || ReferenceEquals(activePage, value))
            {
                return;
            }
            activePage = value;
            foreach (var page in Pages)
            {
                page.RequestRender();
            }
        }
    }

    /// <summary>
    /// Returns registered tab pages that are visible and authorized for the current user.
    /// </summary>
    IEnumerable<GXTabPage> GetPages()
    {
        return Pages.Where(w => w.IsAccessible);
    }

    private readonly List<GXTabPage> Pages = new List<GXTabPage>();
    /// <summary>
    /// Unregisters a tab, updates page indices, and resolves the remaining active tab.
    /// </summary>
    internal void RemovePage(GXTabPage page)
    {
        if (!Pages.Remove(page))
        {
            return;
        }
        if (selectedPage == page)
        {
            selectedPage = null;
        }
        for (int index = 0; index < Pages.Count; ++index)
        {
            Pages[index].Index = index;
        }
        if (ActivePage == page)
        {
            ActivePage = null;
        }
        PageChanged(null);
    }

    /// <summary>
    /// Registers a tab page, assigns its index, and resolves the active page.
    /// </summary>
    internal void AddPage(GXTabPage tabPage)
    {
        tabPage.Index = Pages.Count;
        Pages.Add(tabPage);
        PageChanged(tabPage);
    }

    /// <summary>
    /// Reconciles the requested active path and resolves the selected page.
    /// </summary>
    protected override void OnParametersSet()
    {
        if (Active != previousActive)
        {
            previousActive = Active;
            userSelected = false;
            if (PersistSelectionInUrl)
            {
                selectedPage = null;
                ActivePage = null;
            }
        }
        PageChanged(null);
    }

    /// <summary>
    /// Resolves the active tab from user selection, requested path, and initial index, then refreshes changed headers.
    /// </summary>
    internal void PageChanged(GXTabPage? changed)
    {
        if (disposed)
        {
            return;
        }
        var before = ActivePage;
        var desired = Pages.FirstOrDefault(page => page.IsAccessible && (!string.IsNullOrEmpty(page.Path) ? page.Path == Active : PersistSelectionInUrl && page.Text == Active));
        if (userSelected && selectedPage?.IsAccessible == true && Pages.Contains(selectedPage))
        {
            ActivePage = selectedPage;
        }
        else if (!userSelected && desired != null)
        {
            ActivePage = desired;
        }
        else if (changed?.IsAccessible == true && (changed.Active || !userSelected && changed.Index == InitialTab))
        {
            ActivePage = changed;
        }
        else if (ActivePage?.IsAccessible != true)
        {
            ActivePage = Pages.ElementAtOrDefault(InitialTab)is { IsAccessible: true } initial ? initial : Pages.FirstOrDefault(page => page.IsAccessible);
        }
        var headers = GetPages().Select(page => (page, page.Text, page.Icon, page.IconColor, page.Path, page.Padge, page.PadgeCount, page.PadgeType)).ToArray();
        if (!ReferenceEquals(before, ActivePage) || !previousHeaders.SequenceEqual(headers))
        {
            previousHeaders = headers;
            _ = InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>
    /// Returns the tab header classes indicating whether the page is active.
    /// </summary>
    string GetActiveClass(GXTabPage page)
    {
        return page == ActivePage ? "nav-link active" : "nav-link";
    }

    /// <summary>
    /// Selects an accessible tab and invokes the selection callback.
    /// </summary>
    async Task ActivatePage(GXTabPage page)
    {
        if (!page.IsAccessible)
        {
            return;
        }
        userSelected = true;
        selectedPage = page;
        ActivePage = page;
        await NotifySelectionAsync(page, navigateToPath: true);
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Selects an accessible tab and invokes the selection callback.
    /// </summary>
    public async Task ActivatePage(int index)
    {
        if (index >= 0 && Pages.Count > index && Pages[index].IsAccessible)
        {
            userSelected = true;
            selectedPage = Pages[index];
            ActivePage = Pages[index];
            await NotifySelectionAsync(ActivePage, navigateToPath: false);
            Update();
        }
    }

    /// <summary>
    /// Requests rendering of the component's current state.
    /// </summary>
    public void Update()
    {
        InvokeAsync(StateHasChanged);
    }
    /// <summary>
    /// Marks the tab control as disposed to stop subsequent page updates.
    /// </summary>
    public void Dispose()
    {
        disposed = true;
        NavigationManager.LocationChanged -= LocationChanged;
    }
}
