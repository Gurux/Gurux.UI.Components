@*
<summary>
Reads selected or dropped files and publishes their bytes with progress and error reporting.
</summary>
*@

@using System.Text;
@using System.Globalization;
@using Microsoft.JSInterop
@typeparam TType

@implements IAsyncDisposable
@inject IServiceProvider Services

<fieldset @attributes="GXComponentAttributes.WithoutCss(AdditionalAttributes)" disabled="@Disabled" class="@GXComponentAttributes.GetClass(AdditionalAttributes)" style="@GXComponentAttributes.GetStyle(AdditionalAttributes, Style)">
    <div @ref="_dropZoneElement"
         class="drop-zone" style="width:100%;height:100%">
        <p><GXInputFile @ref="_inputFile" Filter="@Filter" OnChange="@LoadFile" /></p>
        @ChildContent
    </div>
</fieldset>
@code {


    /// <summary>
    /// Gets or sets captured HTML attributes forwarded to the underlying element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// Gets the optional service used to report component errors as notifications.
    /// </summary>
    public IGXNotificationService? NotificationService { get; private set; }

    /// <summary>
    /// Gets the optional service used to track and cancel asynchronous operations.
    /// </summary>
    public IGXProgress? Progress { get; private set; }


    /// <summary>
    /// Resolves the optional notification and progress services used during file loading.
    /// </summary>
    protected override void OnInitialized()
    {
        NotificationService = Services.GetService<IGXNotificationService>();
        Progress = Services.GetService<IGXProgress>();
    }

    /// <summary>
    /// Gets or sets the JavaScript runtime used to interact with browser APIs.
    /// </summary>
    [Inject]
    public IJSRuntime? JSRuntime { get; set; }

    /// <summary>
    /// Gets or sets the content rendered inside the component.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Gets or sets the accepted file types passed to the file input.
    /// </summary>
    [Parameter]
    public string? Filter { get; set; }

    /// <summary>
    /// Gets or sets whether user interaction with the input is disabled.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// Gets or sets the selected file content as ASCII text or a byte array.
    /// </summary>
    [Parameter]
    public TType? Value { get; set; }

    /// <summary>
    /// Gets or sets inline CSS declarations for the file selector.
    /// </summary>
    [Parameter]
    public string? Style { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked when the bound value changes.
    /// </summary>
    [Parameter]
    public EventCallback<TType?> ValueChanged { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked before reading a selected file.
    /// </summary>
    [Parameter]
    public EventCallback<string> OnLoading { get; set; }

    /// <summary>
    /// Gets or sets the maximum file size accepted for reading, in bytes.
    /// </summary>
    [Parameter]
    public int MaxFileSize { get; set; } = 512000;

    /// <summary>
    /// Gets or sets the callback invoked after a selected file has been read successfully.
    /// </summary>
    [Parameter]
    public EventCallback<(TType? Value, string FileName)> OnLoaded { get; set; }

    private ElementReference _dropZoneElement;
    private GXInputFile? _inputFile;
    private IJSObjectReference? _dropZoneInstance;
    private IJSObjectReference? _module;

    /// <summary>
    /// Reads the selected file within the size limit and publishes its content and loading callbacks.
    /// </summary>
    private async Task LoadFile(InputFileChangeEventArgs e)
    {
        if (Disabled)
        {
            return;
        }
        try
        {
            using var progress = Progress?.ProgressStart(null);
            await OnLoading.InvokeAsync(e.File.Name);
            using var ms = new MemoryStream();
            using (var stream = e.File.OpenReadStream(MaxFileSize))
            {
                await stream.CopyToAsync(ms);
            }
            if (typeof(TType) == typeof(string))
            {
                string str = ASCIIEncoding.ASCII.GetString(ms.ToArray());
                if (BindConverter.TryConvertTo<TType>(str,
                    CultureInfo.InvariantCulture, out TType? value))
                {
                    Value = value;
                    await ValueChanged.InvokeAsync(Value);
                    await OnLoaded.InvokeAsync((Value, e.File.Name));
                }
                else
                {
                    throw new Exception("Invalid file content.");
                }
            }
            else if (typeof(TType) == typeof(byte[]))
            {
                var tmp = ms.ToArray();
                Value = (TType)(object)tmp;
                await ValueChanged.InvokeAsync(Value);
                await OnLoaded.InvokeAsync((Value, e.File.Name));
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    /// <summary>
    /// Initializes the browser drag-and-drop handler after the file input is first rendered.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && JSRuntime != null)
        {
            _module = await JSRuntime.InvokeAsync<IJSObjectReference>("import",
                "./_content/Gurux.UI.Components/FileSelector/drop.js");
            if (_inputFile == null)
            {
                throw new ArgumentNullException("inputFile");
            }
            try
            {
                _dropZoneInstance = await _module.InvokeAsync<IJSObjectReference>("initializeFileDropZone",
                    _dropZoneElement, _inputFile.Element);
            }
            catch (Exception ex)
            {
                NotificationService?.ReportError(ex);
            }
        }
    }

    /// <summary>
    /// Disconnects the drag-and-drop handler and releases its JavaScript instance.
    /// </summary>
    public async ValueTask DisposeAsync()
    {
        if (_dropZoneInstance != null)
        {
            await _dropZoneInstance.InvokeVoidAsync("dispose");
            await _dropZoneInstance.DisposeAsync();
        }
    }
}
