@using Gurux.UI.Components.Enums

@inject NavigationManager NavigationManager
@implements IDisposable
@inject GXHelpService HelpService

@if (!HelpService.IsHidden(NavigationManager.Uri))
{
    <a class="help-link"
       href="@HelpService.HelpUrl"
       target="_blank"
       rel="noopener noreferrer"
       aria-label="Help"
       title="Help">
        @if (!string.IsNullOrEmpty(HelpService.Image))
        {
            <Image Value="@HelpService.Image" id="help"></Image>
        }
        else
        {
            <svg class="help-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false">
                <path d="M8 7a4 4 0 0 1 8 0c0 3-4 3-4 6" />
                <circle cx="12" cy="18" r="1" fill="currentColor" stroke="none" />
            </svg>
        }
    </a>
}

@code {
    protected override void OnInitialized()
    {
        HelpService.Changed += OnHelpChanged;
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnHelpChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        HelpService.Changed -= OnHelpChanged;
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}


