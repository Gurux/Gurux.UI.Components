@*
<summary>
Registers a contextual help topic for the lifetime of the component.
*@

@implements IDisposable
@inject IServiceProvider Services

@code {
    /// <summary>Name of the cascading value containing the active tab's full help topic.</summary>
    public const string ScopeName = "GXHelpTopic";

    private GXHelpService? _helpService;

    /// <summary>
    /// Gets or sets the contextual help topic registered while this component is present.
    /// </summary>
    [Parameter]
    [EditorRequired]
    public string Topic { get; set; } = string.Empty;

    /// <summary>Optional stable tab key appended to the page topic.</summary>
    [Parameter]
    public string? Tab { get; set; }

    /// <summary>The active containing tab supplies its topic to shared child components.</summary>
    [CascadingParameter(Name = ScopeName)]
    private string? InheritedTopic { get; set; }

    private string EffectiveTopic
    {
        get
        {
            var topic = ((string.IsNullOrWhiteSpace(InheritedTopic) ? Topic : InheritedTopic) ?? string.Empty).Trim().Trim('.');
            var tab = Tab?.Trim().Trim('.');
            return string.IsNullOrEmpty(tab) ? topic : string.IsNullOrEmpty(topic) ? tab : topic + "." + tab;
        }
    }

    /// <summary>
    /// Registers or updates this component's help topic with the help service.
    /// </summary>
    protected override void OnParametersSet()
    {
        _helpService = Services.GetService<GXHelpService>();
        _helpService?.SetContext(this, EffectiveTopic);
    }

    /// <summary>
    /// Unregisters this component's contextual help topic.
    /// </summary>
    public void Dispose()
    {
        _helpService?.RemoveContext(this);
    }
}
