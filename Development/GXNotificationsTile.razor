@*
<summary>
Displays stored notifications using severity filters, field settings, and optional close buttons.
</summary>
*@


@namespace Gurux.UI.Components
@using Gurux.UI.Components.Enums
@using Gurux.UI.Components.TemplateToken
@implements IDisposable

@inject IGXNotificationService NotificationService

@if (_visibleNotifications.Count != 0)
{
    <ul class="notification-list list-unstyled mt-3 mb-0 text-start"
        aria-label="Notifications">
        @foreach (GXNotificationItem notification in _visibleNotifications)
        {
            <li @key="notification.Id" class="@GetDivClass(notification)" role="@GetRole(notification)">
                @if (notification.Closable)
                {
                    <button type="button" class="btn-close" aria-label="Close" @onclick="() => Close(notification.Id)">
                    </button>
                }
                @if (NotificationService.VisibleFields.HasFlag(NotificationFields.Title) && (notification.TitleContent != null || !string.IsNullOrWhiteSpace(notification.Title)))
                {
                    <h4 class="alert-heading">
                        @if (notification.TitleContent != null) { @notification.TitleContent }
                        else { <GXTemplateTokenText Text="@notification.Title" /> }
                    </h4>
                }
                @if (NotificationService.VisibleFields.HasFlag(NotificationFields.CreatedAt))
                {
                    <div class="small text-muted">
                        <time datetime="@notification.CreatedAt.ToString("O")">@notification.CreatedAt.ToLocalTime().ToString("g")</time>
                    </div>
                }
                @if (NotificationService.VisibleFields.HasFlag(NotificationFields.Id))
                {
                    <div class="small text-muted">Id: @notification.Id</div>
                }
                <div style="white-space: pre-wrap; overflow-wrap: anywhere;"><GXTemplateTokenText Text="@notification.Description" /></div>
            </li>
        }
    </ul>
}
@ChildContent

@code
{
    /// <summary>
    /// Gets or sets the content rendered inside the component.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private readonly List<GXNotificationItem> _visibleNotifications = new();
    private bool _disposed;

    /// <summary>
    /// Subscribes to notification service changes.
    /// </summary>
    protected override void OnInitialized()
    {
        NotificationService.Changed += OnChanged;
    }

    /// <summary>
    /// Refreshes the visible notification snapshot using the latest display settings.
    /// </summary>
    protected override void OnParametersSet() => UpdateVisibleNotifications();

    /// <summary>
    /// Rebuilds the displayed notification list using severity flags, newest-first ordering, and the display limit.
    /// </summary>
    private void UpdateVisibleNotifications()
    {
        IEnumerable<GXNotificationItem> notifications = NotificationService.Notifications
            .Where(notification => (notification.Level & NotificationService.LevelFilter) != NotificationLevel.None)
            .OrderByDescending(notification => notification.CreatedAt);

        int maxVisibleNotifications = NotificationService.MaxVisibleNotifications;
        if (maxVisibleNotifications > 0)
        {
            notifications = notifications.Take(maxVisibleNotifications);
        }

        _visibleNotifications.Clear();
        _visibleNotifications.AddRange(notifications);
    }

    /// <summary>
    /// Removes the selected notification or toast from its backing service.
    /// </summary>
    private void Close(Guid id)
    {
        NotificationService.Remove(id);
        UpdateVisibleNotifications();
    }

    /// <summary>
    /// Schedules a component render when the backing service changes, unless the component is disposed.
    /// </summary>
    private void OnChanged()
    {
        if (_disposed)
        {
            return;
        }
        _ = InvokeAsync(() =>
        {
            if (_disposed)
            {
                return;
            }
            UpdateVisibleNotifications();
            StateHasChanged();
        });
    }

    /// <summary>
    /// Detaches the notification change handler and prevents subsequent UI updates.
    /// </summary>
    public void Dispose()
    {
        _disposed = true;
        NotificationService.Changed -= OnChanged;
    }

    /// <summary>
    /// Returns alert classes matching the notification severity and whether its close button is enabled.
    /// </summary>
    private static string GetDivClass(GXNotificationItem item)
    {
        string style = item.Level switch
        {
            NotificationLevel.Information => "alert-info",
            NotificationLevel.Success => "alert-success",
            NotificationLevel.Warning => "alert-warning",
            NotificationLevel.Error => "alert-danger",
            _ => "alert-info"
        };
        return $"alert {style} fade show" + (item.Closable ? " alert-dismissible" : "");
    }

    /// <summary>
    /// Uses alert for warning and error notifications and status for other severities.
    /// </summary>
    private static string GetRole(GXNotificationItem item) =>
        item.Level is NotificationLevel.Warning or NotificationLevel.Error ? "alert" : "status";
}


