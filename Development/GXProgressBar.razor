@*
<summary>
Displays a progress value within a configured range and optional descriptive text.
</summary>
*@


@if (Maximum != 0)
{
    <div @attributes="GXComponentAttributes.WithoutCss(AdditionalAttributes)" class="@GXComponentAttributes.GetClass(AdditionalAttributes, "progress")" style="@GXComponentAttributes.GetStyle(AdditionalAttributes)">
        <div class="progress-bar" role="progressbar" aria-valuenow="@Current"
             aria-valuemin="@Minimum" aria-valuemax="@Maximum"
             style="@CurrentPercentToString()">
            <span class="sr-only">@Description</span>
        </div>
    </div>
}

@code {
    /// <summary>
    /// Gets or sets captured HTML attributes forwarded to the underlying element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// Gets or sets the text describing the current progress operation.
    /// </summary>
    [Parameter]
    public string? Description { get; set; }

    /// <summary>
    /// Gets or sets the lower bound of the progress range.
    /// </summary>
    [Parameter]
    public int Minimum { get; set; }

    /// <summary>
    /// Gets or sets the upper bound of the progress range.
    /// </summary>
    [Parameter]
    public int Maximum { get; set; }

    /// <summary>
    /// Gets or sets the current progress value.
    /// </summary>
    [Parameter]
    public int Current { get; set; }

    /// <summary>
    /// Calculates the current progress percentage from the configured range, returning zero for a zero current or maximum value.
    /// </summary>
    private int CurrentPercent()
    {
        return Current == 0 || Maximum == 0 ? 0 :
        (100 * Current / (Maximum - Minimum));
    }

    /// <summary>
    /// Formats the current progress percentage as a CSS width declaration.
    /// </summary>
    private string CurrentPercentToString()
    {
        return string.Format("width:{0}%",
        CurrentPercent());
    }

    /// <summary>
    /// Sets the progress range and resets the current value to the supplied minimum.
    /// </summary>
    public void Reset(int minimum, int maximum)
    {
        Current = Minimum = minimum;
        Maximum = maximum;
        InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Advances progress up to the maximum, optionally updates its description, and rerenders when the percentage changes.
    /// </summary>
    /// <param name="value">Steps.</param>
    /// <param name="description">Description.</param>
    public void Step(int value = 1, string? description = null)
    {
        int old = CurrentPercent();
        Current += value;
        if (Current > Maximum)
        {
            Current = Maximum;
        }
        if (description != null)
        {
            Description = description;
        }
        if (old != CurrentPercent())
        {
            //UI is updated only when percent changes.
            InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>
    /// Combines the progress bar's base class with its custom class attribute.
    /// </summary>
    private string GetClass()
    {
        return "progress-bar" + Class;
    }

    /// <summary>
    /// Gets the custom CSS class attribute applied to the progress bar.
    /// </summary>
    /// <remarks> The contextual classes that can be used with progress bars are: <ul><li>progress-bar-success</li><li>progress-bar-info</li><li>progress-bar-warning</li><li>progress-bar-danger</li><li>progress-bar-striped</li></ul></remarks>
    private string? Class => GXComponentAttributes.GetValue(AdditionalAttributes, "class");
}