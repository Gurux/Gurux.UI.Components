@*
<summary>
Displays registered context menu items and manages pointer activation and delayed closing.
</summary>
*@

@using System.Timers
@using Microsoft.AspNetCore.Components.Web;
<div tabindex="0"
     onclick="@((MouseEventArgs e) => HandleClick(e))"
     @oncontextmenu="OnContextMenu"
     @onblur="OnBlur"
     @onmouseup="HandleMouseUp"
     @oncontextmenu:preventDefault="true">
    <Tooltip Title="More options"><label>&vellip;</label></Tooltip>
</div>

<CascadingValue Value="this">
    <div class="contextmenu"
         style="@($"z-index:1000; visibility:{GetVisibility()};")">
        @if (_show)
        {
            <ul class="contextmenuitems">
                @foreach (ContextMenuItem it in Items)
                {
                    <li tabindex="@GetTabIndex()" class="contextmenuitem" onclick="@(async () => it.Click())">
                        @if (!string.IsNullOrEmpty(it.Image))
                        {
                            <Image Value="@it.Image"></Image>
                        }
                        else if (!string.IsNullOrEmpty(it.Id))
                        {
                            <Image Id="@it.Id"></Image>
                        }
                        &nbsp;
                        @it.Text
                    </li>
                }
            </ul>
        }
    </div>
    @ChildContent
</CascadingValue>

@code {
    /// <summary>
    /// Returns the CSS visibility value for the context menu's current open state.
    /// </summary>
    string GetVisibility()
    {
        if (_show)
        {
            return "visible";
        }
        return "hidden";
    }
    protected bool _show;

    /// <summary>
    /// Contect menu items.
    /// </summary>
    List<ContextMenuItem> Items = new List<ContextMenuItem>();

    int _index = 0;
    System.Timers.Timer _timer = new System.Timers.Timer();

    /// <summary>
    /// Allocates the next tab index for a context menu entry.
    /// </summary>
    private string GetTabIndex()
    {
        ++_index;
        return _index.ToString();
    }


    /// <summary>
    /// Opens the context menu when the primary mouse button is clicked.
    /// </summary>
    void HandleClick(MouseEventArgs args)
    {
        if (args.Button == 0)
        {
            Show();
        }
    }

    /// <summary>
    /// Opens the context menu in response to a context menu event.
    /// </summary>
    void OnContextMenu(MouseEventArgs args)
    {
        Show();
    }

    /// <summary>
    /// Stops the delayed context menu close timer after a mouse button is released.
    /// </summary>
    void HandleMouseUp(MouseEventArgs args)
    {
        //        Show();
        _timer.Stop();
    }

    /// <summary>
    /// Starts the delayed close timer when the context menu loses focus.
    /// </summary>
    void OnBlur(FocusEventArgs args)
    {
        _timer.Interval = 300;
        _timer.AutoReset = true;
        _timer.Elapsed += TimerElapsed;
        _timer.Start();
    }

    /// <summary>
    /// Hides the context menu and stops its delayed close timer.
    /// </summary>
    private void TimerElapsed(object? sender, ElapsedEventArgs e)
    {
        Hide();
        _timer.Stop();
    }

    /// <summary>
    /// Gets or sets the content rendered inside the component.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Displays the context menu.
    /// </summary>
    internal void Show()
    {
        _show = true;
        InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Hides the context menu.
    /// </summary>
    internal void Hide()
    {
        if (_show)
        {
            _show = false;
            InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>
    /// Registers a child menu item with the containing menu.
    /// </summary>
    /// <param name="menu">New menu item.</param>
    internal void AddMenuItem(ContextMenuItem menu)
    {
        Items.Add(menu);
    }
}
