@*
<summary>
Displays registered context menu items and manages pointer activation and delayed closing.
</summary>
*@

@using System.Timers
@using Microsoft.AspNetCore.Components.Web;
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Authorization
@inject IJSRuntime JS
@inject IServiceProvider Services
@implements IAsyncDisposable
@inherits GXAdaptiveComponentBase
<div @ref="_trigger" tabindex="0" role="@(IsAdaptive ? "button" : null)" aria-haspopup="@(IsAdaptive ? "menu" : null)" aria-expanded="@(IsAdaptive ? _show.ToString().ToLowerInvariant() : null)"
     @onkeydown="OnMenuKeyDown" @onpointerdown="BeginPress" @onpointermove="MoveLongPress" @onpointerup="CancelLongPress" @onpointercancel="CancelLongPress"
     onclick="@((MouseEventArgs e) => HandleClick(e))"
     @oncontextmenu="OnContextMenu"
     @onblur="OnBlur"
     @onmouseup="HandleMouseUp"
     @oncontextmenu:preventDefault="true">
    <GXTooltip Title="More options"><label>&vellip;</label></GXTooltip>
</div>

<CascadingValue Value="this">
    <div @ref="_menu" class="@AdaptiveClass("contextmenu" + (AdaptiveBehavior.Menu == GXMenuPresentation.ActionSheet ? " gx-menu-sheet" : ""))" role="@(IsAdaptive ? "menu" : null)" @onkeydown="OnMenuKeyDown" popover="manual"
         style="@($"z-index:1000; visibility:{GetVisibility()};")">
        @if (_show)
        {
            <ul class="contextmenuitems">
                @foreach (GXContextMenuItem it in Items.Where(it => _authorization?.IsAllowed(it.Policy) == true))
                {
                    <li tabindex="@(IsAdaptive ? "-1" : GetTabIndex())" role="@(IsAdaptive ? "menuitem" : null)" class="contextmenuitem" onclick="@it.ClickAsync">
                        @if (!string.IsNullOrEmpty(it.Image))
                        {
                            <GXImage Value="@it.Image"></GXImage>
                        }
                        else if (!string.IsNullOrEmpty(it.Id))
                        {
                            <GXImage Id="@it.Id"></GXImage>
                        }
                        &nbsp;
                        @it.Text
                    </li>
                }
                @if (IsAdaptive && AdaptiveBehavior.Menu == GXMenuPresentation.ActionSheet)
                {
                    <li role="presentation"><button type="button" class="btn btn-secondary w-100" @onclick="Hide">@Gurux.UI.Components.Appearance.GXAppearanceText.Get("Cancel")</button></li>
                }
            </ul>
        }
    </div>
    @ChildContent
</CascadingValue>

@code {
    private ElementReference _trigger;
    private ElementReference _menu;
    private IJSObjectReference? _module;
    private GXCommandAuthorization? _authorization;
    private bool _disposed;
    private bool _triggerConfigured;
    private DotNetObjectReference<GXContextMenuController>? _adaptiveReference;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _authorization = new GXCommandAuthorization(Services, AuthorizationInvalidated);
    }

    protected override Task OnParametersSetAsync() => RefreshAuthorizationAsync();

    private void AuthorizationInvalidated()
    {
        if (!_disposed)
        {
            _ = InvokeAsync(async () =>
            {
                if (_disposed)
                {
                    return;
                }
                await RefreshAuthorizationAsync();
                if (!_disposed)
                {
                    StateHasChanged();
                }
            });
        }
    }

    private Task RefreshAuthorizationAsync() => _authorization == null || _disposed
        ? Task.CompletedTask
        : _authorization.RefreshAsync(Items.Select(item => item.Policy).ToArray(), AuthenticationState);

    internal async Task<bool> CanExecuteAsync(GXContextMenuItem item)
    {
        if (_disposed || !Items.Contains(item) || _authorization == null)
        {
            return false;
        }
        var policy = item.Policy;
        return await _authorization.CanExecuteAsync(policy, AuthenticationState)
            && !_disposed && Items.Contains(item) && string.Equals(policy, item.Policy, StringComparison.Ordinal);
    }

    internal async Task MenuItemChangedAsync()
    {
        if (_disposed)
        {
            return;
        }
        await RefreshAuthorizationAsync();
        if (!_disposed)
        {
            StateHasChanged();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed)
        {
            return;
        }
        if ((IsAdaptive || _triggerConfigured) && !_disposed)
        {
            _module ??= await GetComponentModuleAsync(JS, "./_content/Gurux.UI.Components/ContextMenu/GXContextMenuController.razor.js");
            if (_disposed || _module == null)
            {
                return;
            }
            await _module.InvokeVoidAsync("configureTrigger", _trigger, IsAdaptive);
            _triggerConfigured = IsAdaptive;
        }
        if (_show)
        {
            _module ??= await GetComponentModuleAsync(JS, "./_content/Gurux.UI.Components/ContextMenu/GXContextMenuController.razor.js");
            if (_disposed || _module == null)
            {
                return;
            }
            if (IsAdaptive)
            {
                _adaptiveReference ??= DotNetObjectReference.Create(this);
            }
            await _module.InvokeVoidAsync("show", _menu, _trigger, new { adaptive = IsAdaptive, sheet = AdaptiveBehavior.Menu == GXMenuPresentation.ActionSheet }, _adaptiveReference);
        }
        else if (_module != null)
        {
            await _module.InvokeVoidAsync("hide", _menu);
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        DisposeAdaptiveBehavior();
        _authorization?.Dispose();
        _adaptiveReference?.Dispose();
        Items.Clear();
        _timer.Stop();
        _timer.Dispose();
        try
        {
            if (_module != null)
            {
                await _module.InvokeVoidAsync("hide", _menu);
                await _module.InvokeVoidAsync("configureTrigger", _trigger, false);
            }
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or OperationCanceledException) { }
        finally { await ReleaseComponentModulesAsync(); }
    }

    /// <summary>
    /// Returns the CSS visibility value for the context menu's current open state.
    /// </summary>
    string GetVisibility()
    {
        if (_show)
        {
            return "visible";
        }
        return "hidden";
    }
    protected bool _show;

    /// <summary>
    /// Contect menu items.
    /// </summary>
    List<GXContextMenuItem> Items = new List<GXContextMenuItem>();

    int _index = 0;
    System.Timers.Timer _timer = new System.Timers.Timer();

    /// <summary>
    /// Allocates the next tab index for a context menu entry.
    /// </summary>
    private string GetTabIndex()
    {
        ++_index;
        return _index.ToString();
    }


    /// <summary>
    /// Opens the context menu when the primary mouse button is clicked.
    /// </summary>
    void HandleClick(MouseEventArgs args)
    {
        if (!ConsumeLongPressClick() && args.Button == 0)
        {
            Show();
        }
    }

    /// <summary>
    /// Opens the context menu in response to a context menu event.
    /// </summary>
    [JSInvokable]
    public Task DismissMenu()
    {
        if (!_disposed)
        {
            Hide();
        }
        return Task.CompletedTask;
    }

    private Task BeginPress(PointerEventArgs args) => StartLongPressAsync(args, () => { Show(); return Task.CompletedTask; });

    private async Task OnMenuKeyDown(KeyboardEventArgs args)
    {
        if (!IsAdaptive)
        {
            return;
        }
        if (args.Key == "Escape")
        {
            Hide();
            await _trigger.FocusAsync(preventScroll: true);
        }
        else if (!_show && (args.Key is "Enter" or " " or "ContextMenu" || args.Key == "F10" && args.ShiftKey))
        {
            Show();
        }
        else if (_show && _module != null && args.Key is "ArrowDown" or "ArrowUp" or "Home" or "End")
        {
            await _module.InvokeVoidAsync("focusMenu", _menu, args.Key);
        }
    }

    void OnContextMenu(MouseEventArgs args)
    {
        MarkContextGestureHandled();
        Show();
    }

    /// <summary>
    /// Stops the delayed context menu close timer after a mouse button is released.
    /// </summary>
    void HandleMouseUp(MouseEventArgs args)
    {
        //        Show();
        _timer.Stop();
    }

    /// <summary>
    /// Starts the delayed close timer when the context menu loses focus.
    /// </summary>
    void OnBlur(FocusEventArgs args)
    {
        if (IsAdaptive)
        {
            _timer.Stop();
            return;
        }
        _timer.Interval = 300;
        _timer.AutoReset = true;
        _timer.Elapsed += TimerElapsed;
        _timer.Start();
    }

    /// <summary>
    /// Hides the context menu and stops its delayed close timer.
    /// </summary>
    private void TimerElapsed(object? sender, ElapsedEventArgs e)
    {
        Hide();
        _timer.Stop();
    }

    /// <summary>
    /// Gets or sets the content rendered inside the component.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Displays the context menu.
    /// </summary>
    internal void Show()
    {
        if (_disposed)
        {
            return;
        }
        _timer.Stop();
        _show = true;
        InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Hides the context menu.
    /// </summary>
    internal void Hide()
    {
        if (_show)
        {
            _show = false;
            InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>
    /// Registers a child menu item with the containing menu.
    /// </summary>
    /// <param name="menu">New menu item.</param>
    internal void AddMenuItem(GXContextMenuItem menu)
    {
        if (!_disposed && !Items.Contains(menu))
        {
            Items.Add(menu);
        }
    }

    internal void RemoveMenuItem(GXContextMenuItem menu)
    {
        if (Items.Remove(menu) && !_disposed)
        {
            _ = InvokeAsync(MenuItemChangedAsync);
        }
    }
}
