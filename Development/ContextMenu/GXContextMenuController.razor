@*
<summary>
Displays registered context menu items and manages pointer activation and delayed closing.
</summary>
*@

@using System.Timers
@using Microsoft.AspNetCore.Components.Web;
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Authorization
@inject IJSRuntime JS
@inject IServiceProvider Services
@implements IAsyncDisposable
<div @ref="_trigger" tabindex="0"
     onclick="@((MouseEventArgs e) => HandleClick(e))"
     @oncontextmenu="OnContextMenu"
     @onblur="OnBlur"
     @onmouseup="HandleMouseUp"
     @oncontextmenu:preventDefault="true">
    <GXTooltip Title="More options"><label>&vellip;</label></GXTooltip>
</div>

<CascadingValue Value="this">
    <div @ref="_menu" class="contextmenu" popover="manual"
         style="@($"z-index:1000; visibility:{GetVisibility()};")">
        @if (_show)
        {
            <ul class="contextmenuitems">
                @foreach (GXContextMenuItem it in Items.Where(it => _authorization?.IsAllowed(it.Policy) == true))
                {
                    <li tabindex="@GetTabIndex()" class="contextmenuitem" onclick="@it.ClickAsync">
                        @if (!string.IsNullOrEmpty(it.Image))
                        {
                            <GXImage Value="@it.Image"></GXImage>
                        }
                        else if (!string.IsNullOrEmpty(it.Id))
                        {
                            <GXImage Id="@it.Id"></GXImage>
                        }
                        &nbsp;
                        @it.Text
                    </li>
                }
            </ul>
        }
    </div>
    @ChildContent
</CascadingValue>

@code {
    private ElementReference _trigger;
    private ElementReference _menu;
    private IJSObjectReference? _module;
    private GXCommandAuthorization? _authorization;
    private bool _disposed;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    protected override void OnInitialized()
    {
        _authorization = new GXCommandAuthorization(Services, AuthorizationInvalidated);
    }

    protected override Task OnParametersSetAsync() => RefreshAuthorizationAsync();

    private void AuthorizationInvalidated()
    {
        if (!_disposed)
        {
            _ = InvokeAsync(async () =>
            {
                if (_disposed)
                {
                    return;
                }
                await RefreshAuthorizationAsync();
                if (!_disposed)
                {
                    StateHasChanged();
                }
            });
        }
    }

    private Task RefreshAuthorizationAsync() => _authorization == null || _disposed
        ? Task.CompletedTask
        : _authorization.RefreshAsync(Items.Select(item => item.Policy).ToArray(), AuthenticationState);

    internal async Task<bool> CanExecuteAsync(GXContextMenuItem item)
    {
        if (_disposed || !Items.Contains(item) || _authorization == null)
        {
            return false;
        }
        var policy = item.Policy;
        return await _authorization.CanExecuteAsync(policy, AuthenticationState)
            && !_disposed && Items.Contains(item) && string.Equals(policy, item.Policy, StringComparison.Ordinal);
    }

    internal async Task MenuItemChangedAsync()
    {
        if (_disposed)
        {
            return;
        }
        await RefreshAuthorizationAsync();
        if (!_disposed)
        {
            StateHasChanged();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_show)
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Gurux.UI.Components/ContextMenu/GXContextMenuController.razor.js");
            await _module.InvokeVoidAsync("show", _menu, _trigger);
        }
        else if (_module != null)
        {
            await _module.InvokeVoidAsync("hide", _menu);
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _authorization?.Dispose();
        Items.Clear();
        _timer.Stop();
        _timer.Dispose();
        if (_module != null)
        {
            try
            {
                await _module.InvokeVoidAsync("hide", _menu);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
        }
    }

    /// <summary>
    /// Returns the CSS visibility value for the context menu's current open state.
    /// </summary>
    string GetVisibility()
    {
        if (_show)
        {
            return "visible";
        }
        return "hidden";
    }
    protected bool _show;

    /// <summary>
    /// Contect menu items.
    /// </summary>
    List<GXContextMenuItem> Items = new List<GXContextMenuItem>();

    int _index = 0;
    System.Timers.Timer _timer = new System.Timers.Timer();

    /// <summary>
    /// Allocates the next tab index for a context menu entry.
    /// </summary>
    private string GetTabIndex()
    {
        ++_index;
        return _index.ToString();
    }


    /// <summary>
    /// Opens the context menu when the primary mouse button is clicked.
    /// </summary>
    void HandleClick(MouseEventArgs args)
    {
        if (args.Button == 0)
        {
            Show();
        }
    }

    /// <summary>
    /// Opens the context menu in response to a context menu event.
    /// </summary>
    void OnContextMenu(MouseEventArgs args)
    {
        Show();
    }

    /// <summary>
    /// Stops the delayed context menu close timer after a mouse button is released.
    /// </summary>
    void HandleMouseUp(MouseEventArgs args)
    {
        //        Show();
        _timer.Stop();
    }

    /// <summary>
    /// Starts the delayed close timer when the context menu loses focus.
    /// </summary>
    void OnBlur(FocusEventArgs args)
    {
        _timer.Interval = 300;
        _timer.AutoReset = true;
        _timer.Elapsed += TimerElapsed;
        _timer.Start();
    }

    /// <summary>
    /// Hides the context menu and stops its delayed close timer.
    /// </summary>
    private void TimerElapsed(object? sender, ElapsedEventArgs e)
    {
        Hide();
        _timer.Stop();
    }

    /// <summary>
    /// Gets or sets the content rendered inside the component.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Displays the context menu.
    /// </summary>
    internal void Show()
    {
        if (_disposed)
        {
            return;
        }
        _show = true;
        InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Hides the context menu.
    /// </summary>
    internal void Hide()
    {
        if (_show)
        {
            _show = false;
            InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>
    /// Registers a child menu item with the containing menu.
    /// </summary>
    /// <param name="menu">New menu item.</param>
    internal void AddMenuItem(GXContextMenuItem menu)
    {
        if (!_disposed && !Items.Contains(menu))
        {
            Items.Add(menu);
        }
    }

    internal void RemoveMenuItem(GXContextMenuItem menu)
    {
        if (Items.Remove(menu) && !_disposed)
        {
            _ = InvokeAsync(MenuItemChangedAsync);
        }
    }
}
