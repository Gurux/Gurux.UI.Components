@*
<summary>
Defines an authorized context menu command with a label, icon, link, and click callback.
</summary>
*@

@implements IDisposable

@code {
    private GXContextMenuController? _registeredParent;
    private string? _lastPolicy, _lastText, _lastImage, _lastId;
    private bool _disposed;
    /// <summary>
    /// Gets or sets the containing component supplied through a cascading parameter.
    /// </summary>
    [CascadingParameter]
    private GXContextMenuController? Parent { get; set; }
    /// <summary>
    /// Gets or sets the content rendered inside the component.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Gets or sets the identifier of the context menu command.
    /// </summary>
    [Parameter]
    public string? Id { get; set; }

    /// <summary>
    /// Gets or sets the icon or image identifier displayed for the context menu command.
    /// </summary>
    [Parameter]
    public string? Image { get; set; }

    /// <summary>
    /// Gets or sets the text displayed by the component.
    /// </summary>
    [Parameter]
    public string Text { get; set; } = "";

    /// <summary>
    /// Gets or sets the destination URL associated with the context menu command.
    /// </summary>
    [Parameter]
    public string Url { get; set; } = "";

    /// <summary>
    /// Gets or sets the callback invoked when the menu command is clicked.
    /// </summary>
    [Parameter]
    public EventCallback OnClick { get; set; }

    /// <summary>
    /// Gets or sets the named authorization policy required to display the content.
    /// </summary>
    [Parameter]
    public string? Policy { get; set; }

    /// <summary>
    /// Invokes the menu command's click callback.
    /// </summary>
    public void Click()
    {
        _ = InvokeAsync(ClickAsync);
    }

    /// <summary>Rechecks the current policy before invoking the command.</summary>
    public async Task ClickAsync()
    {
        var parent = _registeredParent;
        if (_disposed || parent == null || !await parent.CanExecuteAsync(this))
        {
            return;
        }
        if (_disposed || !ReferenceEquals(parent, _registeredParent))
        {
            return;
        }
        await OnClick.InvokeAsync();
        parent.Hide();
    }

    /// <summary>
    /// Registers the context menu item with its containing controller.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        if (Parent == null)
        {
            throw new ArgumentNullException(nameof(Parent), "MenuItem must exist within a ContextMenuController");
        }
        bool changed = !ReferenceEquals(Parent, _registeredParent) ||
            _lastPolicy != Policy || _lastText != Text || _lastImage != Image || _lastId != Id;
        if (!ReferenceEquals(Parent, _registeredParent))
        {
            _registeredParent?.RemoveMenuItem(this);
            _registeredParent = Parent;
            Parent.AddMenuItem(this);
        }
        _lastPolicy = Policy;
        _lastText = Text;
        _lastImage = Image;
        _lastId = Id;
        if (changed)
        {
            await Parent.MenuItemChangedAsync();
        }
    }

    public void Dispose()
    {
        _disposed = true;
        _registeredParent?.RemoveMenuItem(this);
        _registeredParent = null;
    }
}
