@*
<summary>
Renders registered menu commands with configurable right and bottom alignment.
</summary>
*@

@using System.Diagnostics
@using Microsoft.Extensions.Logging
@inject ILogger<MenuControl> Logger

<CascadingValue Value="this">
    <div @attributes="GXComponentAttributes.WithoutCss(AdditionalAttributes)" class="@GXComponentAttributes.GetClass(AdditionalAttributes, "btn-group")" role="group" style="@GXComponentAttributes.GetStyle(AdditionalAttributes, GetStyle())">
        @foreach (MenuItem it in Items)
        {
            <button @attributes="GXComponentAttributes.WithoutCss(it.AdditionalAttributes)" type="button" class="@it.CssClass" disabled="@it.ReadOnly" style="@GetButtonStyle(it)" onclick=@it.OnClick>
                @if (!string.IsNullOrEmpty(it.Image))
                {
                    <Image Value="@it.Image"></Image>
                }
                else if (!string.IsNullOrEmpty(it.Id))
                {
                    <Image Id="@it.Id"></Image>
                }
                &nbsp;
                <LocalizedText Value="@it.Text" />
            </button>
        }
    </div>
    @ChildContent
</CascadingValue>

@code {
    /// <summary>
    /// Gets or sets captured HTML attributes forwarded to the underlying element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// Gets or sets the content rendered inside the component.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Gets or sets whether the menu is aligned to the right.
    /// </summary>
    [Parameter]
    public bool RightCorner { get; set; }

    /// <summary>
    /// Gets or sets whether the menu is positioned at the bottom.
    /// </summary>
    [Parameter]
    public bool Bottom { get; set; }

    /// <summary>
    /// Gets the inline CSS declarations obtained from the captured attributes.
    /// </summary>
    private string? CssStyle => GXComponentAttributes.GetStyle(AdditionalAttributes);

    /// <summary>
    /// Combines a menu item's captured styles with the component's button styling.
    /// </summary>
    private string? GetButtonStyle(MenuItem item)
        => GXComponentAttributes.GetStyle(item.AdditionalAttributes, RightCorner ? "background-color: dodgerblue;" : null);
    /// <summary>
    /// Returns positioning styles for the menu's right and bottom alignment options.
    /// </summary>
    private string? GetStyle()
    {
        if (RightCorner)
        {
            if (Bottom)
            {
                return "position: fixed;bottom: 20px;right: 20px;";
            }
            return "float: right;";
        }
        if (Bottom)
        {
            return "position: absolute; bottom:0;";
        }
        return null;
    }

    /// <summary>
    /// Gets or sets menu items registered before the component is initialized.
    /// </summary>
    [Parameter]
    public List<MenuItem>? MenuItems { get; set; }

    List<MenuItem> Items = new List<MenuItem>();

    /// <summary>
    /// Registers a child menu item with the containing menu.
    /// </summary>
    /// <param name="item">Menu item</param>
    internal void AddMenuItem(MenuItem item)
    {
        Items.Add(item);
        InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Registers any menu items supplied before initialization and requests rendering.
    /// </summary>
    protected override void OnInitialized()
    {
        if (MenuItems != null && MenuItems.Count != 0)
        {
            Items.AddRange(MenuItems);
            InvokeAsync(StateHasChanged);
        }
    }
}