@*
<summary>
Renders command buttons or a dropdown with configurable right and bottom alignment.
</summary>
*@

@using System.Diagnostics
@using Microsoft.Extensions.Logging
@inject ILogger<MenuControl> Logger
@implements IDisposable

<CascadingValue Value="this">
    <div @attributes="GXComponentAttributes.WithoutCss(AdditionalAttributes)" class="@GXComponentAttributes.GetClass(AdditionalAttributes, Dropdown ? (Submenu ? "btn-group gx-menu-control gx-menu-submenu" : "btn-group gx-menu-control") : "btn-group")" role="group" style="@GXComponentAttributes.GetStyle(AdditionalAttributes, GetStyle())" @onkeydown="OnKeyDown" @onkeydown:stopPropagation="@(Submenu && _isOpen)">
        @if (Dropdown)
        {
            <button @ref="_toggle" type="button" class="nav-link btn btn-link gx-menu-toggle" disabled="@ReadOnly"
                    aria-expanded="@(_isOpen ? "true" : "false")" aria-controls="@_popupId" @onclick="Toggle">
                @if (!string.IsNullOrEmpty(Icon))
                {
                    <Image Id="@Icon" />
                }
                <LocalizedText Value="@Text" />
                <span aria-hidden="true">▾</span>
            </button>
            @if (_isOpen)
            {
                @if (!Submenu)
                {
                    <button type="button" class="gx-menu-dismiss" tabindex="-1" aria-label="Close menu" @onclick="Close" />
                }
                <div id="@_popupId" class="gx-menu-popup @(Submenu ? "gx-menu-popup-nested" : null) @(RightCorner ? "gx-menu-popup-right" : null) @(Bottom ? "gx-menu-popup-above" : null)">
                    @CommandButtons
                </div>
            }
        }
        else
        {
            @CommandButtons
        }
    </div>
    @ChildContent
</CascadingValue>

@code {
    private RenderFragment CommandButtons => @<text>
        @foreach (MenuItem it in Items)
        {
            @if (it.IsSeparator)
            {
                <hr class="gx-menu-separator" role="separator" />
            }
            else if (it.Children is { Count: > 0 })
            {
                <MenuControl @key="it" Dropdown="true" Submenu="true" Text="@it.Text" Icon="@it.Id"
                             ReadOnly="@(ReadOnly || it.ReadOnly)" MenuItems="@it.Children" OnSelected="CloseBranchAsync" />
            }
            else
            {
            <button @attributes="GXComponentAttributes.WithoutCss(it.AdditionalAttributes)" type="button" class="@it.CssClass" disabled="@(ReadOnly || it.ReadOnly)" style="@GetButtonStyle(it)" @onclick="() => SelectAsync(it)">
                @if (!string.IsNullOrEmpty(it.Image))
                {
                    <Image Value="@it.Image" />
                }
                else if (!string.IsNullOrEmpty(it.Id))
                {
                    <Image Id="@it.Id" />
                }
                &nbsp;
                <LocalizedText Value="@it.Text" />
            </button>
            }
        }
    </text>;

    /// <summary>Renders a labelled dropdown instead of a row of command buttons.</summary>
    [Parameter]
    public bool Dropdown { get; set; }

    /// <summary>Expands inside a parent popup, using the parent's outside-click dismissal.</summary>
    [Parameter]
    public bool Submenu { get; set; }

    /// <summary>Notifies an enclosing menu when a descendant command is selected.</summary>
    [Parameter]
    public EventCallback OnSelected { get; set; }

    /// <summary>Resource key or text displayed on the dropdown toggle.</summary>
    [Parameter]
    public string? Text { get; set; }

    /// <summary>Optional resource icon displayed on the dropdown toggle.</summary>
    [Parameter]
    public string? Icon { get; set; }

    /// <summary>Disables the toggle and all commands in this control.</summary>
    [Parameter]
    public bool ReadOnly { get; set; }

    private readonly string _popupId = $"gx-menu-{Guid.NewGuid():N}";
    private ElementReference _toggle;
    private bool _isOpen;
    private bool _disposed;

    private void Toggle()
    {
        if (!ReadOnly)
        {
            _isOpen = !_isOpen;
        }
    }

    private void Close() => _isOpen = false;

    private async Task CloseBranchAsync()
    {
        Close();
        await OnSelected.InvokeAsync();
    }

    private async Task OnKeyDown(KeyboardEventArgs args)
    {
        if (Dropdown && _isOpen && args.Key == "Escape")
        {
            Close();
            await _toggle.FocusAsync(preventScroll: true);
        }
    }

    private async Task SelectAsync(MenuItem item)
    {
        if (ReadOnly || item.ReadOnly || item.IsSeparator)
        {
            return;
        }
        await CloseBranchAsync();
        await item.OnClick.InvokeAsync();
    }

    /// <summary>
    /// Gets or sets captured HTML attributes forwarded to the underlying element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// Gets or sets the content rendered inside the component.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Gets or sets whether the menu is aligned to the right.
    /// </summary>
    [Parameter]
    public bool RightCorner { get; set; }

    /// <summary>
    /// Gets or sets whether the menu is positioned at the bottom.
    /// </summary>
    [Parameter]
    public bool Bottom { get; set; }

    /// <summary>
    /// Gets the inline CSS declarations obtained from the captured attributes.
    /// </summary>
    private string? CssStyle => GXComponentAttributes.GetStyle(AdditionalAttributes);

    /// <summary>
    /// Combines a menu item's captured styles with the component's button styling.
    /// </summary>
    private string? GetButtonStyle(MenuItem item)
        => GXComponentAttributes.GetStyle(item.AdditionalAttributes, RightCorner ? "background-color: dodgerblue;" : null);
    /// <summary>
    /// Returns positioning styles for the menu's right and bottom alignment options.
    /// </summary>
    private string? GetStyle()
    {
        if (RightCorner)
        {
            if (Bottom)
            {
                return "position: fixed;bottom: 20px;right: 20px;";
            }
            return "float: right;";
        }
        if (Bottom)
        {
            return "position: absolute; bottom:0;";
        }
        return null;
    }

    /// <summary>
    /// Gets or sets commands supplied as data, in addition to declarative child items.
    /// </summary>
    [Parameter]
    public List<MenuItem>? MenuItems { get; set; }

    private readonly List<MenuItem> _childItems = new();
    private IEnumerable<MenuItem> Items => (MenuItems ?? Enumerable.Empty<MenuItem>()).Concat(_childItems);

    /// <summary>
    /// Registers a child menu item with the containing menu.
    /// </summary>
    /// <param name="item">Menu item</param>
    internal void AddMenuItem(MenuItem item)
    {
        _childItems.Add(item);
        InvokeAsync(StateHasChanged);
    }

    /// <summary>Unregisters a declarative command when its component is removed.</summary>
    internal void RemoveMenuItem(MenuItem item)
    {
        if (_childItems.Remove(item) && !_disposed)
        {
            _ = InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>Stops child removal notifications from scheduling renders during disposal.</summary>
    public void Dispose()
    {
        _disposed = true;
        _childItems.Clear();
    }

    /// <summary>
    /// Closes the popup if its toggle becomes disabled or the control becomes flat.
    /// </summary>
    protected override void OnParametersSet()
    {
        if (ReadOnly || !Dropdown)
        {
            Close();
        }
    }
}
