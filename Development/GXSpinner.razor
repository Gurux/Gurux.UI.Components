@*
<summary>
Displays loading state and recent progress messages with support for cancelling active operations.
</summary>
*@


@implements IDisposable
@inject IGXProgress Progress

@if (Visible || Progress.IsBusy || _visibleTasks.Any())
{
    <div class="spinner-overlay">
        <div class="spinner-border text-primary"
             role="status"
             aria-live="polite"
             aria-label="@AriaLabel">
        </div>


        @if (_visibleTasks.Any())
        {
            <ul class="spinner-task-list mt-3 mb-0 text-start"
                aria-label="Latest tasks">
                @foreach (GXProgressItem task in _visibleTasks)
                {
                    <li>
                        @if (task.Total != 0)
                        {
                            <div class="spinner-task-progress" role="progressbar"
                                 title="@($"{task.Completed} / {task.Total}")"
                                 aria-label="@(task.Message ?? AriaLabel)"
                                 aria-valuemin="0" aria-valuemax="@Math.Max(1, task.Total)"
                                 aria-valuenow="@Math.Clamp(task.Completed, 0, Math.Max(1, task.Total))">
                                @if (task.Segments.Count == 0)
                                {
                                    <span class="spinner-task-fill" aria-hidden="true"
                                          style="@($"width: {Math.Clamp(100.0 * task.Completed / Math.Max(1, task.Total), 0, 100).ToString(System.Globalization.CultureInfo.InvariantCulture)}%;")"></span>
                                }
                                else
                                {
                                    double offset = 0;
                                    @foreach (var segment in task.Segments)
                                    {
                                        double width = Math.Clamp(100.0 * segment.Completed / Math.Max(1, task.Total), 0, 100 - offset);
                                        <span class="@($"spinner-task-fill bg-{segment.Color.ToString().ToLowerInvariant()}")" aria-hidden="true"
                                              style="@FormattableString.Invariant($"left: {offset}%; width: {width}%;")"></span>
                                        offset += width;
                                    }
                                }
                                <span class="spinner-task-message">@task.Message</span>
                            </div>
                        }
                        else
                        {
                            <span class="spinner-task-message">@task.Message</span>
                        }
                    </li>
                }
            </ul>
        }
        else
        {
            @if (!string.IsNullOrEmpty(Text))
            {
                <div class="mt-3">
                    @Text
                </div>
            }
        }
        <button type="button" class="btn btn-secondary mt-3" disabled="@_cancelling" @onclick="CancelAllAsync">Cancel</button>
    </div>
}
@ChildContent
@code {
    /// <summary>
    /// Gets or sets the content rendered inside the component.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Gets or sets whether the component is displayed.
    /// </summary>
    [Parameter] public bool Visible { get; set; }

    /// <summary>
    /// Gets or sets the text displayed by the component.
    /// </summary>
    [Parameter] public string? Text { get; set; } = "Loading...";

    /// <summary>
    /// Gets the nonempty messages of the currently active progress operations.
    /// </summary>
    [Parameter] public IEnumerable<string>? Tasks { get; set; }

    /// <summary>
    /// Gets or sets the maximum number of recent task messages shown by the spinner.
    /// </summary>
    [Parameter] public int MaxVisibleTasks { get; set; } = 5;

    /// <summary>
    /// Gets or sets the accessible label for the loading indicator.
    /// </summary>
    [Parameter] public string AriaLabel { get; set; } = "Loading";

    /// <summary>
    /// Gets or sets the callback invoked when the user requests cancellation.
    /// </summary>
    [Parameter] public EventCallback OnCancel { get; set; }
    private bool _cancelling;
    private readonly List<GXProgressItem> _visibleTasks = new();
    private bool _disposed;

    /// <summary>
    /// Subscribes to changes in the shared progress service.
    /// </summary>
    protected override void OnInitialized() => Progress.Changed += OnProgressChanged;
    /// <summary>
    /// Refreshes the displayed task messages from supplied and shared progress tasks.
    /// </summary>
    protected override void OnParametersSet() => UpdateVisibleTasks();

    /// <summary>
    /// Combines supplied and active progress messages and keeps the most recent messages allowed by the display limit.
    /// </summary>
    private void UpdateVisibleTasks()
    {
        _visibleTasks.Clear();
        _visibleTasks.AddRange((Tasks ?? Enumerable.Empty<string>())
            .Where(value => !string.IsNullOrWhiteSpace(value))
            .Select(value => new GXProgressItem(Guid.Empty, value))
            .Concat(Progress.Items.Where(item => !string.IsNullOrWhiteSpace(item.Message) || item.Total != 0))
            .TakeLast(Math.Max(0, MaxVisibleTasks)));
    }

    /// <summary>
    /// Refreshes visible task messages and schedules rendering after progress state changes.
    /// </summary>
    private void OnProgressChanged()
    {
        if (_disposed)
        {
            return;
        }
        _ = InvokeAsync(() =>
        {
            if (_disposed)
            {
                return;
            }
            UpdateVisibleTasks();
            StateHasChanged();
        });
    }

    /// <summary>
    /// Requests cancellation of active progress operations and invokes the optional cancellation callback once at a time.
    /// </summary>
    private async Task CancelAllAsync()
    {
        if (_cancelling)
        {
            return;
        }
        _cancelling = true;
        try { await Task.WhenAll(Progress.CancelAllAsync(), OnCancel.InvokeAsync()); }
        finally { _cancelling = false; }
    }

    /// <summary>
    /// Detaches the progress change handler and prevents subsequent UI updates.
    /// </summary>
    public void Dispose()
    {
        _disposed = true;
        Progress.Changed -= OnProgressChanged;
    }
}
