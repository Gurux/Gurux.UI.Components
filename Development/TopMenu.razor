@*
<summary>
Displays shared top menu commands and updates their enabled state from progress and form changes.
</summary>
*@

@using Gurux.UI.Components.Enums
@using Microsoft.AspNetCore.Components.Routing

@inject NavigationManager NavigationManager
@inject IGXTopMenu Menu
@inject IGXProgress Progress
@implements IDisposable

<div class="btn-group" role="group">
    @foreach (GXMenuItem it in Menu.Items)
    {
        <button class="nav-link btn btn-link" onclick="@it.OnClick"
                disabled="@IsDisabled(it)">
            @if (it.Icon != null)
            {
                <Image Id="@it.Icon"></Image>
            }
            &nbsp;
            <LocalizedText Value="@it.Text" />
        </button>
    }
</div>
@ChildContent
@code {
    /// <summary>
    /// Gets or sets the content rendered inside the component.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private bool _disposed;

    /// <summary>
    /// Disables commands during progress operations or when their required form edit state is not satisfied.
    /// </summary>
    private bool IsDisabled(GXMenuItem item)
    {
        if (Progress.IsBusy)
        {
            return true;
        }
        var enabled = item.Enabled == EnableStyle.Always ||
            item.Enabled == EnableStyle.Modified && Menu.EditContext?.IsModified() == true ||
            item.Enabled == EnableStyle.Unmodified && Menu.EditContext?.IsModified() == false;
        return !enabled;
    }

    /// <summary>
    /// Subscribes to menu, progress, and navigation changes that affect displayed commands.
    /// </summary>
    protected override void OnInitialized()
    {
        Menu.Changed += OnChanged;
        Progress.Changed += OnChanged;
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    /// <summary>
    /// Clears shared menu commands and their edit context after navigation.
    /// </summary>
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => Menu.Clear();

    /// <summary>
    /// Schedules a component render when the backing service changes, unless the component is disposed.
    /// </summary>
    private void OnChanged()
    {
        if (_disposed)
        {
            return;
        }
        _ = InvokeAsync(() =>
        {
            if (!_disposed)
            {
                StateHasChanged();
            }
        });
    }

    /// <summary>
    /// Detaches menu, progress, and navigation change handlers.
    /// </summary>
    public void Dispose()
    {
        _disposed = true;
        Menu.Changed -= OnChanged;
        Progress.Changed -= OnChanged;
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}