@using Gurux.UI.Components.Enums
@using Microsoft.AspNetCore.Components.Routing

@inject NavigationManager NavigationManager
@inject IGXTopMenu Menu
@inject IGXProgress Progress
@implements IDisposable

<div class="btn-group" role="group">
    @foreach (GXMenuItem it in Menu.Items)
    {
        <button class="nav-link btn btn-link" onclick="@it.OnClick"
                disabled="@IsDisabled(it)">
            @if (it.Icon != null)
            {
                <Image Id="@it.Icon"></Image>
            }
            &nbsp;
            <LocalizedText Value="@it.Text" />
        </button>
    }
</div>
@ChildContent
@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private bool _disposed;

    private bool IsDisabled(GXMenuItem item)
    {
        if (Progress.IsBusy) return true;
        var enabled = item.Enabled == EnableStyle.Always ||
            item.Enabled == EnableStyle.Modified && Menu.EditContext?.IsModified() == true ||
            item.Enabled == EnableStyle.Unmodified && Menu.EditContext?.IsModified() == false;
        return !enabled;
    }

    protected override void OnInitialized()
    {
        Menu.Changed += OnChanged;
        Progress.Changed += OnChanged;
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => Menu.Clear();

    private void OnChanged()
    {
        if (_disposed) return;
        _ = InvokeAsync(() =>
        {
            if (!_disposed) StateHasChanged();
        });
    }

    public void Dispose()
    {
        _disposed = true;
        Menu.Changed -= OnChanged;
        Progress.Changed -= OnChanged;
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}