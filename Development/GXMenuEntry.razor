@*
<summary>
Defines a menu command with text, an icon, authorization, and a click callback.
</summary>
*@

@implements IDisposable

@code {
    /// <summary>
    /// Gets or sets captured HTML attributes forwarded to the underlying element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// Gets or sets the identifier of the menu command.
    /// </summary>
    [Parameter]
    public string? Id { get; set; }

    /// <summary>
    /// Gets or sets the icon or image identifier displayed for the menu command.
    /// </summary>
    [Parameter]
    public string? Image { get; set; }


    /// <summary>
    /// Gets or sets the containing component supplied through a cascading parameter.
    /// </summary>
    [CascadingParameter]
    private GXMenuControl? Parent { get; set; }

    /// <summary>
    /// Gets or sets the content rendered inside the component.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Gets or sets the text displayed by the component.
    /// </summary>
    [Parameter]
    public string? Text { get; set; }

    /// <summary>
    /// Gets or sets the named authorization policy required to display the content.
    /// </summary>
    [Parameter]
    public string? Policy { get; set; }

    /// <summary>
    /// Gets or sets whether the menu command is disabled.
    /// </summary>
    [Parameter]
    public bool ReadOnly { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked when the menu command is clicked.
    /// </summary>
    [Parameter]
    public EventCallback OnClick { get; set; }

    /// <summary>Optional commands displayed in a nested dropdown.</summary>
    [Parameter]
    public List<GXMenuEntry>? Children { get; set; }

    /// <summary>Displays a separator instead of a command button.</summary>
    [Parameter]
    public bool IsSeparator { get; set; }

    /// <summary>
    /// Registers the menu item with its containing menu control.
    /// </summary>
    protected override void OnInitialized()
    {
        if (Parent == null)
        {
            throw new ArgumentNullException(nameof(Parent), "MenuItem must exist within a MenuControl");
        }
        base.OnInitialized();
        Parent.AddMenuItem(this);
    }

    private bool _parametersApplied;
    private string? _lastPolicy;

    /// <summary>Refreshes command visibility when a declarative policy changes.</summary>
    protected override async Task OnParametersSetAsync()
    {
        if (!_parametersApplied || !string.Equals(_lastPolicy, Policy, StringComparison.Ordinal))
        {
            _parametersApplied = true;
            _lastPolicy = Policy;
            if (Parent != null)
            {
                await Parent.RefreshAuthorizationAsync();
            }
        }
    }

    /// <summary>Removes this declarative command from its containing menu.</summary>
    public void Dispose() => Parent?.RemoveMenuItem(this);


    /// <summary>
    /// Creates a menu item with the supplied identifier, label, click action, and read-only state.
    /// </summary>
    /// <param name="id">Menu Id</param>
    /// <param name="text">Menu text.</param>
    /// <param name="action">Menu action.</param>
    /// <param name="readOnly">Is menu read-only.</param>
    /// <returns>New menu item.</returns>
    public static GXMenuEntry Create(string id, string text, EventCallback action, bool readOnly)
        => Create(id, text, action, readOnly, null, false);

    /// <summary>Creates an icon-only command with a tooltip and accessible label.</summary>
    /// <param name="image">Base64 raster image content, as accepted by Image.Value.</param>
    /// <param name="text">Tooltip and accessible command name.</param>
    /// <param name="action">Command callback.</param>
    /// <param name="readOnly">Disables the command when true.</param>
    public static GXMenuEntry CreateIcon(string image, string text, EventCallback action, bool readOnly = false)
        => new()
        {
            Image = image,
            OnClick = action,
            ReadOnly = readOnly,
            AdditionalAttributes = new() { ["title"] = text, ["aria-label"] = text }
        };

    /// <summary>Creates a command, nested dropdown, or separator.</summary>
    public static GXMenuEntry Create(string id, string text, EventCallback action, bool readOnly,
        List<GXMenuEntry>? children, bool isSeparator)
    {
        GXMenuEntry ret = new GXMenuEntry();
        ret.Text = text;
        ret.Id = id;
        ret.OnClick = action;
        ret.ReadOnly = readOnly;
        ret.Children = children;
        ret.IsSeparator = isSeparator;
        return ret;
    }

    /// <summary>Creates a command with a named authorization policy.</summary>
    public static GXMenuEntry Create(string id, string text, EventCallback action, bool readOnly,
        List<GXMenuEntry>? children, bool isSeparator, string? policy)
    {
        var item = Create(id, text, action, readOnly, children, isSeparator);
        item.Policy = policy;
        return item;
    }
}
