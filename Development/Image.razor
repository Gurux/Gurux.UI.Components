@*
<summary>
Renders image resources, Base64 data, SVG, HTML, or icons using the selected image type.
</summary>
*@


@using Gurux.UI.Components.Enums
@using Microsoft.Extensions.Logging
@using System.Diagnostics
@using System.Text.RegularExpressions

@inject ILogger<Image> Logger
@if (Type == ImageType.IconLigature)
{
    @if (GetIconPackType() == IconPackType.Material)
    {
        <span @attributes="GXComponentAttributes.WithoutCss(AdditionalAttributes)" class="@GXComponentAttributes.GetClass(AdditionalAttributes, "material-icons")"
              style="@BuildSpanStyle()"
              title="@Alt"
              aria-hidden="@(string.IsNullOrEmpty(Alt) ? "true" : "false")">
            @Value
        </span>
    }
    else if (GetIconPackType() == IconPackType.OpenIconic)
    {
        <span @attributes="GXComponentAttributes.WithoutCss(AdditionalAttributes)" class="@GXComponentAttributes.GetClass(AdditionalAttributes, Value)"
              style="@BuildSpanStyle()" title="@Alt"
              aria-hidden="@(string.IsNullOrEmpty(Alt) ? "true" : "false")">
        </span>
    }
    else
    {
        <span @attributes="GXComponentAttributes.WithoutCss(AdditionalAttributes)" class="@GXComponentAttributes.GetClass(AdditionalAttributes, Value)"
              style="@BuildSpanStyle()"
              title="@Alt"
              aria-hidden="@(string.IsNullOrEmpty(Alt) ? "true" : "false")">
        </span>
    }
}
else if (Type == ImageType.Svg)
{
    @if (!string.IsNullOrWhiteSpace(Value))
    {
        <span @attributes="GXComponentAttributes.WithoutCss(AdditionalAttributes)" class="@CssClass" style="@BuildSpanStyle()">
            @((MarkupString)Value)
        </span>
    }
    else if (ShowPlaceholder)
    {
        <span @attributes="GXComponentAttributes.WithoutCss(AdditionalAttributes)" class="@GXComponentAttributes.GetClass(AdditionalAttributes, "text-muted")" style="@Style">[no svg]</span>
    }
}
else if (Type == ImageType.Raster)
{
    @if (!string.IsNullOrWhiteSpace(Value))
    {
        <img @attributes="GXComponentAttributes.WithoutCss(AdditionalAttributes)" src="@GetDataUri()"
             alt="@Alt"
             class="@CssClass"
             style="@Style"
             width="@Width"
             height="@Height"
             loading="lazy" />
    }
    else if (ShowPlaceholder)
    {
        <span @attributes="GXComponentAttributes.WithoutCss(AdditionalAttributes)" class="@GXComponentAttributes.GetClass(AdditionalAttributes, "text-muted")" style="@Style">[no image]</span>
    }
}
else if (Type == ImageType.Html)
{
    @if (string.IsNullOrEmpty(Color))
    {
        <span @attributes="GXComponentAttributes.WithoutCss(AdditionalAttributes)" class="@CssClass" style="@Style">@((MarkupString)(Value ?? string.Empty))</span>
    }
    else
    {
        <span @attributes="GXComponentAttributes.WithoutCss(AdditionalAttributes)" class="@CssClass" style="@GXComponentAttributes.GetStyle(AdditionalAttributes, $"color:{Color}")">@((MarkupString)(Value ?? string.Empty))</span>
    }
}
else
{
    @if (ShowPlaceholder)
    {
        <span @attributes="GXComponentAttributes.WithoutCss(AdditionalAttributes)" class="@GXComponentAttributes.GetClass(AdditionalAttributes, "text-muted")" style="@Style">[no image]</span>
    }
}

@code {
    /// <summary>
    /// Gets or sets captured HTML attributes forwarded to the underlying element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// Identifies the icon font or class convention used to render an icon.
    /// </summary>
    private enum IconPackType
    {
        /// <summary>
        /// Renders icons using Bootstrap icon classes.
        /// </summary>
        Bootstrap,
        /// <summary>
        /// Renders icons using Font Awesome classes.
        /// </summary>
        FontAwesome,
        /// <summary>
        /// Renders icons using Material icon ligatures.
        /// </summary>
        Material,
        /// <summary>
        /// Renders icons using Open Iconic classes.
        /// </summary>
        OpenIconic
    }

    /// <summary>
    /// Gets or sets the resource identifier used to load and track the image.
    /// </summary>
    [Parameter]
    public string? Id { get; set; }

    /// <summary>
    /// Gets or sets the image content, URI, markup, or icon identifier to render.
    /// </summary>
    [Parameter]
    public string? Value { get; set; }

    /// <summary>
    /// Gets or sets the alternative text for the rendered image.
    /// </summary>
    [Parameter]
    public string? Alt { get; set; }

    /// <summary>
    /// Gets the CSS classes obtained by combining component defaults with captured attributes.
    /// </summary>
    private string? CssClass => GXComponentAttributes.GetClass(AdditionalAttributes, null);

    /// <summary>
    /// Gets the captured inline CSS declarations applied to the image.
    /// </summary>
    internal string? Style => GXComponentAttributes.GetStyle(AdditionalAttributes, null);


    /// <summary>
    /// Gets or sets the service provider used to resolve optional component services.
    /// </summary>
    [Inject]
    public IServiceProvider Services { get; set; } = default!;

    /// <summary>
    /// Gets the optional service used to retrieve localized resources.
    /// </summary>
    public IGXResourceStorage? ResourceStorage => Services.GetService<IGXResourceStorage>();

    /// <summary>
    /// Gets or sets the rendering kind; Auto infers the kind from the image value.
    /// </summary>
    [Parameter] public ImageType Kind { get; set; } = ImageType.Auto;

    /// <summary>
    /// Infers the icon pack from the value's class prefix, falling back to Material icons.
    /// </summary>
    IconPackType GetIconPackType()
    {
        if (Value?.StartsWith("bi-") == true)
        {
            return IconPackType.Bootstrap;
        }
        if (Value?.StartsWith("oi") == true)
        {
            return IconPackType.OpenIconic;
        }

        if (Value?.StartsWith("fa-solid fa-") == true)
        {
            return IconPackType.FontAwesome;
        }
        else
        {
            return IconPackType.Material;
        }
    }

    /// <summary>
    /// Gets or sets the MIME type used when building a Base64 image data URI; defaults to image/png.
    /// </summary>
    [Parameter]
    public string MimeType { get; set; } = "image/png";

    /// <summary>
    /// Gets or sets whether a placeholder is displayed when no image value is available.
    /// </summary>
    [Parameter] public bool ShowPlaceholder { get; set; } = false;

    /// <summary>
    /// Gets the explicit rendering kind or detects it from the value when Auto is selected.
    /// </summary>
    private ImageType Type => Kind == ImageType.Auto ? DetectKind(Value) : Kind;

    /// <summary>
    /// Determines whether the value is a decodable Base64 string satisfying the image length checks.
    /// </summary>
    public static bool IsBase64String(string? s)
    {
        if (string.IsNullOrWhiteSpace(s))
        {
            return false;
        }
        s = s.Trim();
        //Image size must be at least 20.
        if (s.Length % 4 != 0 || s.Length < 20)
        {
            return false;
        }
        // Vain a-zA-Z0-9+/ ja '='
        if (!Regex.IsMatch(s, @"^[a-zA-Z0-9\+/]*={0,2}$"))
        {
            return false;
        }

        try
        {
            byte[] v = Convert.FromBase64String(s);
            return true;
        }
        catch
        {
            return false;
        }
    }

    /// <summary>
    /// Infers the rendering kind from the image value's format.
    /// </summary>
    static public ImageType DetectKind(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return ImageType.Raster;
        }
        if (value.StartsWith("&#") || value.StartsWith("&amp"))
        {
            return ImageType.Html;
        }
        if (value.StartsWith("<svg") || value.StartsWith("<?xml"))
        {
            return ImageType.Svg;
        }
        if (IsBase64String(value))
        {
            return ImageType.Raster;
        }
        return ImageType.IconLigature;
    }

    /// <summary>
    /// Gets or sets the rendered image width in pixels.
    /// </summary>
    [Parameter]
    public int? Width { get; set; }

    /// <summary>
    /// Gets or sets the rendered image height in pixels.
    /// </summary>
    [Parameter]
    public int? Height { get; set; }

    /// <summary>
    /// Gets or sets the text color applied when rendering HTML image content.
    /// </summary>
    [Parameter]
    public string? Color { get; set; } = "red";

    /// <summary>
    /// Builds a Base64 image data URI using the configured MIME type and value.
    /// </summary>
    protected string GetDataUri()
    {
        return $"data:{MimeType};base64,{Value}";
    }

    /// <summary>
    /// Combines icon dimensions and font size with captured inline styles.
    /// </summary>
    protected string? BuildSpanStyle()
    {
        var parts = new List<string>();


        if (Width.HasValue)
        {
            parts.Add($"width:{Width.Value}px");
        }
        if (Height.HasValue)
        {
            parts.Add($"height:{Height.Value}px");
        }

        var size = Width ?? Height;
        if (size.HasValue)
        {
            parts.Add($"font-size:{size.Value}px");
            parts.Add("line-height:1");
            parts.Add("display:inline-flex;align-items:center;justify-content:center");
        }

        return GXComponentAttributes.GetStyle(AdditionalAttributes, parts.Count == 0 ? null : string.Join(";", parts));
    }

    /// <summary>
    /// Loads a named image resource when needed and subscribes to resource updates for that identifier.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrEmpty(Value) && ResourceStorage != null && !string.IsNullOrEmpty(Id))
        {
            if (Type != ImageType.Html && Type != ImageType.IconLigature)
            {
                Value = await ResourceStorage.GetImageAsync(Id);
            }
            ResourceStorage.OnImageChanged += async (sender, image) =>
            {
                if (image.Id == Id)
                {
                    if (string.IsNullOrEmpty(image.Value))
                    {
                        image.Value = await ResourceStorage.GetImageAsync(Id);
                    }
                    Value = image.Value;
                    await InvokeAsync(StateHasChanged);
                }
            };
        }
        await base.OnParametersSetAsync();
    }
}
