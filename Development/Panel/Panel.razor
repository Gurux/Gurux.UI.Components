
@*
<summary>
Arranges child panels around a draggable splitter and persists their resized dimensions.
</summary>
*@
@using System.Text.Json.Serialization
@using System.Collections.Concurrent
@using System.Text.Json
@using Microsoft.Extensions.Logging
@using Microsoft.JSInterop

@implements IAsyncDisposable
@inject IJSRuntime JSRuntime
@inject ILogger<Panel> Logger

<CascadingValue Value="this">
    <div @attributes="GXComponentAttributes.WithoutCss(AdditionalAttributes)" @ref="_panelElement" id="@Id" class="@GXComponentAttributes.GetClass(AdditionalAttributes, "gx-panel container-fluid")" data-fill-viewport="@(string.Equals(Height, "fill", StringComparison.OrdinalIgnoreCase) ? "true" : "false")" style="@($"height:{(string.Equals(Height, "fill", StringComparison.OrdinalIgnoreCase) ? "auto" : Height ?? "90vh")};{Style}")">
        <div @attributes="GetItemAttributes(0)" id="leftDiv" class="@GetItemClass(0)" style="@GetStyle(0)">
            @if (Items?.Count > 0)
            {
                @Items[0].ChildContent
            }
        </div>
        <div id="verticalDivider">&nbsp;</div>
        <div @attributes="GetItemAttributes(1)" id="rightDiv" class="@GetItemClass(1)" style="@GetStyle(1)">
            @if (Items?.Count > 1)
            {
                @Items[1].ChildContent
            }
        </div>
    </div>
    @ChildContent
</CascadingValue>

@code {
    /// <summary>
    /// Gets or sets captured HTML attributes forwarded to the underlying element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// Gets or sets the content rendered inside the component.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }


    /// <summary>
    /// Returns the captured non-CSS attributes for a child panel at the specified index.
    /// </summary>
    private IReadOnlyDictionary<string, object>? GetItemAttributes(int index)
        => Items.Count > index ? GXComponentAttributes.WithoutCss(Items[index].AdditionalAttributes) : null;
    /// <summary>
    /// Returns the captured CSS classes for a child panel at the specified index.
    /// </summary>
    private string? GetItemClass(int index) => Items.Count > index ? Items[index].CssClass : null;
    /// <summary>
    /// Combines a child panel's styles with its saved or configured splitter dimensions.
    /// </summary>
    private string? GetStyle(int index)
    {
        string? str = null;
        if (Items.Count > index)
        {
            str = Items[index].Style;
            if (index == 0)
            {
                if (string.IsNullOrEmpty((Items[index].SavedWidth ?? Items[index].Width)))
                {
                    str += "flex-basis: 100%;";
                }
                else
                {
                    str += "flex-basis: " + (Items[index].SavedWidth ?? Items[index].Width) + ";";
                }
            }
            if (string.IsNullOrEmpty((Items[index].Height ?? Items[index].SavedHeight)))
            {
                str += "height: 100%;";
            }
            else
            {
                str += "height: " + (Items[index].Height ?? Items[index].SavedHeight) + ";";
            }
        }
        return str;
    }

    /// <summary>
    /// Gets the display name associated with the panel.
    /// </summary>
    public string Name
    {
        get
        {
            return "Panel";
        }
    }

    /// <summary>
    /// Gets the configuration content associated with the panel.
    /// </summary>
    [JsonIgnore]
    public Type? ConfigurationUI
    {
        get
        {
            return null;
        }
    }

    /// <summary>
    /// Gets the icon identifier displayed alongside the text.
    /// </summary>
    public string? Icon
    {
        get
        {
            return "PanelIcon";
        }
    }

    /// <summary>
    /// Gets or sets the HTML identifier of the panel container.
    /// </summary>
    [Parameter]
    public string? Id { get; set; }

    /// <summary>
    /// Child panels.
    /// </summary>
    private readonly List<PanelItem> Items = new List<PanelItem>();

    /// <summary>
    /// Gets the CSS classes obtained by combining component defaults with captured attributes.
    /// </summary>
    internal string? CssClass => GXComponentAttributes.GetClass(AdditionalAttributes, null);

    /// <summary>
    /// Gets the inline CSS declarations applied to the component.
    /// </summary>
    internal string? Style => GXComponentAttributes.GetStyle(AdditionalAttributes, null);

    /// <summary>
    /// Gets or sets the panel's vertical position.
    /// </summary>
    [Parameter]
    public int Top { get; set; }

    /// <summary>
    /// Gets or sets the panel's horizontal position.
    /// </summary>
    [Parameter]
    public int Left { get; set; }

    /// <summary>
    /// Gets or sets the configured CSS width of the panel.
    /// </summary>
    [Parameter]
    public string? Width { get; set; }

    /// <summary>
    /// Gets or sets the CSS height; fill uses the available viewport space.
    /// </summary>
    [Parameter]
    public string? Height { get; set; }

    private ElementReference _panelElement;
    private IJSObjectReference? _module;
    private IJSObjectReference? _splitter;
    private bool _initialized;
    private DotNetObjectReference<Panel>? _reference;

    /// <summary>
    /// Persists the dimensions of the first two panels reported by the browser splitter.
    /// </summary>
    [JSInvokable]
    public async Task SaveSizes(double leftWidth, double leftHeight, double rightWidth, double rightHeight)
    {
        if (Items.Count < 2)
        {
            return;
        }
        await Items[0].SaveSizeAsync(leftWidth, leftHeight);
        await Items[1].SaveSizeAsync(rightWidth, rightHeight);
    }


    /// <summary>
    /// Registers a child panel and requests rendering of the panel layout.
    /// </summary>
    internal async Task AddItem(PanelItem value)
    {
        Items.Add(value);
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Restores child panel sizes and initializes the browser splitter once two panels have registered.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_initialized || Items.Count < 2)
        {
            return;
        }
        _initialized = true;
        try
        {
            foreach (var item in Items)
            {
                await item.LoadSizeAsync();
            }
            await InvokeAsync(StateHasChanged);
            _reference = DotNetObjectReference.Create(this);
            _module = await JSRuntime.InvokeAsync<IJSObjectReference>("import",
                "./_content/Gurux.UI.Components/Panel/window.js");
            _splitter = await _module.InvokeAsync<IJSObjectReference>("initializeSplitter", _panelElement, _reference);
        }
        catch (JSException ex)
        {
            Logger.LogError(ex, "Panel splitter initialization failed.");
        }
    }

    /// <summary>
    /// Disposes the splitter, JavaScript module, and .NET callback reference.
    /// </summary>
    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_splitter != null)
            {
                await _splitter.InvokeVoidAsync("dispose");
                await _splitter.DisposeAsync();
            }
            if (_module != null)
            {
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException) { }
        finally { _reference?.Dispose(); }
    }
}
